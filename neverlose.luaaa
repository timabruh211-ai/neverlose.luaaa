makeDraggable(window, topbar, function() return uiScale.Scale end, nil)

--== ОТКРЫТИЕ / ЗАКРЫТИЕ + ХОТКЕЙ RightShift ==--
function setOpen(o)
	if o == isOpen then return end
	isOpen = o
	if o then
		window.Visible = true
		window.GroupTransparency = 1
		uiScale.Scale = baseScale * 0.92
		tw(window, {GroupTransparency = 0}, 0.28)
		tw(uiScale, {Scale = baseScale}, 0.32, Enum.EasingStyle.Back)
		tw(openBtn, {GroupTransparency = 1}, 0.18)
		task.delay(0.2, function() if isOpen then openBtn.Visible = false end end)
	else
		tw(window, {GroupTransparency = 1}, 0.22)
		tw(uiScale, {Scale = baseScale * 0.92}, 0.22)
		task.delay(0.24, function() if not isOpen then window.Visible = false end end)
		openBtn.Visible = true
		tw(openBtn, {GroupTransparency = 0}, 0.28)
	end
end
minBtn.Activated:Connect(function() setOpen(false) end)
closeBtn.Activated:Connect(function()
	isOpen = false
	tw(window, {GroupTransparency = 1}, 0.2)
	tw(uiScale, {Scale = baseScale * 0.9}, 0.2)
	task.delay(0.22, function() gui:Destroy() end)
end)
connect(UIS.InputBegan, function(i, gp)
	if not gp and i.KeyCode == Enum.KeyCode.RightShift and gui.Parent then setOpen(not isOpen) end
end)

--== РЕАЛЬНЫЕ ДЕМО-ФУНКЦИИ (безопасно через pcall) ==--
local origBright, origAmbient = Lighting.Brightness, Lighting.Ambient
connect(UIS.JumpRequest, function()
	if Flags.tInfJump then
		pcall(function() Player.Character.Humanoid:ChangeState(Enum.HumanoidStateType.Jumping) end)
	end
end)
connect(RS.Stepped, function()
	if Flags.tNoclip then
		local ch = Player.Character
		if ch then
			for _, d in ipairs(ch:GetDescendants()) do
				if d:IsA("BasePart") then d.CanCollide = false end
			end
		end
	end
end)
connect(Player.CharacterAdded, function(ch)
	task.wait(0.6)
	pcall(function()
		local h = ch:WaitForChild("Humanoid")
		h.WalkSpeed = Flags.sWalk or 16
		if (Flags.sJump or 50) ~= 50 then h.UseJumpPower = true h.JumpPower = Flags.sJump end
	end)
end)

