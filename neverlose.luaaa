		add("spawn(function()")
		add("    while orb.Parent do")
		add("        TweenService:Create(orb, TweenInfo.new(0.9), {Size = UDim2.fromOffset("..(h+8)..", "..(h+8)..")}):Play()")
		add("        wait(0.9)")
		add("        TweenService:Create(orb, TweenInfo.new(0.9), {Size = UDim2.fromOffset("..h..", "..h..")}):Play()")
		add("        wait(0.9)")
		add("    end")
		add("end)")
	else
		add("-- NEBULA · универсальный твин")
		add('local TweenService = game:GetService("TweenService")')
		add("")
		add("local function tween(obj, props, time, style, dir)")
		add("    local info = TweenInfo.new(")
		add("        time or 0.25,")
		add("        style or Enum.EasingStyle.Quad,")
		add("        dir or Enum.EasingDirection.Out")
		add("    )")
		add("    local t = TweenService:Create(obj, info, props)")
		add("    t:Play()")
		add("    return t")
		add("end")
		add("")
		add("-- пример: плавное появление и подсветка")
		add('local Players = game:GetService("Players")')
		add('local gui = Instance.new("ScreenGui")')
		add('gui.Name = "'..name..'"')
		add('gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")')
		add('local box = Instance.new("Frame")')
		add("box.Size = UDim2.fromOffset("..w..", "..h..")")
		add("box.AnchorPoint = Vector2.new(0.5, 0.5)")
		add("box.Position = UDim2.fromScale(0.5, 0.5)")
		add("box.BackgroundColor3 = Color3.fromRGB("..rgb..")")
		add("box.BackgroundTransparency = 1")
		add("box.BorderSizePixel = 0")
		add("box.Parent = gui")
		add('local c = Instance.new("UICorner")')
		add("c.CornerRadius = UDim.new(0, "..r..")")
		add("c.Parent = box")
		add("")
		add("tween(box, {BackgroundTransparency = 0}, 0.35)")
		add("box.MouseEnter:Connect(function()")
		add("    tween(box, {BackgroundColor3 = Color3.fromRGB("..hi..")}, 0.18)")
		add("end)")
		add("box.MouseLeave:Connect(function()")
		add("    tween(box, {BackgroundColor3 = Color3.fromRGB("..rgb..")}, 0.18)")
		add("end)")
		add("")
		add("return tween")
	end
	return table.concat(L,"\n")
end

function buildElementPreview(holder)
	clearGui(holder)
	ST.orb=nil; ST.rings={}; ST.orbits={}; ST.box=nil
	local T=state.cgTemplate
	local a=accent()
	if T=="button" then
		local b=new("TextButton",{AnchorPoint=Vector2.new(0.5,0.5),Position=UDim2.fromScale(0.5,0.5),Size=UDim2.fromOffset(math.min(state.cgW,220),math.min(state.cgH,44)),BackgroundColor3=a,Text=state.cgName,TextColor3=Color3.new(1,1,1),TextSize=12,Font=Enum.Font.GothamBold,AutoButtonColor=false},holder)
		corner(b,state.cgRadius)
		if state.cgGlow then local s=stroke(b,2); s.Color=lighten(a,0.3); s.Transparency=0.35 end
		if state.cgAnim then
			addShimmer(b,0.4)
			b.MouseEnter:Connect(function() tw(b,{BackgroundColor3=lighten(a,0.25)},0.18) end)
			b.MouseLeave:Connect(function() tw(b,{BackgroundColor3=a},0.18) end)
		end
		b.Activated:Connect(function() playSound("click"); toast("info","Предпросмотр","Кнопка работает — код справа создаёт такую же.") end)
	elseif T=="panel" then
		local p=new("Frame",{AnchorPoint=Vector2.new(0.5,0.5),Position=UDim2.fromScale(0.5,0.5),Size=UDim2.fromOffset(math.min(state.cgW,230),78),BackgroundColor3=pal().main,BorderSizePixel=0},holder)
		corner(p,state.cgRadius)
		local s=stroke(p,1); s.Color=a
		local bar=new("Frame",{Size=UDim2.new(1,0,0,26),BackgroundColor3=pal().side,BorderSizePixel=0},p)
		corner(bar,state.cgRadius)
		local tl=new("TextLabel",{Size=UDim2.new(1,-40,1,0),Position=UDim2.fromOffset(10,0),BackgroundTransparency=1,Text=state.cgName,TextColor3=a,TextSize=11,Font=Enum.Font.GothamBold,TextXAlignment=Enum.TextXAlignment.Left},bar)
		local x=new("TextButton",{AnchorPoint=Vector2.new(1,0.5),Position=UDim2.new(1,-5,0.5,0),Size=UDim2.fromOffset(18,18),BackgroundColor3=pal().card,Text="X",TextColor3=ERR,TextSize=9,Font=Enum.Font.GothamBold,AutoButtonColor=false},bar)
		corner(x,5)
		local body=new("TextLabel",{Position=UDim2.fromOffset(10,32),Size=UDim2.new(1,-20,0,34),BackgroundTransparency=1,Text="Содержимое панели",TextColor3=pal().muted,TextSize=10,Font=Enum.Font.Gotham,TextXAlignment=Enum.TextXAlignment.Left,TextYAlignment=Enum.TextYAlignment.Top},p)
		x.Activated:Connect(function() tw(p,{BackgroundTransparency=0.6},0.15); delay(0.2,function() if p.Parent then tw(p,{BackgroundTransparency=0},0.2) end end) end)
	elseif T=="toast" then
		local p=new("Frame",{AnchorPoint=Vector2.new(0.5,0.5),Position=UDim2.fromScale(0.5,0.5),Size=UDim2.fromOffset(math.min(state.cgW,240),52),BackgroundColor3=pal().card,BorderSizePixel=0},holder)
		corner(p,state.cgRadius)
		local s=stroke(p,1); s.Color=pal().line
		local bar=new("Frame",{Size=UDim2.fromOffset(4,24),Position=UDim2.fromOffset(12,14),BackgroundColor3=a,BorderSizePixel=0},p)
		corner(bar,2)
		new("TextLabel",{Position=UDim2.fromOffset(26,8),Size=UDim2.new(1,-36,0,16),BackgroundTransparency=1,Text=state.cgName,TextColor3=Color3.new(1,1,1),TextSize=11,Font=Enum.Font.GothamBold,TextXAlignment=Enum.TextXAlignment.Left},p)
		new("TextLabel",{Position=UDim2.fromOffset(26,25),Size=UDim2.new(1,-36,0,16),BackgroundTransparency=1,Text="Так выглядит уведомление",TextColor3=pal().muted,TextSize=10,Font=Enum.Font.Gotham,TextXAlignment=Enum.TextXAlignment.Left},p)
		ST.box=p
	elseif T=="glow" then
		local orb=new("Frame",{AnchorPoint=Vector2.new(0.5,0.5),Position=UDim2.fromScale(0.5,0.5),Size=UDim2.fromOffset(46,46),BackgroundColor3=a,BorderSizePixel=0,ZIndex=3},holder)
		pill(orb)
		tint(new("UIGradient",{Rotation=35},orb),"Color","grad")
		ST.orb=orb
		for i=1,3 do
			local ring=new("Frame",{AnchorPoint=Vector2.new(0.5,0.5),Position=UDim2.fromScale(0.5,0.5),Size=UDim2.fromScale(1+i*0.55,1+i*0.55),BackgroundColor3=a,BackgroundTransparency=0.78+i*0.05,BorderSizePixel=0,ZIndex=2},orb)
			pill(ring)
			table.insert(ST.rings,ring)
		end
	elseif T=="tween" then
		local b=new("Frame",{AnchorPoint=Vector2.new(0.5,0.5),Position=UDim2.fromScale(0.5,0.5),Size=UDim2.fromOffset(math.min(state.cgW,120),math.min(state.cgH,40)),BackgroundColor3=a,BorderSizePixel=0},holder)
		corner(b,state.cgRadius)
		ST.box=b
	else
		local wrap=new("Frame",{AnchorPoint=Vector2.new(0.5,0.5),Position=UDim2.fromScale(0.5,0.5),Size=UDim2.fromOffset(230,56),BackgroundTransparency=1},holder)
		hlist(wrap,6)
		for _,hex in ipairs(PRESETS) do
			local c=new("Frame",{Size=UDim2.fromOffset(28,28),BackgroundColor3=hexColor(hex),BorderSizePixel=0},wrap)
			pill(c)
			if string.lower(hex)==string.lower(state.accent) then local s=stroke(c,2); s.Color=Color3.new(1,1,1) end
		end
		new("TextLabel",{Position=UDim2.fromOffset(0,34),Size=UDim2.new(1,0,0,18),BackgroundTransparency=1,Text=state.accent.."  ·  "..state.theme,TextColor3=pal().muted,TextSize=10,Font=Enum.Font.Code},holder)
	end
end

local codeBox=nil
function refreshCode()
	if codeBox and codeBox.Parent then
		local txt=codeText()
		codeBox.Text=txt
		local lines=1
		for _ in string.gmatch(txt,"\n") do lines=lines+1 end
		gui:SetAttribute("GeneratedCode",txt)
		return lines
	end
	return 0
end

local function buildStudio(parent)
	local mainW=W-((W<760 or isMin) and 0 or (state.compact and 64 or 200))
	local inner=mainW-32
	local wide=inner>=640
	local stageH=wide and 360 or 250
	local ctrlH=wide and stageH or 320
	studio.Size=UDim2.new(1,0,0,wide and stageH or (stageH+12+ctrlH))

	local stage=new("Frame",{Size=wide and UDim2.new(0.58,-8,0,stageH) or UDim2.new(1,0,0,stageH),Position=UDim2.fromOffset(0,0),BackgroundColor3=mix(pal().side,Color3.new(0,0,0),0.25),BorderSizePixel=0,ClipsDescendants=true},parent)
	corner(stage,10)
	tint(stroke(stage),"Color","line")

	local ctrl=new("ScrollingFrame",{Size=wide and UDim2.new(0.42,-8,0,ctrlH) or UDim2.new(1,0,0,ctrlH),Position=wide and UDim2.new(0.58,8,0,0) or UDim2.new(0,0,0,stageH+12),BackgroundTransparency=1,BorderSizePixel=0,ScrollBarThickness=4,CanvasSize=UDim2.new(),AutomaticCanvasSize=Enum.AutomaticSize.Y},parent)
	tint(ctrl,"ScrollBarImageColor3","line")
	local inner2=new("Frame",{Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,BackgroundTransparency=1},ctrl)
	pad(inner2,2,8,2,10)
	vlist(inner2,4)

	if activeTab=="preview" then
		if activeSub=="character" then
			PV.viewport=new("ViewportFrame",{Size=UDim2.fromScale(1,1),BackgroundTransparency=0,BorderSizePixel=0},stage)
			PV.vcam=new("Camera",{FieldOfView=45},PV.viewport)
			PV.viewport.CurrentCamera=PV.vcam
			local overlay=new("Frame",{Size=UDim2.fromScale(1,1),BackgroundTransparency=1,ZIndex=3},stage)
			if state.pvGrid then
				PV.grid=new("Frame",{Size=UDim2.fromScale(1,1),BackgroundTransparency=1,ZIndex=2},stage)
				for i=1,9 do
					local l=new("Frame",{Position=UDim2.fromScale(i/10,0),Size=UDim2.new(0,1,1,0),BackgroundColor3=accent(),BackgroundTransparency=0.93,BorderSizePixel=0},PV.grid)
					local l2=new("Frame",{Position=UDim2.fromScale(0,i/10),Size=UDim2.new(1,0,0,1),BackgroundColor3=accent(),BackgroundTransparency=0.93,BorderSizePixel=0},PV.grid)
				end
			end
			buildPreviewParticles(overlay)
			PV.nameLbl=new("TextLabel",{Position=UDim2.fromOffset(10,8),Size=UDim2.new(1,-20,0,20),BackgroundTransparency=1,Text="",TextColor3=Color3.new(1,1,1),TextSize=12,Font=Enum.Font.GothamBold,TextXAlignment=Enum.TextXAlignment.Left,ZIndex=5},stage)
			PV.placeholder=new("TextLabel",{Size=UDim2.fromScale(1,1),BackgroundTransparency=1,Text="",TextColor3=pal().muted,TextSize=12,Font=Enum.Font.Gotham,Visible=false,ZIndex=5},stage)
			local nav=new("Frame",{AnchorPoint=Vector2.new(0.5,1),Position=UDim2.new(0.5,0,1,-8),Size=UDim2.fromOffset(150,30),BackgroundTransparency=1,ZIndex=6},stage)
			hlist(nav,6)
			local function navBtn(txt,fn)
				local b=new("TextButton",{Size=UDim2.fromOffset(46,30),BackgroundColor3=pal().card,Text=txt,TextColor3=pal().label,TextSize=12,Font=Enum.Font.GothamBold,AutoButtonColor=false},nav)
				corner(b,7)
				tint(stroke(b),"Color","line")
				b.Activated:Connect(function() playSound("click"); fn() end)
				return b
			end
			navBtn("◀",function()
				local t=playerList()
				state.pvIndex=state.pvIndex-1
				if state.pvIndex<1 then state.pvIndex=#t end
				buildPreviewCharacter()
			end)
			navBtn("⟳",function() buildPreviewCharacter() end)
			navBtn("▶",function()
				local t=playerList()
				state.pvIndex=state.pvIndex+1
				if state.pvIndex>#t then state.pvIndex=1 end
				buildPreviewCharacter()
			end)
			buildPreviewCharacter()

			sectionLabel(inner2,"ПРЕВЬЮ ПЕРСОНАЖА")
			buildRow(inner2,{type="toggle",id="pvAuto",label="Авто-вращение"})
			buildRow(inner2,{type="slider",id="pvSpeed",label="Скорость вращения",min=0,max=150,step=5,unit="%"})
			buildRow(inner2,{type="slider",id="pvZoom",label="Дистанция камеры",min=3,max=16,step=1,unit=""})
			buildRow(inner2,{type="slider",id="pvLight",label="Угол света",min=0,max=360,step=15,unit="°"})
			buildRow(inner2,{type="slider",id="pvGhost",label="Призрачность",min=0,max=80,step=5,unit="%"})
			buildRow(inner2,{type="slider",id="pvParticles",label="Частицы сцены",min=0,max=60,step=2,unit=""})
			buildRow(inner2,{type="toggle",id="pvGlow",label="Подсветка персонажа"})
			buildRow(inner2,{type="toggle",id="pvGrid",label="Сетка"})
			buildRow(inner2,{type="button",label="Случайный ракурс",fn=function()
				state.pvLight=math.random(0,24)*15
				state.pvZoom=math.random(4,12)
				state.pvGhost=math.random(0,6)*10
				applyViewportCamera()
				applyGhost()
				renderContent()
			end})
			buildRow(inner2,{type="button",label="Сбросить превью",style="danger",fn=function()
				state.pvAuto=DEFAULTS.pvAuto; state.pvSpeed=DEFAULTS.pvSpeed; state.pvZoom=DEFAULTS.pvZoom
				state.pvLight=DEFAULTS.pvLight; state.pvGhost=DEFAULTS.pvGhost; state.pvGlow=DEFAULTS.pvGlow
				state.pvGrid=DEFAULTS.pvGrid; state.pvParticles=DEFAULTS.pvParticles
				renderContent()
				toast("warning","Превью сброшено","Параметры сцены вернулись к исходным.")
			end})
			buildRow(inner2,{type="button",label="Код этой сцены",style="primary",fn=function()
				state.cgTemplate="glow"
				activeTab="code"; activeSub="generator"
				renderAll(); layout()
				toast("info","Генератор","Шаблон переключён на свечение.")
			end})
		else
			local bg=new("Frame",{Size=UDim2.fromScale(1,1),BackgroundColor3=mix(pal().side,Color3.new(0,0,0),0.4),BorderSizePixel=0},stage)
			local orb=new("Frame",{AnchorPoint=Vector2.new(0.5,0.5),Position=UDim2.fromScale(0.5,0.45),Size=UDim2.fromOffset(64,64),BackgroundColor3=accent(),BorderSizePixel=0,ZIndex=4},bg)
			pill(orb)
			tint(orb,"BackgroundColor3","accent")
			tint(new("UIGradient",{Rotation=35},orb),"Color","grad")
			ST.orb=orb
			ST.rings={}
			for i=1,clamp(state.efRings,1,6) do
				local ring=new("Frame",{AnchorPoint=Vector2.new(0.5,0.5),Position=UDim2.fromScale(0.5,0.5),Size=UDim2.fromScale(1+i*0.5,1+i*0.5),BackgroundColor3=accent(),BackgroundTransparency=0.8+i*0.03,BorderSizePixel=0,ZIndex=3},orb)
				pill(ring)
				tint(ring,"BackgroundColor3","accent")
				table.insert(ST.rings,ring)
			end
			ST.orbits={}
			for i=1,clamp(state.efOrbit,0,14) do
				local d=new("Frame",{AnchorPoint=Vector2.new(0.5,0.5),Position=UDim2.fromScale(0.5,0.5),Size=UDim2.fromOffset(7,7),BackgroundColor3=lighten(accent(),0.35),BorderSizePixel=0,ZIndex=5},bg)
				pill(d)
				table.insert(ST.orbits,{f=d,ph=i*0.7,rad=70+((i%3)*22)})
			end
			local sample=new("TextButton",{AnchorPoint=Vector2.new(0.5,1),Position=UDim2.new(0.5,0,1,-16),Size=UDim2.fromOffset(170,34),BackgroundColor3=accent(),Text="Эффект кнопки",TextColor3=Color3.new(1,1,1),TextSize=12,Font=Enum.Font.GothamBold,AutoButtonColor=false,ZIndex=6},bg)
			corner(sample,state.radius)
			tint(sample,"BackgroundColor3","accent")
			tint(new("UIGradient",{Rotation=20},sample),"Color","grad")
			if state.efShimmer then addShimmer(sample,0.45) end
			sample.Activated:Connect(function() playSound("success"); toast("success","Эффект","Шиммер, свечение и градиент применены к этой кнопке.") end)

			sectionLabel(inner2,"СЦЕНА ЭФФЕКТОВ")
			buildRow(inner2,{type="slider",id="efPulse",label="Скорость пульса",min=0,max=150,step=5,unit="%"})
			buildRow(inner2,{type="slider",id="efRings",label="Кольца свечения",min=1,max=6,step=1,unit=""})
			buildRow(inner2,{type="slider",id="efOrbit",label="Орбитальные точки",min=0,max=14,step=1,unit=""})
			buildRow(inner2,{type="slider",id="efGlow",label="Сила свечения",min=0,max=100,step=5,unit="%"})
			buildRow(inner2,{type="slider",id="efSpin",label="Скорость орбиты",min=0,max=150,step=5,unit="%"})
			buildRow(inner2,{type="toggle",id="efShimmer",label="Шиммер на кнопке"})
			buildRow(inner2,{type="toggle",id="fxAurora",label="Аврора фона"})
			buildRow(inner2,{type="toggle",id="fxParticles",label="Частицы фона"})
			buildRow(inner2,{type="slider",id="fxCount",label="Плотность частиц",min=0,max=120,step=5,unit=""})
			buildRow(inner2,{type="slider",id="fxSpeed",label="Общая скорость",min=0,max=200,step=10,unit="%"})
			buildRow(inner2,{type="button",label="Случайный эффект",fn=function()
				state.efPulse=math.random(2,20)*5
				state.efRings=math.random(1,6)
				state.efOrbit=math.random(0,14)
				state.efGlow=math.random(2,20)*5
				state.accent=PRESETS[math.random(#PRESETS)]
				paint(); renderContent()
				toast("info","Случайный эффект","Параметры сцены перемешаны.")
			end})
			buildRow(inner2,{type="button",label="Код свечения",style="primary",fn=function()
				state.cgTemplate="glow"
				activeTab="code"; activeSub="generator"
				renderAll(); layout()
			end})
		end
	else
		codeBox=new("TextBox",{Size=UDim2.fromScale(1,1),BackgroundTransparency=1,Text="",TextSize=11,Font=Enum.Font.Code,TextColor3=pal().label,MultiLine=true,TextWrapped=false,ClearTextOnFocus=false,TextEditable=true,TextXAlignment=Enum.TextXAlignment.Left,TextYAlignment=Enum.TextYAlignment.Top,PlaceholderText="Код появится здесь"},stage)
		tint(codeBox,"TextColor3","label")
		pad(codeBox,12,12,10,10)
		local badge=new("TextLabel",{AnchorPoint=Vector2.new(1,1),Position=UDim2.new(1,-10,1,-8),Size=UDim2.fromOffset(150,18),BackgroundTransparency=1,Text="Ctrl+A → Ctrl+C",TextColor3=pal().muted,TextSize=10,Font=Enum.Font.Gotham,ZIndex=5},stage)

		sectionLabel(inner2,"ЖИВОЙ ПРЕДПРОСМОТР")
		local ep=new("Frame",{Size=UDim2.new(1,0,0,96),BackgroundColor3=mix(pal().side,Color3.new(0,0,0),0.25),BorderSizePixel=0,ClipsDescendants=true},inner2)
		corner(ep,8)
		tint(stroke(ep),"Color","line")
		buildElementPreview(ep)

		sectionLabel(inner2,"ПАРАМЕТРЫ КОДА")
		buildRow(inner2,{type="combo",id="cgTemplate",label="Шаблон",{options={{value="button",label="Кнопка"},{value="panel",label="Панель"},{value="toast",label="Уведомление"},{value="glow",label="Свечение"},{value="tween",label="Твин"},{value="config",label="Конфиг"}}})
		buildRow(inner2,{type="text",id="cgName",label="Имя элемента"})
		buildRow(inner2,{type="slider",id="cgW",label="Ширина",min=80,max=420,step=10,unit=" px"})
		buildRow(inner2,{type="slider",id="cgH",label="Высота",min=28,max=220,step=4,unit=" px"})
		buildRow(inner2,{type="slider",id="cgRadius",label="Скругление",min=0,max=24,step=1,unit=" px"})
		buildRow(inner2,{type="toggle",id="cgAnim",label="Анимации в коде"})
		buildRow(inner2,{type="toggle",id="cgGlow",label="Свечение в коде"})
		buildRow(inner2,{type="button",label="Обновить код",style="primary",fn=function()
			local n=refreshCode()
			toast("success","Код обновлён",n.." строк готово к копированию.")
		end})
		buildRow(inner2,{type="button",label="Выделить код",fn=function()
			if codeBox and codeBox.Parent then
				codeBox:CaptureFocus()
				codeBox.CursorPosition=1
				toast("info","Копирование","Нажми Ctrl+A, затем Ctrl+C.")
			end
		end})
		buildRow(inner2,{type="button",label="Случайные параметры",fn=function()
			state.cgW=math.random(10,32)*10
			state.cgH=math.random(8,20)*4
			state.cgRadius=math.random(0,20)
			state.accent=PRESETS[math.random(#PRESETS)]
			paint(); renderContent()
		end})
		if remote then
			buildRow(inner2,{type="button",label="Отправить код на сервер",fn=function()
				local txt=codeText()
				pcall(function() remote:FireServer(txt) end)
				toast("info","Отправлено","Код ушёл через NebulaSave.")
			end})
		end
		buildRow(inner2,{type="button",label="Сбросить генератор",style="danger",fn=function()
			state.cgTemplate=DEFAULTS.cgTemplate; state.cgName=DEFAULTS.cgName
			state.cgW=DEFAULTS.cgW; state.cgH=DEFAULTS.cgH; state.cgRadius=DEFAULTS.cgRadius
			state.cgAnim=DEFAULTS.cgAnim; state.cgGlow=DEFAULTS.cgGlow
			renderContent()
			toast("warning","Генератор сброшен","Параметры кода вернулись к исходным.")
		end})
		refreshCode()
	end
	local order=0
	for _,ch in ipairs(inner2:GetChildren()) do if ch:IsA("GuiObject") then order=order+1; ch.LayoutOrder=order end end
end

local confirmUntil=0
local function actReset(b)
	if os.clock()<confirmUntil then
		for k,v in pairs(DEFAULTS) do state[k]=v end
		state.name=player.Name
		confirmUntil=0
		renderAll(); paint(); applyRadius(); updateShellDecor(); updateToastPos(); updateSizeLabel(); updateSoundBtn(); layout()
		markDirty()
		toast("warning","Настройки сброшены","Восстановлены значения по умолчанию.")
		return
	end
	confirmUntil=os.clock()+2.6
	local oldText=b.Text
	b.Text="Подтвердить сброс?"
	delay(2.6,function() if b.Parent and b.Text=="Подтвердить сброс?" then b.Text=oldText end end)
end
local function actRandom()
	state.accent=PRESETS[math.random(#PRESETS)]
	local th={"midnight","abyss","contrast"}
	state.theme=th[math.random(#th)]
	state.radius=math.random(0,16)
	local d={"compact","normal","roomy"}
	state.density=d[math.random(#d)]
	state.fxCount=math.random(4,20)*5
	renderAll(); paint(); applyRadius(); layout()
	markDirty()
	toast("info","Случайный стиль","Акцент, тема, скругление и плотность перемешаны.")
end
local function actExport()
	local enc="{}"
	pcall(function() enc=Http:JSONEncode(state) end)
	openModal("Экспорт конфигурации",{"Выделите текст (Ctrl+A) и скопируйте (Ctrl+C)."},function(m,nextOrder)
		local box=new("TextBox",{Size=UDim2.new(1,0,0,120),Text=enc,TextSize=11,Font=Enum.Font.Code,TextWrapped=true,MultiLine=true,ClearTextOnFocus=false,TextEditable=true,TextXAlignment=Enum.TextXAlignment.Left,TextYAlignment=Enum.TextYAlignment.Top,LayoutOrder=nextOrder()},m)
		corner(box,7)
		tint(box,"BackgroundColor3","input")
		tint(box,"TextColor3","label")
		tint(stroke(box),"Color","line")
		pad(box,8,8,8,8)
	end)
end
local function actImport()
	openModal("Импорт конфигурации",{"Вставьте JSON и нажмите «Применить»."},function(m,nextOrder)
		local box=new("TextBox",{Size=UDim2.new(1,0,0,120),Text="",PlaceholderText='{"accent":"#0095FF", ...}',TextSize=11,Font=Enum.Font.Code,TextWrapped=true,MultiLine=true,ClearTextOnFocus=false,TextXAlignment=Enum.TextXAlignment.Left,TextYAlignment=Enum.TextYAlignment.Top,LayoutOrder=nextOrder()},m)
		corner(box,7)
		tint(box,"BackgroundColor3","input")
		tint(box,"TextColor3","label")
		tint(stroke(box),"Color","line")
		pad(box,8,8,8,8)
		local ab=new("TextButton",{Size=UDim2.new(1,0,0,34),Text="Применить",TextSize=12,Font=Enum.Font.GothamBold,AutoButtonColor=false,LayoutOrder=nextOrder()},m)
		corner(ab,7)
		tint(ab,"BackgroundColor3","accent")
		tint(ab,"TextColor3","white")
		ab.Activated:Connect(function()
			local ok,data=pcall(function() return Http:JSONDecode(box.Text) end)
			local n=0
			if ok and type(data)=="table" then
				for k,v in pairs(DEFAULTS) do
					if data[k]~=nil and type(data[k])==type(v) then state[k]=data[k]; n=n+1 end
				end
			end
			if n>0 then
				renderAll(); paint(); applyRadius(); updateShellDecor(); updateToastPos(); updateSizeLabel(); updateSoundBtn(); layout(); markDirty()
				closeModal()
				toast("success","Конфиг импортирован","Параметры применены из JSON.")
			else
				toast("error","Ошибка импорта","Текст не является корректным конфигом NEBULA.")
			end
		end)
	end)
end
local function actClear()
	gui:SetAttribute("Config",nil)
	toast("warning","Хранилище очищено","Сохранённая конфигурация удалена.")
end
local function actDocs()
	openModal("Документация",{
		"Превью: персонаж в ViewportFrame крутится вживую, все ползунки справа меняют сцену сразу — свет, дистанцию, призрачность, частицы.",
		"Сцена эффектов: пульсирующее ядро, кольца, орбиты и шиммер — тоже управляются вживую.",
		"Генератор: выбери шаблон, настрой размер и скругление — слева появится готовый Lua-код, а сверху справа живой предпросмотр элемента. Код компилируется в обычном Lua.",
		"Копирование: кликни в поле кода, Ctrl+A, Ctrl+C. Размер панели — М / С / Б в шапке. «–» сворачивает, клик по полоске разворачивает.",
		"Горячие клавиши: M — показать/скрыть · Ctrl+S — сохранить · Esc — закрыть всплывающее окно",
	})
end

local function R(ty,id,label,extra)
	local r={type=ty,id=id,label=label}
	if extra then for k,v in pairs(extra) do r[k]=v end end
	return r
end
local function C(title,rows) return {title=title,rows=rows} end
local SIZE_OPTS={{value="small",label="Маленький"},{value="medium",label="Средний"},{value="large",label="Большой"}}
local SCHEMA={
	{id="preview",group="Творчество",icon="👁",label="Превью",
		subs={{id="character",label="Персонаж"},{id="effect",label="Эффекты"}},cards={}},
	{id="code",group="Творчество",icon="⌨",label="Код",
		subs={{id="generator",label="Генератор"}},cards={}},
	{id="appearance",group="Основное",icon="🎨",label="Внешний вид",
		subs={{id="theme",label="Тема"},{id="window",label="Окно"}},
		cards={
			theme={
				C("Акцент",{R("swatch","accent","Акцентный цвет"),R("toggle","glow","Свечение акцента"),R("toggle","borderGlow","Подсветка границ")}),
				C("Оформление",{R("combo","theme","Тема окна",{options={{value="midnight",label="Полуночная"},{value="abyss",label="Глубокая"},{value="contrast",label="Контрастная"}}}),R("slider","radius","Скругление углов",{min=0,max=16,step=1,unit=" px"}),R("combo","density","Плотность строк",{options={{value="compact",label="Компактная"},{value="normal",label="Обычная"},{value="roomy",label="Просторная"}}}),R("toggle","compact","Компактный сайдбар")})
			},
			window={
				C("Размер панели",{R("segments","sizeMode","Пресет размера",{options=SIZE_OPTS}),R("slider","uiScale","Масштаб интерфейса",{min=80,max=125,step=5,unit="%"}),R("button",nil,"Свернуть в полоску",{fn=function() setMin(true) end})}),
				C("Окно",{R("slider","shadowDepth","Глубина тени",{min=0,max=100,step=5,unit="%"}),R("toggle","frosted","Матовое стекло"),R("toggle","animations","Анимации интерфейса"),R("toggle","sound","Звук интерфейса")}),
				C("Профиль",{R("text","name","Отображаемое имя"),R("combo","status","Статус",{options={{value="online",label="В сети"},{value="away",label="Отошёл"},{value="dnd",label="Не беспокоить"},{value="invisible",label="Невидимка"}}}),R("toggle","showProfile","Блок профиля")})
			}
		}},
	{id="effects",group="Основное",icon="✨",label="Эффекты",
		subs={{id="scene",label="Сцена"}},
		cards={
			scene={
				C("Фон меню",{R("toggle","fxEnabled","Эффекты включены"),R("toggle","fxAurora","Аврора"),R("toggle","fxParticles","Частицы"),R("slider","fxCount","Плотность частиц",{min=0,max=120,step=5,unit=""})}),
				C("Движение",{R("slider","fxSpeed","Общая скорость",{min=0,max=200,step=10,unit="%"}),R("toggle","fxShimmer","Шиммер кнопок"),R("slider","fpsCap","Лимит FPS эффектов",{min=15,max=120,step=5,unit=" fps"})})
			}
		}},
	{id="general",group="Система",icon="⚙",label="Общие",
		subs={{id="behavior",label="Поведение"},{id="data",label="Данные"}},
		cards={
			behavior={
				C("Управление",{R("toggle","drag","Перетаскивание окна"),R("toggle","hotkeys","Горячие клавиши"),R("combo","closeAction","При закрытии",{options={{value="hide",label="Скрыть окно"},{value="minimize",label="Свернуть"}}}),R("toggle","rememberPos","Запоминать позицию")}),
				C("Запуск",{R("toggle","autoSave","Автосохранение"),R("info",nil,"Совет",{value="M — скрыть окно"})})
			},
			data={
				C("Конфигурация",{R("button",nil,"Экспорт конфига",{style="primary",fn=actExport}),R("button",nil,"Импорт конфига",{fn=actImport}),R("button",nil,"Случайный стиль",{fn=actRandom}),R("button",nil,"Сбросить настройки",{style="danger",fn=actReset})}),
				C("Хранилище",{R("info",nil,"Синхронизация",{value=remote and "RemoteEvent" or "локально"}),R("button",nil,"Очистить данные",{style="danger",fn=actClear})})
			}
		}},
	{id="notifications",group="Система",icon="🔔",label="Уведомления",
		subs={{id="general",label="Общие"}},
		cards={
			general={
				C("Оповещения",{R("toggle","notifEnabled","Уведомления",{gear={R("combo","notifPos","Позиция",{options={{value="br",label="Справа снизу"},{value="bl",label="Слева снизу"},{value="tr",label="Справа сверху"},{value="tc",label="Сверху центр"}}}),R("slider","notifDuration","Длительность",{min=2,max=8,step=1,unit=" с"})}}),R("combo","notifMax","Максимум на экране",{options={{value=1,label="1"},{value=3,label="3"},{value=5,label="5"}}})}),
				C("Проверка",{R("button",nil,"Тест: успех",{fn=function() toast("success","Тестовое уведомление","Так выглядит оповещение этого типа.") end}),R("button",nil,"Тест: инфо",{fn=function() toast("info","Тестовое уведомление","Так выглядит оповещение этого типа.") end}),R("button",nil,"Тест: предупреждение",{fn=function() toast("warning","Тестовое уведомление","Так выглядит оповещение этого типа.") end}),R("button",nil,"Тест: ошибка",{fn=function() toast("error","Тестовое уведомление","Так выглядит оповещение этого типа.") end})})
			}
		}},
	{id="about",group="Система",icon="ℹ",label="О программе",
		subs={{id="info",label="Информация"}},
		cards={
			info={
				C("NEBULA UI",{R("info",nil,"Версия",{value="v3.2 studio"}),R("info",nil,"Движок",{value="Roblox Lua/Luau"}),R("button",nil,"Документация",{style="primary",fn=actDocs})}),
				C("Лицензия",{R("info",nil,"Лицензия",{value="MIT · демо"}),R("info",nil,"Стиль",{value="Тёмный неоновый концепт"})})
			}
		}},
}
local function findTab(id)
	for _,tb in ipairs(SCHEMA) do if tb.id==id then return tb end end
	return SCHEMA[1]
end
local function isStudio() return activeTab=="preview" or activeTab=="code" end

function renderProfile()
	profile.Visible=state.showProfile
	profileName.Text=state.name
	avatarText.Text=string.upper(string.sub(player.Name,1,1))
	local map={online=OK,away=WARN,dnd=ERR,invisible=Color3.fromRGB(86,94,115)}
	local labels={online="В сети",away="Отошёл",dnd="Не беспокоить",invisible="Невидимка"}
	statusDot.BackgroundColor3=map[state.status] or OK
	statusText.Text=labels[state.status] or "В сети"
end
function renderSidebar()
	clearGui(nav)
	local compact=state.compact and W>=760
	logoText.Visible=not compact
	logoChip.Visible=not compact
	profileName.Visible=not compact
	statusDot.Visible=not compact
	statusText.Visible=not compact
	local order=0
	local lastGroup=nil
	for _,tb in ipairs(SCHEMA) do
		if tb.group~=lastGroup then
			lastGroup=tb.group
			order=order+1
			if compact then
				local ln=new("Frame",{Size=UDim2.new(1,0,0,1),BorderSizePixel=0,LayoutOrder=order},nav)
				tint(ln,"BackgroundColor3","line")
			else
				local gt=new("TextLabel",{Size=UDim2.new(1,0,0,22),BackgroundTransparency=1,Text=tb.group,TextSize=9,Font=Enum.Font.GothamBold,TextXAlignment=Enum.TextXAlignment.Left,LayoutOrder=order},nav)
				tint(gt,"TextColor3","dim")
			end
		end
		order=order+1
		local active=tb.id==activeTab
		local b=new("TextButton",{Size=UDim2.new(1,0,0,38),Text="",AutoButtonColor=false,LayoutOrder=order,BackgroundTransparency=active and 0 or 1},nav)
		corner(b,6)
		if active then b.BackgroundColor3=modeColor("softSide") end
		table.insert(tints,{o=b,p="BackgroundColor3",m="softSide"})
		local ic=new("TextLabel",{Size=UDim2.fromOffset(24,38),Position=UDim2.fromOffset(compact and 12 or 10,0),BackgroundTransparency=1,Text=tb.icon,TextSize=14,Font=Enum.Font.GothamBold},b)
		tint(ic,"TextColor3",active and "accent2" or "muted")
		if not compact then
			local tl=new("TextLabel",{Position=UDim2.fromOffset(38,0),Size=UDim2.new(1,-46,1,0),BackgroundTransparency=1,Text=tb.label,TextSize=13,Font=Enum.Font.Gotham,TextXAlignment=Enum.TextXAlignment.Left,TextTruncate=Enum.TextTruncate.AtEnd},b)
			tint(tl,"TextColor3",active and "white" or "muted")
		end
		if active then
			local ind=new("Frame",{Size=UDim2.new(0,3,0.6,0),Position=UDim2.new(0,-10,0.2,0),BorderSizePixel=0},b)
			tint(ind,"BackgroundColor3","accent")
		end
		b.MouseEnter:Connect(function() if not active then b.BackgroundColor3=mix(pal().label,pal().side,0.94); tw(b,{BackgroundTransparency=0}) end end)
		b.MouseLeave:Connect(function() if not active then tw(b,{BackgroundTransparency=1}) end end)
		b.Activated:Connect(function()
			activeTab=tb.id
			activeSub=tb.subs[1].id
			drawerOpen=false
			playSound("click")
			renderAll()
			layout()
		end)
	end
end
function renderHeader()
	local tb=findTab(activeTab)
	crumb.Text=tb.icon.."  "..tb.label
	clearGui(subtabs)
	local i=0
	for _,s in ipairs(tb.subs) do
		i=i+1
		local active=s.id==activeSub
		local w=#s.label*7+20
		local b=new("TextButton",{Size=UDim2.fromOffset(w,26),Text=s.label,TextSize=11,Font=Enum.Font.GothamBold,AutoButtonColor=false,LayoutOrder=i,BackgroundTransparency=active and 0 or 1},subtabs)
		corner(b,6)
		if active then
			b.BackgroundColor3=accent()
			table.insert(tints,{o=b,p="BackgroundColor3",m="accent"})
			tint(new("UIGradient",{Rotation=20},b),"Color","grad")
		end
		tint(b,"TextColor3",active and "white" or "muted")
		b.MouseEnter:Connect(function() if not active then b.BackgroundColor3=mix(pal().label,pal().side,0.92); tw(b,{BackgroundTransparency=0}) end end)
		b.MouseLeave:Connect(function() if not active then tw(b,{BackgroundTransparency=1}) end end)
		b.Activated:Connect(function()
			activeSub=s.id
			playSound("click")
			renderHeader()
			renderContent()
		end)
	end
	dirtyDot.Visible=dirty
end
function renderContent()
	closePop()
	PV.viewport=nil; PV.vcam=nil; PV.clone=nil; PV.parts={}; PV.trans={}; PV.light=nil; PV.grid=nil; PV.nameLbl=nil; PV.placeholder=nil
	ST.orb=nil; ST.rings={}; ST.orbits={}; ST.box=nil
	codeBox=nil
	clearGui(col1)
	clearGui(col2)
	clearGui(studio)
	if isStudio() then
		col1.Visible=false
		col2.Visible=false
		studio.Visible=true
		buildStudio(studio)
	else
		studio.Visible=false
		col1.Visible=true
		local tb=findTab(activeTab)
		local cards=tb.cards[activeSub] or {}
		for i,card in ipairs(cards) do
			local parent=singleCol and col1 or (i%2==1 and col1 or col2)
			local c=new("Frame",{Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,BorderSizePixel=0,LayoutOrder=i},parent)
			regRadius(corner(c,state.radius))
			tint(c,"BackgroundColor3","card")
			tint(stroke(c),"Color","line")
			pad(c,12,12,12,12)
			vlist(c,4)
			local head=new("Frame",{Size=UDim2.new(1,0,0,28),BackgroundTransparency=1,LayoutOrder=0},c)
			local tl=new("TextLabel",{Size=UDim2.new(1,-70,1,0),BackgroundTransparency=1,Text=card.title,TextSize=13,Font=Enum.Font.GothamBold,TextXAlignment=Enum.TextXAlignment.Left,TextTruncate=Enum.TextTruncate.AtEnd},head)
			tint(tl,"TextColor3","white")
			local cn=new("TextLabel",{AnchorPoint=Vector2.new(1,0.5),Position=UDim2.new(1,0,0.5,0),Size=UDim2.fromOffset(70,20),BackgroundTransparency=1,Text=#card.rows.." парам.",TextSize=10,Font=Enum.Font.Gotham,TextXAlignment=Enum.TextXAlignment.Right},head)
			tint(cn,"TextColor3","dim")
			for _,row in ipairs(card.rows) do buildRow(c,row,false) end
			local order=0
			for _,ch in ipairs(c:GetChildren()) do if ch:IsA("GuiObject") then order=order+1; ch.LayoutOrder=order end end
			if state.animations then
				c.BackgroundTransparency=1
				delay(i*0.05,function() if c.Parent then tw(c,{BackgroundTransparency=0},0.3) end end)
			end
		end
	end
	paint()
end
function renderAll()
	renderSidebar()
	renderHeader()
	renderContent()
	renderProfile()
	paint()
end

function updateShellDecor()
	local d=state.shadowDepth/100
	for _,s in ipairs(shadows) do
		s.f.BackgroundTransparency=1-(1-s.base)*d
		s.f.Visible=d>0.02
	end
	borderGlow.Visible=state.borderGlow and not isMin
	shell.BackgroundTransparency=state.frosted and 0.1 or 0
	scrim.Visible=state.frosted and not isMin
	tw(scrim,{BackgroundTransparency=(state.frosted and not isMin) and 0.72 or 1},0.3)
	topLine.BackgroundTransparency=state.glow and 0 or 0.6
	scene.Visible=state.fxEnabled
	auroraLayer.Visible=state.fxAurora
	partLayer.Visible=state.fxParticles
end
local function syncParticles()
	local v=cam and cam.ViewportSize or Vector2.new(1280,720)
	local cap=(v.X<760) and 45 or 120
	local target=state.fxParticles and clamp(state.fxCount,0,cap) or 0
	while #FX.parts<target do
		local f=new("Frame",{Size=UDim2.fromOffset(3,3),BackgroundTransparency=0.45,BorderSizePixel=0},partLayer)
		pill(f)
		tint(f,"BackgroundColor3","accent2")
		table.insert(FX.parts,{f=f,x=math.random()*v.X,y=math.random()*v.Y,v=8+math.random()*26,ph=math.random()*6.28,r=1+math.random()*2})
	end
	for i,p in ipairs(FX.parts) do
		local on=i<=target
		p.f.Visible=on
		if on then p.f.Size=UDim2.fromOffset(p.r*2,p.r*2) end
	end
	FX.live=target
end
function applyLive(id)
	if id=="accent" or id=="theme" or id=="glow" or id=="borderGlow" then
		paint(); updateShellDecor(); renderProfile()
		if PV.light then PV.light.Color=accent() end
		applyViewportCamera()
		if activeTab=="code" then refreshCode(); if isStudio() then renderContent() end end
	elseif id=="sizeMode" then
		updateSizeLabel(); paint()
		if isMin then setMin(false) else layout() end
	elseif id=="radius" then
		applyRadius()
	elseif id=="density" then
		renderContent()
	elseif id=="compact" then
		renderSidebar(); layout()
	elseif id=="uiScale" then
		layout()
	elseif id=="shadowDepth" or id=="frosted" then
		updateShellDecor()
	elseif id=="showProfile" or id=="name" or id=="status" then
		renderProfile()
	elseif id=="notifPos" then
		updateToastPos()
	elseif id=="sound" then
		updateSoundBtn()
	elseif id=="fxEnabled" or id=="fxAurora" then
		updateShellDecor()
	elseif id=="fxParticles" or id=="fxCount" then
		updateShellDecor(); syncParticles()
	elseif id=="pvZoom" or id=="pvLight" then
		applyViewportCamera()
	elseif id=="pvGhost" then
		applyGhost()
	elseif id=="pvGlow" then
		buildPreviewCharacter()
	elseif id=="pvGrid" or id=="pvParticles" then
		renderContent()
	elseif id=="efRings" or id=="efOrbit" or id=="efShimmer" then
		renderContent()
	elseif id=="cgTemplate" or id=="cgName" or id=="cgW" or id=="cgH" or id=="cgRadius" or id=="cgAnim" or id=="cgGlow" then
		refreshCode()
		renderContent()
	end
end

function layout()
	local v=cam and cam.ViewportSize or Vector2.new(1280,720)
	local availW=v.X-16
	local availH=v.Y-80
	SCALE=clamp(state.uiScale/100,0.8,1.25)
	local base=SIZES[state.sizeMode] or SIZES.medium
	if isMin then
		W=math.floor(math.min(520,availW/SCALE))
		H=56
	else
		W=math.floor(math.min(base.w,availW/SCALE))
		H=math.floor(math.min(base.h,availH/SCALE))
	end
	local narrow=W<760
	local sideW=narrow and 200 or (state.compact and 64 or 200)
	shell.Size=UDim2.fromOffset(W,H)
	shellScale.Scale=SCALE
	window.Size=UDim2.fromOffset(W*SCALE,H*SCALE)
	for _,s in ipairs(shadows) do s.f.Size=UDim2.fromOffset(W*SCALE+s.grow,H*SCALE+s.grow) end
	borderGlow.Size=UDim2.fromOffset(W*SCALE+6,H*SCALE+6)
	local sw,sh=W*SCALE,H*SCALE
	local ox=clamp(state.posX,8-v.X/2+sw/2,v.X/2-8-sw/2)
	local oy=clamp(state.posY,8-v.Y/2+sh/2,v.Y/2-8-sh/2)
	state.posX,state.posY=ox,oy
	window.Position=UDim2.new(0.5,ox,0.5,oy)
	sidebar.Visible=not isMin
	sidebar.Size=UDim2.fromOffset(sideW,H)
	sidebar.Position=UDim2.fromOffset(narrow and (drawerOpen and 0 or -sideW-12) or 0,0)
	drawerScrim.Visible=narrow and drawerOpen and not isMin
	mainFrame.Position=UDim2.fromOffset((narrow or isMin) and 0 or sideW,0)
	mainFrame.Size=UDim2.new(1,-((narrow or isMin) and 0 or sideW),1,0)
	hamburger.Visible=narrow and not isMin
	expandHit.Visible=isMin
	content.Visible=not isMin

	local items={}
	table.insert(items,{o=dirtyDot,w=8,h=7,y=12})
	if narrow then table.insert(items,{o=sizeCycle,w=30,h=32,y=0}) else table.insert(items,{o=sizeSeg,w=86,h=32,y=0}) end
	table.insert(items,{o=soundBtn,w=30,h=32,y=0})
	table.insert(items,{o=saveBtn,w=narrow and 54 or 86,h=32,y=0})
	table.insert(items,{o=minBtn,w=32,h=32,y=0})
	table.insert(items,{o=closeBtn,w=32,h=32,y=0})
	local x=0
	for _,e in ipairs(items) do
		e.o.Position=UDim2.fromOffset(x,e.y)
		e.o.Size=UDim2.fromOffset(e.w,e.h)
		x=x+e.w+6
	end
	local actionsW=math.max(1,x-6)
	actions.Size=UDim2.fromOffset(actionsW,32)
	sizeSeg.Visible=not narrow
	sizeCycle.Visible=narrow

	local mainW=W-((narrow or isMin) and 0 or sideW)
	local useStrip=(mainW>=520) and not isMin
	subtabs.Visible=useStrip
	subMenuBtn.Visible=(not useStrip) and (not isMin)
	if isMin then
		crumb.Visible=false
		expandHit.Size=UDim2.fromOffset(math.max(80,mainW-actionsW-24),34)
	else
		local showCrumb=(not narrow) and W>=880
		crumb.Visible=showCrumb
		local subX=narrow and 46 or (showCrumb and 176 or 16)
		if useStrip then
			subtabs.Position=UDim2.fromOffset(subX,12)
			subtabs.Size=UDim2.fromOffset(math.max(60,mainW-subX-actionsW-22),32)
		else
			subMenuBtn.Position=UDim2.fromOffset(subX,12)
			subMenuBtn.Size=UDim2.fromOffset(clamp(mainW-subX-actionsW-22,26,120),32)
		end
	end
	local newSingle=(mainW-32)<620
	singleCol=newSingle
	if not isStudio() then
		col1.Visible=true
		col2.Visible=not singleCol
		col1.Size=singleCol and UDim2.new(1,0,0,0) or UDim2.new(0.5,-7,0,0)
	end
	updateShellDecor()
	syncParticles()
end
function setMin(v)
	isMin=v
	minBtn.Text=v and "+" or "–"
	if v then drawerOpen=false end
	layout()
end
function setHidden(v)
	isHidden=v
	if v then
		tw(shell,{BackgroundTransparency=1},0.18)
		delay(0.2,function() if isHidden then window.Visible=false end end)
		restorePill.Visible=true
		restorePill.Position=UDim2.new(0.5,0,1,10)
		tw(restorePill,{Position=UDim2.new(0.5,0,1,-26)},0.35)
	else
		window.Visible=true
		updateShellDecor()
		tw(restorePill,{Position=UDim2.new(0.5,0,1,10)},0.25)
		delay(0.26,function() if not isHidden then restorePill.Visible=false end end)
		layout()
	end
end

hamburger.Activated:Connect(function() drawerOpen=not drawerOpen; playSound("click"); layout() end)
drawerScrim.Activated:Connect(function() drawerOpen=false; layout() end)
saveBtn.Activated:Connect(function() persist(false) end)
minBtn.Activated:Connect(function() playSound("click"); setMin(not isMin) end)
expandHit.Activated:Connect(function() playSound("click"); setMin(false) end)
closeBtn.Activated:Connect(function() playSound("click"); if state.closeAction=="minimize" then setMin(true) else setHidden(true) end end)
restorePill.Activated:Connect(function() playSound("click"); setHidden(false) end)
soundBtn.Activated:Connect(function() setState("sound",not state.sound); playSound("click") end)
subMenuBtn.Activated:Connect(function()
	playSound("click")
	local tb=findTab(activeTab)
	openPop(subMenuBtn,180,function(p)
		sectionLabel(p,tb.label)
		for _,s in ipairs(tb.subs) do
			local it=new("TextButton",{Size=UDim2.new(1,0,0,31),BackgroundTransparency=1,Text="",AutoButtonColor=false},p)
			corner(it,6)
			local sel=s.id==activeSub
			local il=new("TextLabel",{Size=UDim2.new(1,-26,1,0),Position=UDim2.fromOffset(9,0),BackgroundTransparency=1,Text=s.label,TextSize=11,Font=Enum.Font.Gotham,TextXAlignment=Enum.TextXAlignment.Left},it)
			tint(il,"TextColor3",sel and "accent2" or "label")
			it.Activated:Connect(function()
				activeSub=s.id
				closePop()
				renderHeader()
				renderContent()
			end)
		end
	end)
end)
for mode,b in pairs(sizeBtns) do
	local m=mode
	b.Activated:Connect(function() setState("sizeMode",m); playSound("click") end)
end
sizeCycle.Activated:Connect(function()
	local idx=1
	for i,m in ipairs(SIZE_ORDER) do if m==state.sizeMode then idx=i end end
	local nxt=SIZE_ORDER[idx+1] or SIZE_ORDER[1]
	setState("sizeMode",nxt)
	playSound("click")
	toast("info","Размер панели",(SIZES[nxt] or SIZES.medium).label)
end)

local dragging,dragStart,dragOrigin=false,nil,nil
header.InputBegan:Connect(function(i)
	if i.UserInputType~=Enum.UserInputType.MouseButton1 and i.UserInputType~=Enum.UserInputType.Touch then return end
	if not state.drag then return end
	local objs={}
	if pg.GetGuiObjectsAtPosition then objs=pg:GetGuiObjectsAtPosition(i.Position.X,i.Position.Y) end
	for _,o in ipairs(objs) do
		if (o:IsA("TextButton") or o:IsA("TextBox") or o:IsA("ScrollingFrame")) and o.Name~="ExpandHit" then return end
	end
	dragging=true
	dragStart=i.Position
	dragOrigin=Vector2.new(state.posX,state.posY)
end)
UIS.InputChanged:Connect(function(i)
	if dragging and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then
		state.posX=dragOrigin.X+(i.Position.X-dragStart.X)
		state.posY=dragOrigin.Y+(i.Position.Y-dragStart.Y)
		layout()
	end
end)
UIS.InputEnded:Connect(function(i)
	if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
		if dragging and state.rememberPos then markDirty() end
		dragging=false
	end
end)
UIS.InputBegan:Connect(function(i,processed)
	if i.KeyCode==Enum.KeyCode.Escape then closePop(); closeModal(); return end
	if processed then return end
	if UIS:GetFocusedTextBox() then return end
	if i.KeyCode==Enum.KeyCode.M and state.hotkeys then
		setHidden(not isHidden)
	elseif i.KeyCode==Enum.KeyCode.S and (UIS:IsKeyDown(Enum.KeyCode.LeftControl) or UIS:IsKeyDown(Enum.KeyCode.RightControl)) and state.hotkeys then
		persist(false)
	end
end)
local function bindCamera()
	cam=workspace.CurrentCamera
	if cam then
		cam:GetPropertyChangedSignal("ViewportSize"):Connect(function()
			layout()
			renderHeader()
			if isStudio() then renderContent() end
		end)
	end
end
workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
	wait()
	bindCamera()
	layout()
end)

RunService.RenderStepped:Connect(function(dt)
	FX.acc=FX.acc+dt
	local step=1/clamp(state.fpsCap,15,120)
	if FX.acc<step then return end
	local d=FX.acc
	FX.acc=0
	if isHidden then return end
	local sp=state.fxSpeed/100
	FX.t=FX.t+d*sp
	local v=cam and cam.ViewportSize or Vector2.new(1280,720)

	if state.fxEnabled and state.fxAurora then
		for _,b in ipairs(blobs) do
			local c=b.cfg
			b.root.Position=UDim2.fromScale(c.x+c.w/2+math.sin(FX.t*0.13+b.phase)*0.05,c.y+c.w/2+math.cos(FX.t*0.11+b.phase)*0.05)
		end
	end
	if state.fxEnabled and state.fxParticles and FX.live then
		for i=1,FX.live do
			local p=FX.parts[i]
			if p and p.f.Parent then
				p.y=p.y-p.v*d*sp
				p.ph=p.ph+d*1.4
				if p.y<-8 then p.y=v.Y+8; p.x=math.random()*v.X end
				p.f.Position=UDim2.fromOffset(p.x,p.y)
				p.f.BackgroundTransparency=1-(0.35+0.35*math.sin(p.ph))
			end
		end
	end
	if state.fxShimmer and state.fxEnabled then
		for i=#shimmers,1,-1 do
			local s=shimmers[i]
			if s.f.Parent==nil then table.remove(shimmers,i)
			else
				s.ph=s.ph+d*s.sp*sp
				if s.ph>1.6 then s.ph=-0.6 end
				s.f.Position=UDim2.fromScale(s.ph,-0.3)
			end
		end
	end
	if state.borderGlow and state.glow and borderStroke.Parent then
		borderStroke.Transparency=0.4+0.18*math.sin(FX.t*1.1)
	end

	if activeTab=="preview" and not isMin then
		if activeSub=="character" then
			if PV.clone and PV.clone.Parent then
				if state.pvAuto then
					PV.angle=PV.angle+d*(state.pvSpeed/100)*1.1
					pcall(function() PV.clone:PivotTo(CFrame.Angles(0,PV.angle,0)) end)
				end
			end
			FX.check=FX.check+d
			if FX.check>1.2 then
				FX.check=0
				local t=previewTarget()
				if t and t.Character~=PV.source then buildPreviewCharacter() end
			end
			for _,p in ipairs(PV.parts) do
				if p.f.Parent then
					p.y=p.y-p.v*d*sp
					p.ph=p.ph+d*1.6
					if p.y<-0.05 then p.y=1.05; p.x=math.random() end
					p.f.Position=UDim2.fromScale(p.x,p.y)
					p.f.Size=UDim2.fromOffset(p.r*2,p.r*2)
					p.f.BackgroundTransparency=1-(0.3+0.4*math.sin(p.ph))
				end
			end
		else
			if ST.orb and ST.orb.Parent then
				local pulse=1+0.09*math.sin(FX.t*(state.efPulse/50)*1.6)
				ST.orb.Size=UDim2.fromOffset(64*pulse,64*pulse)
				for i,r in ipairs(ST.rings) do
					if r.Parent then
						local k=1+i*0.5+0.12*math.sin(FX.t*(state.efPulse/50)*1.6-i*0.5)
						r.Size=UDim2.fromScale(k,k)
						r.BackgroundTransparency=clamp(1-(state.efGlow/100)*(0.3-i*0.03),0.55,0.97)
					end
				end
				for _,o in ipairs(ST.orbits) do
					if o.f.Parent then
						local a=FX.t*(state.efSpin/50)*0.9+o.ph
						o.f.Position=UDim2.new(0.5,math.cos(a)*o.rad,0.45,math.sin(a)*o.rad*0.55)
					end
				end
			end
		end
	elseif activeTab=="code" and not isMin then
		if ST.orb and ST.orb.Parent then
			local pulse=1+0.1*math.sin(FX.t*1.5)
			ST.orb.Size=UDim2.fromOffset(46*pulse,46*pulse)
			for i,r in ipairs(ST.rings) do
				if r.Parent then
					local k=1+i*0.55+0.14*math.sin(FX.t*1.5-i*0.6)
					r.Size=UDim2.fromScale(k,k)
				end
			end
		end
		if ST.box and ST.box.Parent and state.cgTemplate=="tween" then
			ST.box.BackgroundColor3=mix(accent(),lighten(accent(),0.4),0.5+0.5*math.sin(FX.t*1.4))
		end
	end
end)

local okLoad,saved=pcall(function() return Http:JSONDecode(gui:GetAttribute("Config") or "null") end)
if okLoad and type(saved)=="table" then
	for k,v in pairs(DEFAULTS) do
		if saved[k]~=nil and type(saved[k])==type(v) then state[k]=saved[k] end
	end
end
if not SIZES[state.sizeMode] then state.sizeMode="medium" end
if not state.rememberPos then state.posX,state.posY=0,0 end
updateToastPos()
updateSizeLabel()
updateSoundBtn()
renderAll()
bindCamera()
layout()
renderContent()
paint()
applyRadius()
shellScale.Scale=SCALE*0.93
shell.Position=UDim2.fromOffset(0,16)
tw(shellScale,{Scale=SCALE},0.45)
tw(shell,{Position=UDim2.fromOffset(0,0)},0.45)
delay(0.7,function() toast("info","NEBULA v3.2","Превью персонажа, сцена эффектов и генератор кода готовы.") end)
