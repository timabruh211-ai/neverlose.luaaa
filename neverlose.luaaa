--[[
	NEBULA v3.2 — Studio Edition
	LocalScript → StarterPlayerScripts (свой плейс)
	Compile-safe: без += / ..= / task / typeof / math.clamp / utf8 / CanvasGroup
	Новое: живой Preview (персонаж в ViewportFrame + сцена эффектов),
	       генератор кода с живым предпросмотром элемента,
	       аврора/частицы/шиммер/пульс свечения, звук с кнопкой в шапке.
]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UIS = game:GetService("UserInputService")
local Http = game:GetService("HttpService")
