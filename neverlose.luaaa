new("Frame", {Parent = sidebar, Size = UDim2.new(0, 1, 1, 0), Position = UDim2.new(1, -1, 0, 0), BackgroundColor3 = C.white, BackgroundTransparency = 0.92, BorderSizePixel = 0})
