corner(av, 8) stroke(av, C.white, 0.85, 1)
new("TextLabel", {Parent = pc, Position = UDim2.fromOffset(58, 12), Size = UDim2.new(1, -70, 0, 16), BackgroundTransparency = 1, Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = C.text, Text = Player.DisplayName, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd})
