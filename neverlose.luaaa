		Font = Enum.Font.GothamBold,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
	}, TopBar)

	New("TextLabel", {
		Position = UDim2.new(0, 44, 0, 22),
		Size = UDim2.new(0.5, 0, 0, 14),
		BackgroundTransparency = 1,
		Text = gameTitle,
		TextColor3 = Color3.fromRGB(150, 162, 190),
		TextSize = 11,
		Font = Enum.Font.Gotham,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
	}, TopBar)

	-- Кнопка свернуть/развернуть окно
	local isMinimized = false
	local MiniBtn = New("TextButton", {
		Position = UDim2.new(1, -36, 0.5, -12),
		Size = UDim2.new(0, 24, 0, 24),
		BackgroundColor3 = Color3.fromRGB(22, 27, 44),
		BorderSizePixel = 0,
		Text = "—",
		TextColor3 = Color3.fromRGB(255, 255, 255),
		TextSize = 13,
		Font = Enum.Font.GothamBold,
	}, TopBar)
	New("UICorner", { CornerRadius = UDim.new(0, 6) }, MiniBtn)

	-- Левая колонка вкладок
	local Sidebar = New("ScrollingFrame", {
		Name = "Sidebar",
		Position = UDim2.new(0, 10, 0, 48),
		Size = UDim2.new(0, 145, 1, -104),
		BackgroundColor3 = Color3.fromRGB(11, 14, 24),
		BackgroundTransparency = 0.25,
		BorderSizePixel = 0,
		ScrollBarThickness = 2,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
	}, MainFrame)
	New("UICorner", { CornerRadius = UDim.new(0, 8) }, Sidebar)
	New("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }, Sidebar)
	New("UIPadding", { PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6), PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6) }, Sidebar)

	-- Нижний блок пользователя
	local Info = New("Frame", {
		Name = "Info",
		Position = UDim2.new(0, 10, 1, -50),
		Size = UDim2.new(0, 145, 0, 42),
		BackgroundColor3 = Color3.fromRGB(14, 17, 28),
		BackgroundTransparency = 0.2,
