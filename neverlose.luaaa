local function t(k) local d=CHROME[state.language] or CHROME.ru; return d[k] or CHROME.ru[k] or k end
local function L(ru,en) return {ru=ru,en=en} end
local function lab(x) if type(x)=="table" then return x[state.language] or x.ru end return tostring(x) end

local tints,radii,liveInfo={},{},{}
local function modeColor(m)
	local p,a=pal(),accent()
	if m=="accent" then return a elseif m=="accent2" then return lighten(a,.3)
	elseif m=="soft" then return mix(a,p.card,.84) elseif m=="softSide" then return mix(a,p.side,.82)
	elseif m=="line" then return p.line elseif m=="muted" then return p.muted elseif m=="label" then return p.label
	elseif m=="card" then return p.card elseif m=="side" then return p.side elseif m=="main" then return p.main
	elseif m=="dim" then return mix(p.muted,p.side,.45) elseif m=="input" then return mix(p.card,p.side,.35)
	elseif m=="track" then return mix(p.line,p.side,.3) elseif m=="off" then return mix(p.line,p.side,.15)
	elseif SEM[m] then return SEM[m] end
	return p.label
end
local function tint(o,prop,m)
	table.insert(tints,{o=o,p=prop,m=m})
	if m=="gradAccent" then o.Color=ColorSequence.new(accent(),SEM.violet)
	elseif m=="gradAurora" then o.Color=ColorSequence.new(mix(accent(),SEM.info,.4),SEM.violet)
	else o[prop]=modeColor(m) end
	return o
end
local function paint()
	local a=accent()
	for i=#tints,1,-1 do
		local e=tints[i]
		if e.o.Parent==nil then table.remove(tints,i)
		elseif e.dyn then e.o[e.p]=e.dyn()
		elseif e.m=="gradAccent" then e.o.Color=ColorSequence.new(a,SEM.violet)
		elseif e.m=="gradAurora" then e.o.Color=ColorSequence.new(mix(a,SEM.info,.4),SEM.violet)
		else e.o[e.p]=modeColor(e.m) end
	end
end
local function regRadius(u) table.insert(radii,u); u.CornerRadius=UDim.new(0,state.radius); return u end
local function applyRadius()
	for i=#radii,1,-1 do local u=radii[i]; if u.Parent==nil then table.remove(radii,i) else u.CornerRadius=UDim.new(0,state.radius) end end
end

