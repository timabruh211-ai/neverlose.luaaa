--== ИКОНКИ (Frame + UIStroke) ==--
local function part(p, x, y, w, h, r)
	local f = new("Frame", {Parent = p, Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(w, h), BackgroundColor3 = C.sub, BorderSizePixel = 0})
	if r and r > 0 then corner(f, r) end
	return {o = f, p = "BackgroundColor3"}
end
local function iconGrid(p) return {part(p, 0, 0, 8, 8, 2), part(p, 11, 0, 8, 8, 2), part(p, 0, 11, 8, 8, 2), part(p, 11, 11, 8, 8, 2)} end
local function iconTarget(p)
	local ring = new("Frame", {Parent = p, Position = UDim2.fromOffset(2, 2), Size = UDim2.fromOffset(16, 16), BackgroundTransparency = 1})
	corner(ring, 8) local s = stroke(ring, C.sub, 0, 1.6)
	return {{o = s, p = "Color"}, part(p, 8, 8, 4, 4, 2), part(p, 9, 0, 2, 4, 1), part(p, 9, 16, 2, 4, 1), part(p, 0, 9, 4, 2, 1), part(p, 16, 9, 4, 2, 1)}
end
local function iconUser(p) return {part(p, 6, 1, 8, 8, 4), part(p, 3, 12, 14, 7, 4)} end
local function iconGear(p)
	local ring = new("Frame", {Parent = p, Position = UDim2.fromOffset(4, 4), Size = UDim2.fromOffset(12, 12), BackgroundTransparency = 1})
	corner(ring, 6) local s = stroke(ring, C.sub, 0, 2)
	return {{o = s, p = "Color"}, part(p, 8, 8, 4, 4, 2), part(p, 8, 0, 4, 3, 1), part(p, 8, 17, 4, 3, 1), part(p, 0, 8, 3, 4, 1), part(p, 17, 8, 3, 4, 1)}
end

--== ВКЛАДКИ ==--
local function makeTab(key, iconFn)
	local btn = new("TextButton", {Parent = tabsHolder, Size = UDim2.new(1, 0, 0, 40), BackgroundColor3 = ACCENT, BackgroundTransparency = 1, Text = "", AutoButtonColor = false})
	corner(btn, 5)
	local grad = new("UIGradient", {Parent = btn, Color = accentSeq(), Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 1)})})
	regAccent(btn, "BackgroundColor3") regAccent(grad, "Color", accentSeq)
	local bar = new("Frame", {Parent = btn, Size = UDim2.fromOffset(3, 0), Position = UDim2.new(0, 0, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), BackgroundColor3 = ACCENT, BorderSizePixel = 0})
	corner(bar, 2) regAccent(bar, "BackgroundColor3")
	local row = new("Frame", {Parent = btn, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1})
	padding(row, 12, 8, 0, 0) hlist(row, 10)
	local icon = new("Frame", {Parent = row, Size = UDim2.fromOffset(20, 20), BackgroundTransparency = 1})
	local parts = iconFn(icon)
	local label = new("TextLabel", {Parent = row, Size = UDim2.new(1, -42, 1, 0), BackgroundTransparency = 1, Font = Enum.Font.GothamMedium, TextSize = 14, TextColor3 = C.sub, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd})
	bindText(label, key)
	local idx = #tabs + 1
	table.insert(tabs, {btn = btn, bar = bar, label = label, parts = parts, key = key})
	btn.Activated:Connect(function() selectTab(idx) end)
	btn.MouseEnter:Connect(function() if currentTab ~= idx then tw(btn, {BackgroundTransparency = 0.92}, 0.15) end end)
	btn.MouseLeave:Connect(function() if currentTab ~= idx then tw(btn, {BackgroundTransparency = 1}, 0.15) end end)
end
function selectTab(i)
	currentTab = i
	for idx, t in ipairs(tabs) do
		local on = idx == i
		tw(t.btn, {BackgroundTransparency = on and 0.78 or 1}, 0.25)
		tw(t.bar, {Size = UDim2.fromOffset(3, on and 22 or 0)}, 0.25)
		tw(t.label, {TextColor3 = on and C.text or C.sub}, 0.25)
		for _, pr in ipairs(t.parts) do tw(pr.o, {[pr.p] = on and ACCENT or C.sub}, 0.25) end
		if pages[idx] then pages[idx].root.Visible = on end
	end
	topTitle.Text = tr(tabs[i].key)
	local pg = pages[i]
	if pg then
		pg.root.GroupTransparency = 1 pg.scroll.Position = UDim2.fromOffset(0, 12)
		tw(pg.root, {GroupTransparency = 0}, 0.3) tw(pg.scroll, {Position = UDim2.fromOffset(0, 0)}, 0.32)
	end
end
refreshTabs = function()
	for idx, t in ipairs(tabs) do
		for _, pr in ipairs(t.parts) do tw(pr.o, {[pr.p] = idx == currentTab and ACCENT or C.sub}, 0.25) end
	end
end

--== СТРАНИЦЫ: 2 колонки + автоскролл ==--
local content = new("Frame", {Parent = window, Size = UDim2.new(1, -SIDEBAR_W, 1, -53), Position = UDim2.fromOffset(SIDEBAR_W, 53), BackgroundTransparency = 1, ZIndex = 2, ClipsDescendants = true})
local function makePage()
	local root = new("CanvasGroup", {Parent = content, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false, GroupTransparency = 1})
	local scroll = new("ScrollingFrame", {Parent = root, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3, ScrollBarImageColor3 = ACCENT, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollingDirection = Enum.ScrollingDirection.Y})
	regAccent(scroll, "ScrollBarImageColor3") padding(scroll, 0, 0, 0, 12)
	local cols = new("Frame", {Parent = scroll, Position = UDim2.fromOffset(12, 12), Size = UDim2.new(1, -28, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1})
	new("UIListLayout", {Parent = cols, FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder})
	local c1 = new("Frame", {Parent = cols, Size = UDim2.new(0.5, -5, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1})
	local c2 = new("Frame", {Parent = cols, Size = UDim2.new(0.5, -5, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1})
	vlist(c1, 10) vlist(c2, 10)
	local page = {root = root, scroll = scroll, c1 = c1, c2 = c2}
	table.insert(pages, page)
	return page
end

--== КИРПИЧИКИ ==--
local function searchable(f, k) table.insert(searchables, {f = f, k = k}) end
local function section(col, key)
	local l = new("TextLabel", {Parent = col, Size = UDim2.new(1, 0, 0, 24), BackgroundTransparency = 1, Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = ACCENT, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd})
	padding(l, 4, 4, 8, 0) bindText(l, key) regAccent(l, "TextColor3") searchable(l, key)
	return l
end
local function card(col, h)
	local c = new("Frame", {Parent = col, Size = UDim2.new(1, 0, 0, h or 0), AutomaticSize = h and Enum.AutomaticSize.None or Enum.AutomaticSize.Y, BackgroundColor3 = C.card, BackgroundTransparency = 0.2, BorderSizePixel = 0, ClipsDescendants = true})
	corner(c, 6) stroke(c, C.white, 0.87, 1) gloss(c)
	return c
end
local function cardBody(c, gap)
	local b = new("Frame", {Parent = c, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1})
	padding(b, 12) vlist(b, gap or 8)
	return b
end
local function titleLabel(b, key, w)
	local t = new("TextLabel", {Parent = b, Size = UDim2.new(1, w or -24, 0, 18), BackgroundTransparency = 1, Font = Enum.Font.GothamMedium, TextSize = 14, TextColor3 = C.text, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd})
	bindText(t, key)
	return t
end
local function infoCard(col, kT, kD)
	local c = card(col) local b = cardBody(c, 6)
	titleLabel(b, kT)
	local d = new("TextLabel", {Parent = b, Size = UDim2.new(1, -24, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = C.sub, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, TextWrapped = true})
	bindText(d, kD) searchable(c, kT)
end
local function miniSwitch(parent, key, cb)
	local state = Flags[key] and true or false
	local track = new("TextButton", {Parent = parent, Size = UDim2.fromOffset(38, 20), BackgroundColor3 = state and ACCENT or C.track, BackgroundTransparency = 0.15, Text = "", AutoButtonColor = false})
	corner(track, 10) stroke(track, C.white, 0.87, 1)
	local knob = new("Frame", {Parent = track, Size = UDim2.fromOffset(14, 14), Position = state and UDim2.new(1, -17, 0.5, 0) or UDim2.new(0, 3, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), BackgroundColor3 = C.white, BorderSizePixel = 0})
	corner(knob, 7)
	regAccent(track, "BackgroundColor3", function() return state and ACCENT or C.track end)
	track.Activated:Connect(function()
		state = not state Flags[key] = state
		tw(track, {BackgroundColor3 = state and ACCENT or C.track}, 0.2)
		tw(knob, {Position = state and UDim2.new(1, -17, 0.5, 0) or UDim2.new(0, 3, 0.5, 0)}, 0.22, Enum.EasingStyle.Back)
		if cb then task.spawn(cb, state) end
	end)
	return track
end
local function toggleCard(col, kT, kD, key, cb)
	local c = card(col, 62)
	local texts = new("Frame", {Parent = c, Size = UDim2.new(1, -62, 1, 0), BackgroundTransparency = 1})
	padding(texts, 12, 0, 10, 10) vlist(texts, 2, Enum.VerticalAlignment.Center)
	local t = new("TextLabel", {Parent = texts, Size = UDim2.new(1, -12, 0, 17), BackgroundTransparency = 1, Font = Enum.Font.GothamMedium, TextSize = 14, TextColor3 = C.text, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd})
	bindText(t, kT)
	local d = new("TextLabel", {Parent = texts, Size = UDim2.new(1, -12, 0, 14), BackgroundTransparency = 1, Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = C.sub, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd})
	bindText(d, kD)
	local sw = miniSwitch(c, key, cb)
	sw.Position = UDim2.new(1, -12, 0.5, 0) sw.AnchorPoint = Vector2.new(1, 0.5)
	searchable(c, kT)
	return c
end
local function sliderCard(col, key, min, max, default, step, suffix, cb)
	local c = card(col, 78)
	local t = new("TextLabel", {Parent = c, Position = UDim2.fromOffset(12, 10), Size = UDim2.new(1, -90, 0, 18), BackgroundTransparency = 1, Font = Enum.Font.GothamMedium, TextSize = 14, TextColor3 = C.text, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd})
	bindText(t, key)
	local val = new("TextLabel", {Parent = c, Position = UDim2.new(1, -12, 0, 10), AnchorPoint = Vector2.new(1, 0), Size = UDim2.fromOffset(64, 18), BackgroundTransparency = 1, Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = ACCENT, TextXAlignment = Enum.TextXAlignment.Right, TextTruncate = Enum.TextTruncate.AtEnd})
	regAccent(val, "TextColor3")
	local track = new("Frame", {Parent = c, Position = UDim2.new(0, 12, 1, -24), Size = UDim2.new(1, -24, 0, 6), BackgroundColor3 = C.track, BackgroundTransparency = 0.15, BorderSizePixel = 0, Active = true})
	corner(track, 3)
	local fill = new("Frame", {Parent = track, Size = UDim2.fromScale(0, 1), BackgroundColor3 = ACCENT, BorderSizePixel = 0})
	corner(fill, 3) regAccent(fill, "BackgroundColor3")
	local knob = new("Frame", {Parent = track, Size = UDim2.fromOffset(15, 15), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0, 0.5), BackgroundColor3 = C.white, BorderSizePixel = 0, ZIndex = 2})
	corner(knob, 8) regAccent(stroke(knob, ACCENT, 0.2, 1.5), "Color")
	Flags[key] = default
	local value, dragging = default, false
	local function render(anim)
		local f = (value - min) / (max - min)
		val.Text = tostring(value) .. (suffix or "")
		if anim then tw(fill, {Size = UDim2.fromScale(f, 1)}, 0.12) tw(knob, {Position = UDim2.fromScale(f, 0.5)}, 0.12)
		else fill.Size = UDim2.fromScale(f, 1) knob.Position = UDim2.fromScale(f, 0.5) end
	end
	local function setFromX(x, anim)
		local f = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
		local v = math.clamp(math.floor((min + (max - min) * f) / step + 0.5) * step, min, max)
		if v ~= value then value = v Flags[key] = v render(anim) if cb then task.spawn(cb, v) end end
	end
	track.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = true setFromX(i.Position.X, true) end
	end)
	connect(UIS.InputChanged, function(i)
		if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then setFromX(i.Position.X, false) end
	end)
	connect(UIS.InputEnded, function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = false end
	end)
	render(false) searchable(c, key)
	return c
end
local function dropdownCard(col, key, optKeys, defaultIdx, cb)
	local c = card(col) local b = cardBody(c, 8)
	local head = new("TextButton", {Parent = b, Size = UDim2.new(1, -24, 0, 36), BackgroundTransparency = 1, Text = "", AutoButtonColor = false})
	local ht = new("TextLabel", {Parent = head, Size = UDim2.new(1, -130, 1, 0), BackgroundTransparency = 1, Font = Enum.Font.GothamMedium, TextSize = 14, TextColor3 = C.text, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd})
	bindText(ht, key)
	local val = new("TextLabel", {Parent = head, Position = UDim2.new(1, -22, 0, 0), AnchorPoint = Vector2.new(1, 0), Size = UDim2.fromOffset(100, 36), BackgroundTransparency = 1, Font = Enum.Font.GothamMedium, TextSize = 13, TextColor3 = ACCENT, TextXAlignment = Enum.TextXAlignment.Right, TextTruncate = Enum.TextTruncate.AtEnd})
	regAccent(val, "TextColor3")
	local chev = new("Frame", {Parent = head, Position = UDim2.new(1, -2, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5), Size = UDim2.fromOffset(14, 14), BackgroundTransparency = 1})
	new("Frame", {Parent = chev, Position = UDim2.fromOffset(1, 6), Size = UDim2.fromOffset(7, 2), BackgroundColor3 = C.sub, BorderSizePixel = 0, Rotation = 45})
	new("Frame", {Parent = chev, Position = UDim2.fromOffset(6, 6), Size = UDim2.fromOffset(7, 2), BackgroundColor3 = C.sub, BorderSizePixel = 0, Rotation = -45})
	local list = new("Frame", {Parent = b, Size = UDim2.new(1, -24, 0, 0), BackgroundTransparency = 1, ClipsDescendants = true})
	vlist(list, 6)
	local open, selected, optBtns = false, defaultIdx, {}
	local function refresh()
		val.Text = tr(optKeys[selected])
		for i, o in ipairs(optBtns) do
			tw(o.label, {TextColor3 = i == selected and C.text or C.sub}, 0.15)
			tw(o.dot, {BackgroundTransparency = i == selected and 0 or 1}, 0.15)
		end
	end
	local function setOpenList(o)
		open = o
		tw(list, {Size = UDim2.new(1, -24, 0, o and (#optKeys * 32 + (#optKeys - 1) * 6) or 0)}, 0.25)
		tw(chev, {Rotation = o and 180 or 0}, 0.25)
	end
	for i, k in ipairs(optKeys) do
		local ob = new("TextButton", {Parent = list, Size = UDim2.new(1, 0, 0, 32), BackgroundColor3 = C.side, BackgroundTransparency = 0.3, Text = "", AutoButtonColor = false})
		corner(ob, 4)
		local dot = new("Frame", {Parent = ob, Position = UDim2.new(0, 8, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), Size = UDim2.fromOffset(3, 15), BackgroundColor3 = ACCENT, BackgroundTransparency = 1, BorderSizePixel = 0})
		corner(dot, 2) regAccent(dot, "BackgroundColor3")
		local lb = new("TextLabel", {Parent = ob, Position = UDim2.fromOffset(18, 0), Size = UDim2.new(1, -26, 1, 0), BackgroundTransparency = 1, Font = Enum.Font.Gotham, TextSize = 13, TextColor3 = C.sub, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd})
		bindText(lb, k)
		ob.Activated:Connect(function()
			selected = i Flags[key] = optKeys[i] refresh() setOpenList(false)
			if cb then task.spawn(cb, optKeys[i], i) end
		end)
		table.insert(optBtns, {label = lb, dot = dot})
	end
	head.Activated:Connect(function() setOpenList(not open) end)
	bindText(val, function() return tr(optKeys[selected]) end)
	Flags[key] = optKeys[selected] refresh() searchable(c, key)
end
local function buttonCard(col, key, cb)
	local b = new("TextButton", {Parent = col, Size = UDim2.new(1, 0, 0, 38), BackgroundColor3 = ACCENT, BackgroundTransparency = 0.12, Text = "", AutoButtonColor = false})
	corner(b, 4) stroke(b, C.white, 0.82, 1) regAccent(b, "BackgroundColor3")
	local lb = new("TextLabel", {Parent = b, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Font = Enum.Font.GothamBold, TextSize = 14, TextColor3 = C.side, TextTruncate = Enum.TextTruncate.AtEnd})
	padding(lb, 10) bindText(lb, key)
	b.MouseEnter:Connect(function() tw(b, {BackgroundTransparency = 0.0}, 0.15) end)
	b.MouseLeave:Connect(function() tw(b, {BackgroundTransparency = 0.12}, 0.15) end)
	b.Activated:Connect(function() if cb then task.spawn(cb) end end)
	searchable(b, key)
	return b
end
local PALETTE = {Color3.fromRGB(255, 255, 255), Color3.fromRGB(239, 68, 68), Color3.fromRGB(74, 222, 128), Color3.fromRGB(59, 130, 246), Color3.fromRGB(250, 204, 21), Color3.fromRGB(236, 72, 153), Color3.fromRGB(34, 211, 238), Color3.fromRGB(249, 115, 22)}
local function paletteCard(col, feature, key, withToggle)
	local c = card(col) local b = cardBody(c, 10)
	local head = new("Frame", {Parent = b, Size = UDim2.new(1, -24, 0, 22), BackgroundTransparency = 1})
	titleLabel(head, key, withToggle and -50 or 0)
	if withToggle then
		local sw = miniSwitch(head, feature)
		sw.Position = UDim2.new(1, 0, 0.5, 0) sw.AnchorPoint = Vector2.new(1, 0.5)
	end
	local row = new("Frame", {Parent = b, Size = UDim2.new(1, -24, 0, 24), BackgroundTransparency = 1})
	hlist(row, 8)
	for _, col3 in ipairs(PALETTE) do
		local cb = new("TextButton", {Parent = row, Size = UDim2.fromOffset(22, 22), BackgroundColor3 = col3, Text = "", AutoButtonColor = false})
		corner(cb, 11) local s = stroke(cb, C.white, 0.65, 1.2)
		cb.MouseEnter:Connect(function() tw(s, {Transparency = 0.1}, 0.12) end)
		cb.MouseLeave:Connect(function() tw(s, {Transparency = 0.65}, 0.12) end)
		cb.Activated:Connect(function() ESPColors[feature] = col3 paint(feature) end)
	end
	searchable(c, key)
	return c
end

--== ПОИСК ==--
local function filterSearch()
	local q = string.lower(search.Text)
	for _, s in ipairs(searchables) do
		s.f.Visible = q == "" or string.find(string.lower(tr(s.k)), q, 1, true) ~= nil
	end
end
search:GetPropertyChangedSignal("Text"):Connect(filterSearch)

--== КВАДРАТНАЯ PREVIEW-ПАНЕЛЬ ==--
local previewFov
local function makePreview(col)
	local c = card(col)
	local b = cardBody(c, 6)
	titleLabel(b, "previewTitle")
	local scene = new("Frame", {Parent = b, Size = UDim2.new(1, -24, 0, 247), BackgroundColor3 = C.side, BackgroundTransparency = 0.35, BorderSizePixel = 0, ClipsDescendants = true})
	corner(scene, 4) stroke(scene, C.white, 0.9, 1)
	local box = new("Frame", {Parent = scene, Position = UDim2.fromScale(0.5, 0.52), AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromScale(0.42, 0.66), BackgroundTransparency = 1})
	regPaint("box", stroke(box, ESPColors.box, 0, 1.5), "Color")
	local chams = new("Frame", {Parent = scene, Position = UDim2.fromScale(0.5, 0.52), AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromScale(0.2, 0.4), BackgroundColor3 = ESPColors.chams, BackgroundTransparency = 0.55, BorderSizePixel = 0})
	corner(chams, 3) regPaint("chams", chams, "BackgroundColor3")
	local headC = new("Frame", {Parent = scene, Position = UDim2.fromScale(0.5, 0.26), AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromScale(0.13, 0.13), BackgroundTransparency = 1})
	corner(headC, 100) regPaint("head", stroke(headC, ESPColors.head, 0, 2), "Color")
	local function limb(x, y, w, rot)
		local l = new("Frame", {Parent = scene, Position = UDim2.fromScale(x, y), AnchorPoint = Vector2.new(0, 0.5), Size = UDim2.fromScale(w, 0.018), BackgroundColor3 = ESPColors.skeleton, BorderSizePixel = 0, Rotation = rot})
		regPaint("skeleton", l, "BackgroundColor3")
	end
	limb(0.5, 0.33, 0.19, 90) limb(0.5, 0.52, 0.16, 90)
	limb(0.5, 0.42, 0.17, 25) limb(0.5, 0.42, 0.17, 155)
	limb(0.5, 0.62, 0.18, 65) limb(0.5, 0.62, 0.18, 115)
	local nm = new("TextLabel", {Parent = scene, Position = UDim2.fromScale(0.5, 0.12), AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromScale(0.8, 0.08), BackgroundTransparency = 1, Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = ESPColors.name, Text = "TestBot_1", TextTruncate = Enum.TextTruncate.AtEnd})
	regPaint("name", nm, "TextColor3")
	previewFov = new("Frame", {Parent = scene, Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromScale(0.44, 0.44), BackgroundTransparency = 1})
	corner(previewFov, 1000) regPaint("fov", stroke(previewFov, ESPColors.fov, 0.35, 1.5), "Color")
	new("Frame", {Parent = scene, Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(10, 2), BackgroundColor3 = C.text, BorderSizePixel = 0})
	new("Frame", {Parent = scene, Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(2, 10), BackgroundColor3 = C.text, BorderSizePixel = 0})
	searchable(c, "previewTitle")
	return c
end

--== ESP СЛОЙ + FOV КРУГ ==--
local espLayer = new("Frame", {Parent = gui, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 1})
local fovCircle = new("Frame", {Parent = espLayer, AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, ZIndex = 1})
corner(fovCircle, 100000) regPaint("fov", stroke(fovCircle, ESPColors.fov, 0.3, 1.5), "Color")
local fovDot = new("Frame", {Parent = espLayer, AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(4, 4), BackgroundColor3 = ESPColors.fov, BorderSizePixel = 0, ZIndex = 1})
corner(fovDot, 2) regPaint("fov", fovDot, "BackgroundColor3")

--== ТЕСТ-БОТЫ ==--
local botsFolder = new("Folder", {Parent = workspace, Name = "GlassTestBots"})
local function limbPart(m, name, size, cf)
	return new("Part", {Name = name, Size = size, CFrame = cf, Anchored = true, CanCollide = false, Color = Color3.fromRGB(120, 124, 132), Material = Enum.Material.SmoothPlastic, Parent = m})
end
local function proj(pos)
	local v = camera:WorldToViewportPoint(pos)
	return Vector2.new(v.X, v.Y), v.Z
end
local function setLine(f, a, b)
	local d = b - a
	f.Size = UDim2.fromOffset(math.max(d.Magnitude, 1), 2)
	f.Position = UDim2.fromOffset(a.X, a.Y)
	f.Rotation = math.deg(math.atan2(d.Y, d.X))
end
local JOINTS = {{"Head", "Torso"}, {"Torso", "LA"}, {"Torso", "RA"}, {"Torso", "LL"}, {"Torso", "RL"}}
local function spawnBots()
	for _, b in ipairs(bots) do b.model:Destroy() b.overlay:Destroy() end
	bots = {}
	local base = (Player.Character and Player.Character:GetPivot().Position) or Vector3.new(0, 5, 0)
	for i = 1, Flags.botCount do
		local ang = (i / Flags.botCount) * math.pi * 2
		local pos = base + Vector3.new(math.cos(ang) * Flags.botDist, 0, math.sin(ang) * Flags.botDist)
		local cf = CFrame.new(pos)
		local m = new("Model", {Name = "TestBot_" .. i, Parent = botsFolder})
		local root = limbPart(m, "HumanoidRootPart", Vector3.new(2, 2, 1), cf * CFrame.new(0, 3, 0))
		root.Transparency = 1
		local torso = limbPart(m, "Torso", Vector3.new(2, 2, 1), cf * CFrame.new(0, 3, 0))
		local head = limbPart(m, "Head", Vector3.new(1, 1, 1), cf * CFrame.new(0, 4.5, 0))
		limbPart(m, "LA", Vector3.new(1, 2, 1), cf * CFrame.new(-1.5, 3, 0))
		limbPart(m, "RA", Vector3.new(1, 2, 1), cf * CFrame.new(1.5, 3, 0))
		limbPart(m, "LL", Vector3.new(1, 2, 1), cf * CFrame.new(-0.5, 1, 0))
		limbPart(m, "RL", Vector3.new(1, 2, 1), cf * CFrame.new(0.5, 1, 0))
		m.PrimaryPart = root
		new("Humanoid", {Parent = m, DisplayName = "TestBot_" .. i})
		local hl = new("Highlight", {Parent = m, FillColor = ESPColors.chams, OutlineColor = ESPColors.chams, FillTransparency = 0.55, OutlineTransparency = 0.2, Enabled = false})
		regPaint("chams", hl, "FillColor") regPaint("chams", hl, "OutlineColor")
		local ov = new("Frame", {Parent = espLayer, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1})
		local box = new("Frame", {Parent = ov, BackgroundTransparency = 1, Visible = false})
		regPaint("box", stroke(box, ESPColors.box, 0, 1.5), "Color")
		local hc = new("Frame", {Parent = ov, AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, Visible = false})
		corner(hc, 100000) regPaint("head", stroke(hc, ESPColors.head, 0, 1.5), "Color")
		local nm = new("TextLabel", {Parent = ov, BackgroundTransparency = 1, Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = ESPColors.name, Text = "TestBot_" .. i, Visible = false, TextTruncate = Enum.TextTruncate.AtEnd})
		regPaint("name", nm, "TextColor3")
		local lines = {}
		for _, j in ipairs(JOINTS) do
			local l = new("Frame", {Parent = ov, AnchorPoint = Vector2.new(0, 0.5), BackgroundColor3 = ESPColors.skeleton, BorderSizePixel = 0, Visible = false})
			regPaint("skeleton", l, "BackgroundColor3")
			table.insert(lines, {j[1], j[2], l})
		end
		table.insert(bots, {model = m, head = head, torso = torso, base = cf, hl = hl, overlay = ov, box = box, headC = hc, name = nm, lines = lines})
	end
	notify(tr("nBots"), tr("nBotsBody"))
end
local function clearBots()
	for _, b in ipairs(bots) do b.model:Destroy() b.overlay:Destroy() end
	bots = {}
	notify(tr("nClear"), tr("nClearBody"))
end

--== ГЛАВНЫЙ ЦИКЛ: ESP + FOV + АИМБОТ ==--
connect(RS.RenderStepped, function(dt)
	if not gui.Parent then return end
	local t = os.clock()
	local center = camera.ViewportSize / 2
	fovCircle.Position = UDim2.fromOffset(center.X, center.Y)
	fovCircle.Size = UDim2.fromOffset(Flags.fovRadius * 2, Flags.fovRadius * 2)
	fovCircle.Visible = Flags.showFov
	fovDot.Position = UDim2.fromOffset(center.X, center.Y)
	fovDot.Visible = Flags.showFov
	local best, bestDist = nil, math.huge
	for i, b in ipairs(bots) do
		if Flags.botMove then b.model:PivotTo(b.base * CFrame.new(0, math.sin(t * 2 + i) * 0.25, 0)) end
		local cf, size = b.model:GetBoundingBox()
		local minX, minY, maxX, maxY, ok = math.huge, math.huge, -math.huge, -math.huge, true
		for _, sx in ipairs({-1, 1}) do for _, sy in ipairs({-1, 1}) do for _, sz in ipairs({-1, 1}) do
			local v = camera:WorldToViewportPoint((cf * CFrame.new(size.X / 2 * sx, size.Y / 2 * sy, size.Z / 2 * sz)).Position)
			if v.Z <= 0 then ok = false end
			minX = math.min(minX, v.X) maxX = math.max(maxX, v.X)
			minY = math.min(minY, v.Y) maxY = math.max(maxY, v.Y)
		end end end
		local show = Flags.espMaster and ok
		b.box.Visible = show and Flags.box
		b.box.Position = UDim2.fromOffset(minX, minY)
		b.box.Size = UDim2.fromOffset(math.max(maxX - minX, 1), math.max(maxY - minY, 1))
		b.name.Visible = show and Flags.name
		b.name.Position = UDim2.fromOffset(minX, minY - 18)
		b.name.Size = UDim2.fromOffset(math.max(maxX - minX, 1), 16)
		local hp, hz = proj(b.head.Position)
		b.headC.Visible = show and Flags.head and hz > 0
		if hz > 0 then
			local r = math.abs(camera:WorldToViewportPoint(b.head.Position + camera.CFrame.RightVector * 0.6).X - hp.X)
			b.headC.Position = UDim2.fromOffset(hp.X, hp.Y)
			b.headC.Size = UDim2.fromOffset(r * 2, r * 2)
		end
		for _, ln in ipairs(b.lines) do
			local a, az = proj(b.model[ln[1]].Position)
			local c2, cz = proj(b.model[ln[2]].Position)
			ln[3].Visible = show and Flags.skeleton and az > 0 and cz > 0
			if ln[3].Visible then setLine(ln[3], a, c2) end
		end
		b.hl.Enabled = Flags.espMaster and Flags.chams
		if Flags.aimOn then
			local tp = Flags.target == "tHead" and b.head.Position or b.torso.Position
			local sp, sz = proj(tp)
			if sz > 0 then
				local d = (sp - center).Magnitude
				if d < Flags.fovRadius and d < bestDist then best, bestDist = tp, d end
			end
		end
	end
	if best and (UIS.TouchEnabled or UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)) then
		local alpha = math.clamp(dt * (3 + (100 - Flags.smooth) * 0.25), 0, 1)
		camera.CFrame = camera.CFrame:Lerp(CFrame.lookAt(camera.CFrame.Position, best), alpha)
	end
end)

--== ИГРОК: аватар с fallback, который скрывается после загрузки ==--
local pc = new("Frame", {Parent = sidebar, Size = UDim2.new(1, -24, 0, 64), Position = UDim2.new(0, 12, 1, -12), AnchorPoint = Vector2.new(0, 1), BackgroundColor3 = C.card, BackgroundTransparency = 0.2, BorderSizePixel = 0, ClipsDescendants = true, ZIndex = 2})
corner(pc, 6) stroke(pc, C.white, 0.87, 1) gloss(pc)
local av = new("ImageLabel", {Parent = pc, Position = UDim2.new(0, 10, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), Size = UDim2.fromOffset(42, 42), BackgroundColor3 = C.track, BackgroundTransparency = 0.15, BorderSizePixel = 0, Image = ""})
corner(av, 6) stroke(av, C.white, 0.85, 1)
local avFallback = {}
table.insert(avFallback, new("Frame", {Parent = av, Position = UDim2.fromOffset(15, 8), Size = UDim2.fromOffset(12, 12), BackgroundColor3 = C.sub, BorderSizePixel = 0}))
table.insert(avFallback, new("Frame", {Parent = av, Position = UDim2.fromOffset(10, 24), Size = UDim2.fromOffset(22, 12), BackgroundColor3 = C.sub, BorderSizePixel = 0}))
for _, f in ipairs(avFallback) do corner(f, 6) end
new("TextLabel", {Parent = pc, Position = UDim2.fromOffset(62, 13), Size = UDim2.new(1, -74, 0, 17), BackgroundTransparency = 1, Font = Enum.Font.GothamBold, TextSize = 14, TextColor3 = C.text, Text = Player.DisplayName, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd})
new("Frame", {Parent = pc, Position = UDim2.fromOffset(62, 38), Size = UDim2.fromOffset(6, 6), BackgroundColor3 = C.green, BorderSizePixel = 0})
local onl = new("TextLabel", {Parent = pc, Position = UDim2.fromOffset(74, 33), Size = UDim2.new(1, -86, 0, 15), BackgroundTransparency = 1, Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = C.sub, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd})
bindText(onl, "online")
task.spawn(function()
	for attempt = 1, 3 do
		local ok, img = pcall(function()
			return Players:GetUserThumbnailAsync(Player.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
		end)
		if ok and img and img ~= "" then
			av.Image = img
			for _, f in ipairs(avFallback) do f.Visible = false end
			break
		end
		task.wait(1.5)
	end
end)

--== КНОПКА ОТКРЫТЬ + DRAG + ОТКРЫТИЕ/ЗАКРЫТИЕ ==--
local openBtn = new("CanvasGroup", {Parent = gui, Size = UDim2.fromOffset(54, 54), Position = UDim2.new(0, 16, 0, 96), BackgroundColor3 = C.side, BackgroundTransparency = 0.12, BorderSizePixel = 0, Visible = false, GroupTransparency = 1, Active = true, ZIndex = 20})
corner(openBtn, 8) regAccent(stroke(openBtn, ACCENT, 0.45, 1.5), "Color") gloss(openBtn)
openScale = new("UIScale", {Parent = openBtn, Scale = 1})
for i, w in ipairs({20, 14, 20}) do
	local bar = new("Frame", {Parent = openBtn, Position = UDim2.fromOffset(17, 20 + (i - 1) * 6), Size = UDim2.fromOffset(w, 2), BackgroundColor3 = ACCENT, BorderSizePixel = 0})
	corner(bar, 1) regAccent(bar, "BackgroundColor3")
end
makeDraggable(openBtn, openBtn, function() return openScale.Scale end, function() setOpen(true) end)
makeDraggable(window, topbar, function() return uiScale.Scale end, nil)
function setOpen(o)
	if o == isOpen then return end
	isOpen = o
	if o then
		window.Visible = true window.GroupTransparency = 1 uiScale.Scale = baseScale * 0.92
		tw(window, {GroupTransparency = 0}, 0.28) tw(uiScale, {Scale = baseScale}, 0.32, Enum.EasingStyle.Back)
		tw(openBtn, {GroupTransparency = 1}, 0.18)
		task.delay(0.2, function() if isOpen then openBtn.Visible = false end end)
	else
		tw(window, {GroupTransparency = 1}, 0.22) tw(uiScale, {Scale = baseScale * 0.92}, 0.22)
		task.delay(0.24, function() if not isOpen then window.Visible = false end end)
		openBtn.Visible = true tw(openBtn, {GroupTransparency = 0}, 0.28)
	end
end
minBtn.Activated:Connect(function() setOpen(false) end)
closeBtn.Activated:Connect(function()
	isOpen = false
	tw(window, {GroupTransparency = 1}, 0.2) tw(uiScale, {Scale = baseScale * 0.9}, 0.2)
	task.delay(0.22, function() gui:Destroy() end)
end)
connect(UIS.InputBegan, function(i, gp)
	if not gp and i.KeyCode == Enum.KeyCode.RightShift and gui.Parent then setOpen(not isOpen) end
end)

