		BackgroundTransparency = 1,
		Text = username,
		TextColor3 = Color3.fromRGB(255, 255, 255),
		TextScaled = true,
		Font = Enum.Font.SourceSansSemibold,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, Info)

	New("TextLabel", {
		Name = "DaysLabel",
		Position = UDim2.new(0.28, 0, 0.54, 0),
		Size = UDim2.new(0.68, 0, 0.32, 0),
		BackgroundTransparency = 1,
		Text = "Expires: " .. tostring(daysLeft),
		TextColor3 = mainColor,
		TextScaled = true,
		Font = Enum.Font.SourceSans,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, Info)

	-- ── Tab & Controls API ─────────────────────────────────────
	local function SelectTab(index)
		local tab = tabs[index]
		if not tab then return end
		activeTabIndex = index
		for i, t in ipairs(tabs) do
			local selected = (i == index)
			t.Page.Visible = selected
			t.Button.BackgroundColor3 = selected and mainColor or Color3.fromRGB(18, 22, 36)
			t.Button.BackgroundTransparency = selected and 0.15 or 0.5
		end
	end

	function WindowObj:AddTab(title, iconName)
		tabOrder += 1
		local index = tabOrder

		local TabBtn = New("TextButton", {
			Name = "Tab_" .. index,
			Size = UDim2.new(1, 0, 0, 32),
			BackgroundColor3 = Color3.fromRGB(18, 22, 36),
			BackgroundTransparency = 0.5,
			BorderSizePixel = 0,
			Text = "",
			AutoButtonColor = false,
			LayoutOrder = index,
		}, TabList)
		New("UICorner", { CornerRadius = UDim.new(0, 6) }, TabBtn)

		local IconImg = New("ImageLabel", {
			Name = "Icon",
			Position = UDim2.new(0, 8, 0.5, -9),
			Size = UDim2.new(0, 18, 0, 18),
			BackgroundTransparency = 1,
			ImageColor3 = Color3.fromRGB(255, 255, 255),
		}, TabBtn)
		GetImageData(iconName or "home", IconImg)

		New("TextLabel", {
			Name = "Label",
			Position = UDim2.new(0, 32, 0, 0),
			Size = UDim2.new(1, -38, 1, 0),
			BackgroundTransparency = 1,
			Text = title or ("Tab " .. index),
			TextColor3 = Color3.fromRGB(240, 244, 255),
			TextSize = 14,
			Font = Enum.Font.SourceSansSemibold,
			TextXAlignment = Enum.TextXAlignment.Left,
		}, TabBtn)

		local Page = New("ScrollingFrame", {
			Name = "Page_" .. index,
			Size = UDim2.new(1, 0, 1, 0),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ScrollBarThickness = 3,
			CanvasSize = UDim2.new(0, 0, 0, 0),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			Visible = false,
		}, ContentHolder)
		New("UIListLayout", {
			Padding = UDim.new(0, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}, Page)
		New("UIPadding", {
			PaddingTop = UDim.new(0, 10),
			PaddingBottom = UDim.new(0, 10),
			PaddingLeft = UDim.new(0, 10),
			PaddingRight = UDim.new(0, 10),
		}, Page)

		local TabObj = { Button = TabBtn, Page = Page }
		table.insert(tabs, TabObj)

		TabBtn.MouseButton1Click:Connect(function()
			SelectTab(index)
		end)

		if activeTabIndex == nil then
			SelectTab(index)
		end

		function TabObj:AddButton(text, callback)
			local btn = New("TextButton", {
				Name = "Button_" .. tostring(text),
				Size = UDim2.new(1, 0, 0, 34),
				BackgroundColor3 = Color3.fromRGB(22, 27, 44),
				BackgroundTransparency = 0.2,
				BorderSizePixel = 0,
				Text = text or "Button",
				TextColor3 = Color3.fromRGB(255, 255, 255),
				TextSize = 14,
				Font = Enum.Font.SourceSansSemibold,
			}, Page)
			New("UICorner", { CornerRadius = UDim.new(0, 6) }, btn)
			btn.MouseButton1Click:Connect(function()
				if callback then
					task.spawn(callback)
				end
			end)
			return btn
		end

		function TabObj:AddToggle(text, default, callback)
			local state = (default == true)
			local row = New("Frame", {
				Name = "Toggle_" .. tostring(text),
				Size = UDim2.new(1, 0, 0, 34),
				BackgroundColor3 = Color3.fromRGB(22, 27, 44),
				BackgroundTransparency = 0.2,
				BorderSizePixel = 0,
			}, Page)
			New("UICorner", { CornerRadius = UDim.new(0, 6) }, row)

			New("TextLabel", {
				Position = UDim2.new(0, 10, 0, 0),
				Size = UDim2.new(0.75, 0, 1, 0),
				BackgroundTransparency = 1,
				Text = text or "Toggle",
				TextColor3 = Color3.fromRGB(255, 255, 255),
				TextSize = 14,
				Font = Enum.Font.SourceSansSemibold,
				TextXAlignment = Enum.TextXAlignment.Left,
			}, row)

			local box = New("TextButton", {
				Position = UDim2.new(1, -46, 0.5, -10),
				Size = UDim2.new(0, 36, 0, 20),
				BackgroundColor3 = state and mainColor or Color3.fromRGB(45, 52, 75),
				BorderSizePixel = 0,
				Text = "",
			}, row)
			New("UICorner", { CornerRadius = UDim.new(1, 0) }, box)

			local knob = New("Frame", {
				Position = state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8),
				Size = UDim2.new(0, 16, 0, 16),
				BackgroundColor3 = Color3.fromRGB(255, 255, 255),
				BorderSizePixel = 0,
			}, box)
			New("UICorner", { CornerRadius = UDim.new(1, 0) }, knob)

			local function setState(val, fire)
				state = (val == true)
				box.BackgroundColor3 = state and mainColor or Color3.fromRGB(45, 52, 75)
				knob.Position = state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)
				if fire and callback then
					task.spawn(callback, state)
				end
			end

			box.MouseButton1Click:Connect(function()
				setState(not state, true)
			end)

			return {
				Set = function(_, v) setState(v, true) end,
				Get = function() return state end,
			}
		end

		function TabObj:AddSlider(text, minVal, maxVal, defaultVal, callback)
			minVal = minVal or 0
			maxVal = maxVal or 100
			local value = math.clamp(defaultVal or minVal, minVal, maxVal)

			local row = New("Frame", {
				Name = "Slider_" .. tostring(text),
				Size = UDim2.new(1, 0, 0, 46),
				BackgroundColor3 = Color3.fromRGB(22, 27, 44),
				BackgroundTransparency = 0.2,
				BorderSizePixel = 0,
			}, Page)
			New("UICorner", { CornerRadius = UDim.new(0, 6) }, row)

			New("TextLabel", {
				Position = UDim2.new(0, 10, 0, 4),
				Size = UDim2.new(0.7, 0, 0, 18),
				BackgroundTransparency = 1,
				Text = text or "Slider",
				TextColor3 = Color3.fromRGB(255, 255, 255),
				TextSize = 13,
				Font = Enum.Font.SourceSansSemibold,
				TextXAlignment = Enum.TextXAlignment.Left,
			}, row)

			local valLbl = New("TextLabel", {
				Position = UDim2.new(0.7, 0, 0, 4),
				Size = UDim2.new(0.3, -10, 0, 18),
				BackgroundTransparency = 1,
				Text = tostring(value),
				TextColor3 = Color3.fromRGB(180, 190, 215),
				TextSize = 13,
				Font = Enum.Font.SourceSansSemibold,
				TextXAlignment = Enum.TextXAlignment.Right,
			}, row)

			local track = New("TextButton", {
				Position = UDim2.new(0, 10, 0, 28),
				Size = UDim2.new(1, -20, 0, 8),
				BackgroundColor3 = Color3.fromRGB(40, 46, 68),
				BorderSizePixel = 0,
				Text = "",
			}, row)
			New("UICorner", { CornerRadius = UDim.new(1, 0) }, track)

			local fill = New("Frame", {
				Size = UDim2.new((value - minVal) / math.max(maxVal - minVal, 1e-6), 0, 1, 0),
				BackgroundColor3 = mainColor,
				BorderSizePixel = 0,
			}, track)
			New("UICorner", { CornerRadius = UDim.new(1, 0) }, fill)

			local sliding = false

			local function updateFromX(x)
				local rel = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
				local newVal = math.round(minVal + rel * (maxVal - minVal))
				value = newVal
				fill.Size = UDim2.new((value - minVal) / math.max(maxVal - minVal, 1e-6), 0, 1, 0)
				valLbl.Text = tostring(value)
				if callback then
					task.spawn(callback, value)
				end
			end

			track.MouseButton1Down:Connect(function(x)
				sliding = true
				updateFromX(x)
			end)

			UserInputService.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 then
					sliding = false
				end
			end)

			UserInputService.InputChanged:Connect(function(input)
				if sliding and input.UserInputType == Enum.UserInputType.MouseMovement then
					updateFromX(input.Position.X)
				end
			end)

			return {
				Set = function(_, v)
					value = math.clamp(v, minVal, maxVal)
					fill.Size = UDim2.new((value - minVal) / math.max(maxVal - minVal, 1e-6), 0, 1, 0)
					valLbl.Text = tostring(value)
				end,
				Get = function() return value end,
			}
		end

		return TabObj
	end

	function WindowObj:ToggleVisible()
		MainFrame.Visible = not MainFrame.Visible
		if AcrylicBlur then
			AcrylicBlur.Enabled = MainFrame.Visible
			if AcrylicBlur.Instances and AcrylicBlur.Instances.Part then
				AcrylicBlur.Instances.Part.Transparency = MainFrame.Visible and 0.8 or 1
			end
		end
	end

	function WindowObj:Destroy()
		if statsConn then statsConn:Disconnect() end
		if AcrylicBlur and AcrylicBlur.Destroy then
			pcall(AcrylicBlur.Destroy)
		end
		if NeverloseCS2 then
			NeverloseCS2:Destroy()
		end
	end

	return WindowObj
end

-- Пример запуска:
local win = Library:AddWindow("Neverlose", "", "Roblox Hub", { daysLeft = "Lifetime" })
local mainTab = win:AddTab("Main", "home")
mainTab:AddToggle("Example Toggle", false, function(state)
	print("Toggle:", state)
end)
mainTab:AddSlider("WalkSpeed", 16, 100, 16, function(val)
	local char = LocalPlayer and LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.WalkSpeed = val
	end
end)
mainTab:AddButton("Reset Speed", function()
	local char = LocalPlayer and LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.WalkSpeed = 16
	end
end)
