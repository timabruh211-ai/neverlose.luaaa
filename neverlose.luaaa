end)
toggle(p1.c1, "tFarm", "dFarm", false, function(on)
	-->>> ВСТАВЬ СВОЙ КОД: авто-фарм
end)
section(p1.c2, "secFarm")
slider(p1.c2, "sSpeed", 1, 100, 50, 1, "%", function(v)
	-->>> ВСТАВЬ СВОЙ КОД: скорость фарма
end)
dropdown(p1.c2, "dMode", {"mSafe", "mNormal", "mAggro"}, 2, function(key)
	-->>> ВСТАВЬ СВОЙ КОД: режим фарма (key = mSafe / mNormal / mAggro)
end)
button(p1.c2, "btnNotify", function()
	notify(tr("nTest"), tr("nTestBody"))
end)

--== ВКЛАДКА 2: ВИЗУАЛ ==--
makeTab("tabVisual", iconEye)
local p2 = makePage()
section(p2.c1, "secRender")
toggle(p2.c1, "tBright", "dBright", false, function(on)
	pcall(function()
		Lighting.Brightness = on and 2 or origBright
		Lighting.Ambient = on and Color3.fromRGB(170, 170, 170) or origAmbient
	end)
	-->>> ВСТАВЬ СВОЙ КОД: дополнительные эффекты фуллбрайта
end)
toggle(p2.c1, "tShadow", "dShadow", false, function(on)
	pcall(function() Lighting.GlobalShadows = not on end)
end)
section(p2.c2, "secCamera")
slider(p2.c2, "sFov", 40, 120, 70, 1, "°", function(v)
	pcall(function() camera.FieldOfView = v end)
end)
slider(p2.c2, "sGlass", 10, 60, 25, 1, "%", function(v)
	window.BackgroundTransparency = v / 100
	sidebar.BackgroundTransparency = math.max(0.05, v / 100 - 0.07)
end)
dropdown(p2.c2, "dQuality", {"qLow", "qMed", "qHigh"}, 2, function(key, i)
	pcall(function()
		UserSettings():GetService("UserGameSettings").SavedQualityLevel = ({Enum.SavedQualitySetting.QualityLevel1, Enum.SavedQualitySetting.QualityLevel5, Enum.SavedQualitySetting.QualityLevel10})[i]
	end)
	-->>> ВСТАВЬ СВОЙ КОД: пресеты графики
end)

--== ВКЛАДКА 3: ИГРОК ==--
makeTab("tabPlayer", iconUser)
local p3 = makePage()
section(p3.c1, "secMove")
slider(p3.c1, "sWalk", 16, 200, 16, 1, "", function(v)
	pcall(function() Player.Character.Humanoid.WalkSpeed = v end)
end)
slider(p3.c1, "sJump", 50, 350, 50, 1, "", function(v)
	pcall(function()
		local h = Player.Character.Humanoid
		h.UseJumpPower = true
		h.JumpPower = v
	end)
end)
section(p3.c2, "secAbilities")
toggle(p3.c2, "tInfJump", "dInfJump", false, function(on)
	-->>> ВСТАВЬ СВОЙ КОД: логика бесконечного прыжка (уже работает через JumpRequest выше)
end)
toggle(p3.c2, "tNoclip", "dNoclip", false, function(on)
	-->>> ВСТАВЬ СВОЙ КОД: логика noclip (уже работает через Stepped выше)
end)

--== ВКЛАДКА 4: НАСТРОЙКИ ==--
makeTab("tabSettings", iconGear)
local p4 = makePage()
section(p4.c1, "secInterface")
accentPicker(p4.c1)
langPicker(p4.c1)
section(p4.c2, "secWindow")
dropdown(p4.c2, "sScale", {"scAuto", "sc80", "sc100", "sc120"}, 1, function(key, i)
	userScale = ({0, 0.8, 1, 1.2})[i]
	updateScale()
end)
button(p4.c2, "btnMinimize", function() setOpen(false) end)
infoCard(p4.c2, "hintTitle", "hintBody")

--== ЗАПУСК:入场-анимация, адаптация, приветственный тост ==--
gui.Destroying:Connect(function()
	for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
end)
hookCamera()
selectTab(1)
window.GroupTransparency = 1
uiScale.Scale = baseScale * 0.92
task.delay(0.1, function()
	tw(window, {GroupTransparency = 0}, 0.35)
	tw(uiScale, {Scale = baseScale}, 0.4, Enum.EasingStyle.Back)
end)
task.delay(0.7, function() notify(tr("welcomeTitle"), tr("welcomeBody")) end)
