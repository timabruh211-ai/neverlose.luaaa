-- 4. SETTINGS (Смена темы + Config System)
local ThemeSec = SettingsTab:CreateSection("THEME & ACCENT", "left")
local ConfigSec = SettingsTab:CreateSection("CONFIG MANAGER", "right")

ThemeSec:CreateColorPicker({
	Name = "Accent Color",
	Default = ThemeRegistry.Accent,
	Flag = "Settings_AccentColor",
	Callback = function(newColor)
		ThemeRegistry:SetAccent(newColor)
		Library:Log("Акцентный цвет темы изменён в реальном времени.", "SUCCESS")
	end,
})

ThemeSec:CreateButton({
	Name = "Cycle Preset Accent",
	Callback = function()
		local cur = ThemeRegistry.Accent
		local nextIdx = 1
		for i, c in ipairs(PRESET_ACCENTS) do
			if (c - cur).Magnitude < 0.02 then
				nextIdx = (i % #PRESET_ACCENTS) + 1
				break
			end
		end
		local chosen = PRESET_ACCENTS[nextIdx]
		ThemeRegistry:SetAccent(chosen)
		if Library.Flags["Settings_AccentColor"] then
			Library.Flags["Settings_AccentColor"]:Set(chosen, true)
		end
		Library:Notify({
			Title = "Theme Updated",
			Text = "Применён новый пресет акцентного цвета.",
			Duration = 2.5,
			Type = "INFO",
		})
	end,
})

ThemeSec:CreateParagraph({
	Title = "Live Theme Engine",
	Content = "Изменение акцента мгновенно обновляет индикатор вкладок, слайдеры, переключатели и рамки.",
})

local cfgSlotInput = ConfigSec:CreateInput({
	Name = "Config Name",
	Placeholder = "default",
	Default = "default",
	Numeric = false,
	Flag = "Config_SlotName",
})

ConfigSec:CreateButton({
	Name = "Save Config",
	Callback = function()
		Library:SaveConfig(cfgSlotInput:Get())
	end,
})

ConfigSec:CreateButton({
	Name = "Load Config",
	Callback = function()
		Library:LoadConfig(cfgSlotInput:Get())
	end,
})

ConfigSec:CreateParagraph({
	Title = "JSON Storage",
	Content = "Конфигурации сохраняются в NeverloseUI/Configs/<name>.json с поддержкой Color3 и EnumItem.",
})

-- Стартовые логи и уведомление
Library:Log("Библиотека NEVERLOSE (" .. Library.Version .. ") полностью инициализирована.", "SUCCESS")
