	})
	Round(collapseBtn, 6)

	local pagesHost = Create("Frame", {
		Name = "PagesHost",
		Size = UDim2.new(1, -16, 1, -54),
		Position = UDim2.new(0, 8, 0, 50),
		BackgroundColor3 = ThemeRegistry.Sidebar,
		BackgroundTransparency = 0.35,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Parent = contentArea,
	})
	Round(pagesHost, 8)

	-- Перетаскивание окна и плавающей кнопки (кроссплатформенно)
	BindDraggable(mainFrame, headerBar, maid)
	BindDraggable(mainFrame, logoHeader, maid)

	local floatMoved = false
	local floatDrag = false
	local floatInp = nil
	local floatStartInp = Vector2.zero
	local floatStartPos = floatBtn.Position

	maid:GiveTask(floatBtn.InputBegan:Connect(function(input)
		if IsPointerDown(input) then
			floatDrag = true
			floatMoved = false
			floatInp = input
			floatStartInp = input.Position
			floatStartPos = floatBtn.Position
		end
	end))

	maid:GiveTask(UserInputService.InputChanged:Connect(function(input)
		if floatDrag and input == floatInp and IsPointerMove(input) then
			local delta = input.Position - floatStartInp
			if delta.Magnitude > 6 then
				floatMoved = true
			end
			floatBtn.Position = UDim2.new(
				floatStartPos.X.Scale,
				floatStartPos.X.Offset + delta.X,
				floatStartPos.Y.Scale,
				floatStartPos.Y.Offset + delta.Y
			)
		end
	end))

	local isMinimized = false
	local animBusy = false

	local function SetWindowMinimized(targetMinimized)
		if animBusy or isMinimized == targetMinimized then
			return
		end
		isMinimized = targetMinimized
		animBusy = true

		if isMinimized then
			collapseBtn.Text = "Show"
			local tw1 = TweenService:Create(uiScale, TweenInfo.new(0.24, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {
				Scale = 0.01,
			})
			local tw2 = TweenService:Create(mainFrame, TweenInfo.new(0.24, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {
				BackgroundTransparency = 1,
			})
			tw1:Play()
			tw2:Play()
			tw1.Completed:Once(function()
				mainFrame.Visible = false
				animBusy = false
			end)
		else
			collapseBtn.Text = "Hide"
			mainFrame.Visible = true
			uiScale.Scale = 0.01
			mainFrame.BackgroundTransparency = 1
			local targetScale = ComputeResponsiveScale(workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1280, 720))
			local tw1 = TweenService:Create(uiScale, TweenInfo.new(0.28, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
				Scale = targetScale,
			})
			local tw2 = TweenService:Create(mainFrame, TweenInfo.new(0.28, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
				BackgroundTransparency = 0.06,
			})
			tw1:Play()
			tw2:Play()
			tw1.Completed:Once(function()
				animBusy = false
			end)
		end
	end

	maid:GiveTask(UserInputService.InputEnded:Connect(function(input)
		if input == floatInp then
			local wasMoved = floatMoved
			floatDrag = false
			floatInp = nil
			if not wasMoved and IsPointerDown(input) then
				SetWindowMinimized(not isMinimized)
			end
		end
	end))

	maid:GiveTask(collapseBtn.MouseButton1Click:Connect(function()
		SetWindowMinimized(not isMinimized)
	end))

	maid:GiveTask(UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if not gameProcessed and input.KeyCode == Enum.KeyCode.RightShift then
			SetWindowMinimized(not isMinimized)
		end
	end))

	-- Подписка на смену темы в реальном времени
	maid:GiveTask(ThemeRegistry.ThemeChanged:Connect(function(newAccent)
		activeIndicator.BackgroundColor3 = newAccent
		avatarStroke.Color = newAccent
		floatStroke.Color = newAccent
		floatBtn.TextColor3 = newAccent
		sessionLbl.TextColor3 = newAccent
		collapseBtn.TextColor3 = newAccent
		tabContainer.ScrollBarImageColor3 = newAccent
		logoGrad.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, ThemeRegistry.Text),
			ColorSequenceKeypoint.new(0.5, newAccent),
			ColorSequenceKeypoint.new(1, ThemeRegistry.Text),
		})
	end))

	-- Адаптивный скейл и обновление таймера сессии
	local elapsedAcc = 0
	local logoAngle = 0
	maid:GiveTask(RunService.Heartbeat:Connect(function(dt)
		if not gui.Parent then
			return
		end
		logoAngle = (logoAngle + dt * 55) % 360
		logoGrad.Rotation = logoAngle

		elapsedAcc += dt
		if elapsedAcc >= 1 then
			elapsedAcc -= 1
			sessionLbl.Text = FormatSessionElapsed(sessionStart)
		end

		if not isMinimized and not animBusy then
			local cam = workspace.CurrentCamera
			if cam then
				local desired = ComputeResponsiveScale(cam.ViewportSize)
				if math.abs(uiScale.Scale - desired) > 0.01 then
					uiScale.Scale = desired
				end
			end
		end
	end))

	-- Вспомогательный конструктор элементов внутри секции (OOP API)
	local layoutOrderCounter = 0
	local function NextOrder()
		layoutOrderCounter += 1
		return layoutOrderCounter
	end

	local function RegisterFlag(flagName, controller)
		if type(flagName) == "string" and flagName ~= "" then
			Library.Flags[flagName] = controller
		end
	end

	local function BuildSectionControls(sectionListFrame)
		local sectionApi = {}

		local function MakeBaseRow(heightPx)
			return Create("Frame", {
				Size = UDim2.new(1, 0, 0, heightPx),
				BackgroundColor3 = ThemeRegistry.Row,
				BackgroundTransparency = 0.15,
				BorderSizePixel = 0,
				LayoutOrder = NextOrder(),
				Parent = sectionListFrame,
			})
		end

		-- 1. CreateToggle
		function sectionApi:CreateToggle(opts)
			opts = opts or {}
			local name = tostring(opts.Name or "Toggle")
			local currentVal = (opts.Default == true)
			local callback = opts.Callback
			local flag = opts.Flag

			local row = MakeBaseRow(30)
			Round(row, 6)

			Create("TextLabel", {
				Size = UDim2.new(1, -56, 1, 0),
				Position = UDim2.new(0, 9, 0, 0),
				BackgroundTransparency = 1,
				Text = name,
				TextColor3 = ThemeRegistry.Text,
				TextSize = 11,
				Font = Enum.Font.GothamMedium,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd,
				Parent = row,
			})

			local pillBtn = Create("TextButton", {
				Size = UDim2.new(0, 34, 0, 18),
				Position = UDim2.new(1, -42, 0.5, -9),
				BackgroundColor3 = currentVal and ThemeRegistry.Accent or Color3.fromRGB(44, 54, 78),
				BorderSizePixel = 0,
				Text = "",
				AutoButtonColor = false,
				Parent = row,
			})
			Round(pillBtn, 9)

			local knob = Create("Frame", {
				Size = UDim2.new(0, 14, 0, 14),
				Position = currentVal and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7),
				BackgroundColor3 = Color3.fromRGB(255, 255, 255),
				BorderSizePixel = 0,
				Parent = pillBtn,
			})
			Round(knob, 7)

			local animInfo = TweenInfo.new(0.18, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)

			local controller = {}
			function controller:Get()
				return currentVal
			end

			function controller:Set(value, skipCallback)
				currentVal = (value == true)
				TweenService:Create(pillBtn, animInfo, {
					BackgroundColor3 = currentVal and ThemeRegistry.Accent or Color3.fromRGB(44, 54, 78),
				}):Play()
				TweenService:Create(knob, animInfo, {
					Position = currentVal and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7),
				}):Play()
				if not skipCallback and type(callback) == "function" then
					task.spawn(callback, currentVal)
				end
			end

			maid:GiveTask(pillBtn.MouseButton1Click:Connect(function()
				controller:Set(not currentVal, false)
			end))

			maid:GiveTask(ThemeRegistry.ThemeChanged:Connect(function(newAcc)
				if currentVal then
					pillBtn.BackgroundColor3 = newAcc
				end
			end))

			if currentVal and type(callback) == "function" then
				task.spawn(callback, currentVal)
			end

			RegisterFlag(flag, controller)
			return controller
		end

		-- 2. CreateSlider
		function sectionApi:CreateSlider(opts)
			opts = opts or {}
			local name = tostring(opts.Name or "Slider")
			local minVal = tonumber(opts.Min) or 0
			local maxVal = tonumber(opts.Max) or 100
			local increment = tonumber(opts.Increment) or 1
			if increment <= 0 then
				increment = 1
			end
			local suffix = tostring(opts.Suffix or "")
			local callback = opts.Callback
			local flag = opts.Flag

			local function SnapValue(raw)
				local clamped = math.clamp(raw, minVal, maxVal)
				local snapped = minVal + math.floor(((clamped - minVal) / increment) + 0.5) * increment
				return math.clamp(snapped, minVal, maxVal)
			end

			local function FormatNumber(v)
				if increment < 1 then
					return string.format("%.2f", v) .. suffix
				end
				return tostring(math.round(v)) .. suffix
			end

			local currentVal = SnapValue(tonumber(opts.Default) or minVal)

			local row = MakeBaseRow(40)
			Round(row, 6)

			Create("TextLabel", {
				Size = UDim2.new(0.65, -8, 0, 16),
				Position = UDim2.new(0, 9, 0, 4),
				BackgroundTransparency = 1,
				Text = name,
				TextColor3 = ThemeRegistry.Text,
				TextSize = 11,
				Font = Enum.Font.GothamMedium,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd,
				Parent = row,
			})

			local valueLbl = Create("TextLabel", {
				Size = UDim2.new(0.35, -9, 0, 16),
				Position = UDim2.new(0.65, 0, 0, 4),
				BackgroundTransparency = 1,
				Text = FormatNumber(currentVal),
				TextColor3 = ThemeRegistry.Accent,
				TextSize = 11,
				Font = Enum.Font.GothamBold,
				TextXAlignment = Enum.TextXAlignment.Right,
				Parent = row,
			})

			local track = Create("Frame", {
				Size = UDim2.new(1, -18, 0, 7),
				Position = UDim2.new(0, 9, 0, 25),
				BackgroundColor3 = Color3.fromRGB(34, 44, 68),
				BorderSizePixel = 0,
				Parent = row,
			})
			Round(track, 4)

			local ratioInit = (maxVal > minVal) and ((currentVal - minVal) / (maxVal - minVal)) or 0
			local fill = Create("Frame", {
				Size = UDim2.new(math.clamp(ratioInit, 0, 1), 0, 1, 0),
				Position = UDim2.new(0, 0, 0, 0),
				BackgroundColor3 = ThemeRegistry.Accent,
				BorderSizePixel = 0,
				Parent = track,
			})
			Round(fill, 4)

			local knob = Create("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Size = UDim2.new(0, 12, 0, 12),
				Position = UDim2.new(math.clamp(ratioInit, 0, 1), 0, 0.5, 0),
				BackgroundColor3 = Color3.fromRGB(255, 255, 255),
				BorderSizePixel = 0,
				Parent = track,
			})
			Round(knob, 6)

			local controller = {}
			function controller:Get()
				return currentVal
			end

			function controller:Set(value, skipCallback)
				currentVal = SnapValue(tonumber(value) or minVal)
				local r = (maxVal > minVal) and ((currentVal - minVal) / (maxVal - minVal)) or 0
				r = math.clamp(r, 0, 1)
				valueLbl.Text = FormatNumber(currentVal)
				TweenService:Create(fill, TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
					Size = UDim2.new(r, 0, 1, 0),
				}):Play()
				TweenService:Create(knob, TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
					Position = UDim2.new(r, 0, 0.5, 0),
				}):Play()
				if not skipCallback and type(callback) == "function" then
					task.spawn(callback, currentVal)
				end
			end

			local dragging = false
			local dragInput = nil

			local function UpdateFromScreenX(screenX)
				local barX = track.AbsolutePosition.X
				local barW = math.max(track.AbsoluteSize.X, 1)
				local norm = math.clamp((screenX - barX) / barW, 0, 1)
				local raw = minVal + norm * (maxVal - minVal)
				controller:Set(raw, false)
			end

			maid:GiveTask(track.InputBegan:Connect(function(input)
				if IsPointerDown(input) then
					dragging = true
					dragInput = input
					UpdateFromScreenX(input.Position.X)
				end
			end))

			maid:GiveTask(UserInputService.InputChanged:Connect(function(input)
				if dragging and input == dragInput and IsPointerMove(input) then
					UpdateFromScreenX(input.Position.X)
				end
			end))

			maid:GiveTask(UserInputService.InputEnded:Connect(function(input)
				if input == dragInput then
					dragging = false
					dragInput = nil
				end
			end))

			maid:GiveTask(ThemeRegistry.ThemeChanged:Connect(function(newAcc)
				fill.BackgroundColor3 = newAcc
				valueLbl.TextColor3 = newAcc
			end))

			RegisterFlag(flag, controller)
			return controller
		end

		-- 3. CreateButton
		function sectionApi:CreateButton(opts)
			opts = opts or {}
			local name = tostring(opts.Name or "Button")
			local callback = opts.Callback

			local btn = Create("TextButton", {
				Size = UDim2.new(1, 0, 0, 28),
				BackgroundColor3 = ThemeRegistry.Row,
				BorderSizePixel = 0,
				Text = name,
				TextColor3 = ThemeRegistry.Text,
				TextSize = 11,
				Font = Enum.Font.GothamBold,
				AutoButtonColor = false,
				ClipsDescendants = true,
				LayoutOrder = NextOrder(),
				Parent = sectionListFrame,
			})
			Round(btn, 6)

			local btnStroke = Create("UIStroke", {
				Color = ThemeRegistry.Stroke,
				Thickness = 1,
				Parent = btn,
			})

			maid:GiveTask(btn.MouseButton1Click:Connect(function()
				TweenService:Create(btn, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
					BackgroundColor3 = ThemeRegistry.AccentDark,
				}):Play()
				TweenService:Create(btnStroke, TweenInfo.new(0.1), {
					Color = ThemeRegistry.Accent,
				}):Play()
				task.delay(0.14, function()
					if btn and btn.Parent then
						TweenService:Create(btn, TweenInfo.new(0.22, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
							BackgroundColor3 = ThemeRegistry.Row,
						}):Play()
						TweenService:Create(btnStroke, TweenInfo.new(0.22), {
							Color = ThemeRegistry.Stroke,
						}):Play()
					end
				end)
				if type(callback) == "function" then
					task.spawn(callback)
				end
			end))

			return btn
		end

		-- 4. CreateDropdown (Single & Multi)
		function sectionApi:CreateDropdown(opts)
			opts = opts or {}
			local name = tostring(opts.Name or "Dropdown")
			local options = opts.Options or {}
			local isMulti = (opts.Multi == true)
			local callback = opts.Callback
			local flag = opts.Flag

			local selectedSingle = opts.Default or options[1] or ""
			local selectedMulti = {}

			if isMulti then
				if type(opts.Default) == "table" then
					for k, v in pairs(opts.Default) do
						if type(k) == "number" then
							selectedMulti[tostring(v)] = true
						elseif v == true then
							selectedMulti[tostring(k)] = true
						end
					end
				end
			end

			local function GetMultiList()
				local arr = {}
				for _, opt in ipairs(options) do
					local key = tostring(opt)
					if selectedMulti[key] then
						table.insert(arr, key)
					end
				end
				return arr
			end

			local function FormatButtonText()
				if isMulti then
					local list = GetMultiList()
					if #list == 0 then
						return "None ▾"
					end
					return table.concat(list, ", ") .. " ▾"
				end
				return tostring(selectedSingle) .. " ▾"
			end

			local container = Create("Frame", {
				Size = UDim2.new(1, 0, 0, 30),
				BackgroundColor3 = ThemeRegistry.Row,
				BackgroundTransparency = 0.15,
				BorderSizePixel = 0,
				ClipsDescendants = true,
				LayoutOrder = NextOrder(),
				Parent = sectionListFrame,
			})
			Round(container, 6)

			Create("TextLabel", {
				Size = UDim2.new(0.45, -8, 0, 30),
				Position = UDim2.new(0, 9, 0, 0),
				BackgroundTransparency = 1,
				Text = name,
				TextColor3 = ThemeRegistry.Text,
				TextSize = 11,
				Font = Enum.Font.GothamMedium,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd,
				Parent = container,
			})

			local dropBtn = Create("TextButton", {
				Size = UDim2.new(0.52, -6, 0, 22),
				Position = UDim2.new(0.48, 0, 0, 4),
				BackgroundColor3 = ThemeRegistry.Section,
				BorderSizePixel = 0,
				Text = FormatButtonText(),
				TextColor3 = ThemeRegistry.Text,
				TextSize = 10,
				Font = Enum.Font.GothamBold,
				TextTruncate = Enum.TextTruncate.AtEnd,
				AutoButtonColor = false,
				Parent = container,
			})
			Round(dropBtn, 5)

			local listHolder = Create("Frame", {
				Size = UDim2.new(1, -12, 0, 0),
				Position = UDim2.new(0, 6, 0, 34),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Parent = container,
			})

			Create("UIListLayout", {
				FillDirection = Enum.FillDirection.Vertical,
				SortOrder = Enum.SortOrder.LayoutOrder,
				Padding = UDim.new(0, 3),
				Parent = listHolder,
			})

			local rowH = 22
			local padY = 4
			local expandedHeight = 34 + (#options * (rowH + 3)) + padY
			local isOpen = false
			local optionBtns = {}

			local function RefreshOptionVisuals()
				for optKey, btnObj in pairs(optionBtns) do
					local active = isMulti and (selectedMulti[optKey] == true) or (tostring(selectedSingle) == optKey)
					btnObj.BackgroundColor3 = active and ThemeRegistry.Accent or ThemeRegistry.Section
				end
				dropBtn.Text = FormatButtonText()
			end

			local controller = {}
			function controller:Get()
				if isMulti then
					return GetMultiList()
				end
				return selectedSingle
			end

			function controller:Set(val, skipCallback)
				if isMulti then
					table.clear(selectedMulti)
					if type(val) == "table" then
						for k, v in pairs(val) do
							if type(k) == "number" then
								selectedMulti[tostring(v)] = true
							elseif v == true then
								selectedMulti[tostring(k)] = true
							end
						end
					elseif val ~= nil then
						selectedMulti[tostring(val)] = true
					end
					RefreshOptionVisuals()
					if not skipCallback and type(callback) == "function" then
						task.spawn(callback, GetMultiList())
					end
				else
					selectedSingle = tostring(val or "")
					RefreshOptionVisuals()
					if not skipCallback and type(callback) == "function" then
						task.spawn(callback, selectedSingle)
					end
				end
			end

			for idx, opt in ipairs(options) do
				local optKey = tostring(opt)
				local optBtn = Create("TextButton", {
					Size = UDim2.new(1, 0, 0, rowH),
					BackgroundColor3 = ThemeRegistry.Section,
					BorderSizePixel = 0,
					Text = optKey,
					TextColor3 = ThemeRegistry.Text,
					TextSize = 10,
					Font = Enum.Font.GothamMedium,
					AutoButtonColor = false,
					LayoutOrder = idx,
					Parent = listHolder,
				})
				Round(optBtn, 5)
				optionBtns[optKey] = optBtn

				maid:GiveTask(optBtn.MouseButton1Click:Connect(function()
					if isMulti then
						selectedMulti[optKey] = not selectedMulti[optKey]
						RefreshOptionVisuals()
						if type(callback) == "function" then
							task.spawn(callback, GetMultiList())
						end
					else
						selectedSingle = optKey
						RefreshOptionVisuals()
						isOpen = false
						TweenService:Create(container, TweenInfo.new(0.2, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {
							Size = UDim2.new(1, 0, 0, 30),
						}):Play()
						if type(callback) == "function" then
							task.spawn(callback, selectedSingle)
						end
					end
				end))
			end

			RefreshOptionVisuals()

			maid:GiveTask(dropBtn.MouseButton1Click:Connect(function()
				isOpen = not isOpen
				local targetH = isOpen and expandedHeight or 30
				TweenService:Create(container, TweenInfo.new(0.22, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
					Size = UDim2.new(1, 0, 0, targetH),
				}):Play()
			end))

			maid:GiveTask(ThemeRegistry.ThemeChanged:Connect(function()
				RefreshOptionVisuals()
			end))

			RegisterFlag(flag, controller)
			return controller
		end

		-- 5. CreateInput
		function sectionApi:CreateInput(opts)
			opts = opts or {}
			local name = tostring(opts.Name or "Input")
			local placeholder = tostring(opts.Placeholder or "Enter text...")
			local isNumeric = (opts.Numeric == true)
			local callback = opts.Callback
			local flag = opts.Flag
			local currentText = tostring(opts.Default or "")

			local function SanitizeInput(str)
				if not isNumeric then
					return str
				end
				return string.gsub(str, "[^%d%.%-]", "")
			end

			currentText = SanitizeInput(currentText)

			local row = MakeBaseRow(32)
			Round(row, 6)

			Create("TextLabel", {
				Size = UDim2.new(0.42, -8, 1, 0),
				Position = UDim2.new(0, 9, 0, 0),
				BackgroundTransparency = 1,
				Text = name,
				TextColor3 = ThemeRegistry.Text,
				TextSize = 11,
				Font = Enum.Font.GothamMedium,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd,
				Parent = row,
			})

			local boxBg = Create("Frame", {
				Size = UDim2.new(0.55, -6, 0, 22),
				Position = UDim2.new(0.45, 0, 0.5, -11),
				BackgroundColor3 = ThemeRegistry.Section,
				BorderSizePixel = 0,
				Parent = row,
			})
			Round(boxBg, 5)

			local boxStroke = Create("UIStroke", {
				Color = ThemeRegistry.Stroke,
				Thickness = 1,
				Parent = boxBg,
			})

			local box = Create("TextBox", {
				Size = UDim2.new(1, -10, 1, 0),
				Position = UDim2.new(0, 5, 0, 0),
				BackgroundTransparency = 1,
				Text = currentText,
				PlaceholderText = placeholder,
				PlaceholderColor3 = ThemeRegistry.Muted,
				TextColor3 = ThemeRegistry.Text,
				TextSize = 10,
				Font = Enum.Font.GothamMedium,
				TextXAlignment = Enum.TextXAlignment.Left,
				ClearTextOnFocus = false,
				Parent = boxBg,
			})

			local controller = {}
			function controller:Get()
				if isNumeric then
					return tonumber(currentText) or 0
				end
				return currentText
			end

			function controller:Set(val, skipCallback)
				currentText = SanitizeInput(tostring(val or ""))
				box.Text = currentText
				if not skipCallback and type(callback) == "function" then
					task.spawn(callback, controller:Get())
				end
			end

			maid:GiveTask(box:GetPropertyChangedSignal("Text"):Connect(function()
				local cleaned = SanitizeInput(box.Text)
				if cleaned ~= box.Text then
					box.Text = cleaned
				end
				currentText = cleaned
			end))

			maid:GiveTask(box.Focused:Connect(function()
				boxStroke.Color = ThemeRegistry.Accent
			end))

			maid:GiveTask(box.FocusLost:Connect(function()
				boxStroke.Color = ThemeRegistry.Stroke
				currentText = SanitizeInput(box.Text)
				box.Text = currentText
				if type(callback) == "function" then
					task.spawn(callback, controller:Get())
				end
			end))

			RegisterFlag(flag, controller)
			return controller
		end

		-- 6. CreateKeybind
		function sectionApi:CreateKeybind(opts)
			opts = opts or {}
			local name = tostring(opts.Name or "Keybind")
			local currentKey = opts.Default or Enum.KeyCode.F
			local callback = opts.Callback
			local flag = opts.Flag
			local listening = false

			local function FormatKey(k)
				if typeof(k) == "EnumItem" then
					return k.Name
				end
				return tostring(k or "None")
			end

			local row = MakeBaseRow(30)
			Round(row, 6)

			Create("TextLabel", {
				Size = UDim2.new(0.55, -8, 1, 0),
				Position = UDim2.new(0, 9, 0, 0),
				BackgroundTransparency = 1,
				Text = name,
				TextColor3 = ThemeRegistry.Text,
				TextSize = 11,
				Font = Enum.Font.GothamMedium,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd,
				Parent = row,
			})

			local bindBtn = Create("TextButton", {
				Size = UDim2.new(0, 74, 0, 20),
				Position = UDim2.new(1, -82, 0.5, -10),
				BackgroundColor3 = ThemeRegistry.Section,
				BorderSizePixel = 0,
				Text = FormatKey(currentKey),
				TextColor3 = ThemeRegistry.Accent,
				TextSize = 10,
				Font = Enum.Font.GothamBold,
				AutoButtonColor = false,
				Parent = row,
			})
			Round(bindBtn, 5)

			local controller = {}
			function controller:Get()
				return currentKey
			end

			function controller:Set(newKey, skipCallback)
				currentKey = newKey
				listening = false
				bindBtn.Text = FormatKey(currentKey)
				bindBtn.BackgroundColor3 = ThemeRegistry.Section
				if not skipCallback and type(callback) == "function" then
					task.spawn(callback, currentKey)
				end
			end

			maid:GiveTask(bindBtn.MouseButton1Click:Connect(function()
				listening = true
				bindBtn.Text = "..."
				bindBtn.BackgroundColor3 = ThemeRegistry.AccentDark
			end))

			maid:GiveTask(UserInputService.InputBegan:Connect(function(input, gameProcessed)
				if listening then
					if input.UserInputType == Enum.UserInputType.Keyboard then
						if input.KeyCode == Enum.KeyCode.Escape then
							listening = false
							bindBtn.Text = FormatKey(currentKey)
							bindBtn.BackgroundColor3 = ThemeRegistry.Section
						else
							controller:Set(input.KeyCode, false)
						end
					elseif input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.MouseButton2 then
						controller:Set(input.UserInputType, false)
					end
					return
				end

				if not gameProcessed and typeof(currentKey) == "EnumItem" then
					local matched = (input.KeyCode == currentKey and currentKey ~= Enum.KeyCode.Unknown)
						or (input.UserInputType == currentKey)
					if matched and type(callback) == "function" then
						task.spawn(callback, currentKey)
					end
				end
			end))

			maid:GiveTask(ThemeRegistry.ThemeChanged:Connect(function(newAcc)
				if not listening then
					bindBtn.TextColor3 = newAcc
				end
			end))

			RegisterFlag(flag, controller)
			return controller
		end

		-- 7. CreateColorPicker
		function sectionApi:CreateColorPicker(opts)
			opts = opts or {}
			local name = tostring(opts.Name or "Color")
			local currentColor = (typeof(opts.Default) == "Color3") and opts.Default or Color3.fromRGB(0, 168, 255)
			local callback = opts.Callback
			local flag = opts.Flag

			local h0, s0, v0 = currentColor:ToHSV()
			local hue = h0
			local sat = s0
			local val = v0
			local isOpen = false

			local container = Create("Frame", {
				Size = UDim2.new(1, 0, 0, 30),
				BackgroundColor3 = ThemeRegistry.Row,
				BackgroundTransparency = 0.15,
				BorderSizePixel = 0,
				ClipsDescendants = true,
				LayoutOrder = NextOrder(),
				Parent = sectionListFrame,
			})
			Round(container, 6)

			Create("TextLabel", {
				Size = UDim2.new(1, -54, 0, 30),
				Position = UDim2.new(0, 9, 0, 0),
				BackgroundTransparency = 1,
				Text = name,
				TextColor3 = ThemeRegistry.Text,
				TextSize = 11,
				Font = Enum.Font.GothamMedium,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd,
				Parent = container,
			})

			local previewBtn = Create("TextButton", {
				Size = UDim2.new(0, 28, 0, 18),
				Position = UDim2.new(1, -36, 0, 6),
				BackgroundColor3 = currentColor,
				BorderSizePixel = 0,
				Text = "",
				AutoButtonColor = false,
				Parent = container,
			})
			Round(previewBtn, 5)
			Create("UIStroke", {
				Color = Color3.fromRGB(255, 255, 255),
				Thickness = 1,
				Transparency = 0.5,
				Parent = previewBtn,
			})

			local pickerBody = Create("Frame", {
				Size = UDim2.new(1, -14, 0, 74),
				Position = UDim2.new(0, 7, 0, 34),
				BackgroundTransparency = 1,
				Parent = container,
			})

			-- SV квадрат
			local svPad = Create("Frame", {
				Size = UDim2.new(1, -24, 0, 46),
				Position = UDim2.new(0, 0, 0, 0),
				BackgroundColor3 = Color3.fromHSV(hue, 1, 1),
				BorderSizePixel = 0,
				Parent = pickerBody,
			})
			Round(svPad, 5)

			Create("UIGradient", {
				Color = ColorSequence.new({
					ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
					ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 255, 255)),
				}),
				Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 0),
					NumberSequenceKeypoint.new(1, 1),
				}),
				Parent = svPad,
			})

			local valOverlay = Create("Frame", {
				Size = UDim2.new(1, 0, 1, 0),
				BackgroundColor3 = Color3.fromRGB(0, 0, 0),
				BorderSizePixel = 0,
				Parent = svPad,
			})
			Round(valOverlay, 5)
			Create("UIGradient", {
				Color = ColorSequence.new({
					ColorSequenceKeypoint.new(0, Color3.fromRGB(0, 0, 0)),
					ColorSequenceKeypoint.new(1, Color3.fromRGB(0, 0, 0)),
				}),
				Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 1),
					NumberSequenceKeypoint.new(1, 0),
				}),
				Rotation = 90,
				Parent = valOverlay,
			})

			local svDot = Create("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Size = UDim2.new(0, 10, 0, 10),
				Position = UDim2.new(sat, 0, 1 - val, 0),
				BackgroundColor3 = Color3.fromRGB(255, 255, 255),
				BorderSizePixel = 0,
				ZIndex = 4,
				Parent = svPad,
			})
			Round(svDot, 5)
			Create("UIStroke", { Color = Color3.fromRGB(0, 0, 0), Thickness = 1.2, Parent = svDot })

			-- Вертикальная полоса Hue
			local hueBar = Create("Frame", {
				Size = UDim2.new(0, 14, 0, 46),
				Position = UDim2.new(1, -14, 0, 0),
				BackgroundColor3 = Color3.fromRGB(255, 255, 255),
				BorderSizePixel = 0,
				Parent = pickerBody,
			})
			Round(hueBar, 4)
			Create("UIGradient", {
				Color = ColorSequence.new({
					ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 0)),
					ColorSequenceKeypoint.new(0.17, Color3.fromRGB(255, 255, 0)),
					ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0, 255, 0)),
					ColorSequenceKeypoint.new(0.5, Color3.fromRGB(0, 255, 255)),
					ColorSequenceKeypoint.new(0.67, Color3.fromRGB(0, 0, 255)),
					ColorSequenceKeypoint.new(0.83, Color3.fromRGB(255, 0, 255)),
					ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 0, 0)),
				}),
				Rotation = 90,
				Parent = hueBar,
			})

			-- Быстрые пресеты снизу
			local presetRow = Create("Frame", {
				Size = UDim2.new(1, 0, 0, 18),
				Position = UDim2.new(0, 0, 0, 52),
				BackgroundTransparency = 1,
				Parent = pickerBody,
			})
			Create("UIListLayout", {
				FillDirection = Enum.FillDirection.Horizontal,
				HorizontalAlignment = Enum.HorizontalAlignment.Between,
				Parent = presetRow,
			})

			local controller = {}
			function controller:Get()
				return currentColor
			end

			function controller:Set(newCol, skipCallback)
				if typeof(newCol) ~= "Color3" then
					return
				end
				currentColor = newCol
				local nh, ns, nv = newCol:ToHSV()
				hue, sat, val = nh, ns, nv
				previewBtn.BackgroundColor3 = currentColor
				svPad.BackgroundColor3 = Color3.fromHSV(hue, 1, 1)
				svDot.Position = UDim2.new(sat, 0, 1 - val, 0)
				if not skipCallback and type(callback) == "function" then
					task.spawn(callback, currentColor)
				end
			end

			for _, pCol in ipairs(PRESET_ACCENTS) do
				local pBtn = Create("TextButton", {
					Size = UDim2.new(0, 24, 0, 16),
					BackgroundColor3 = pCol,
					BorderSizePixel = 0,
					Text = "",
					AutoButtonColor = false,
					Parent = presetRow,
				})
				Round(pBtn, 4)
				maid:GiveTask(pBtn.MouseButton1Click:Connect(function()
					controller:Set(pCol, false)
				end))
			end

			local dragMode = nil
			local activePointer = nil

			local function ApplyPointerColor(pos)
				if dragMode == "SV" then
					local sx = math.clamp((pos.X - svPad.AbsolutePosition.X) / math.max(svPad.AbsoluteSize.X, 1), 0, 1)
					local sy = math.clamp((pos.Y - svPad.AbsolutePosition.Y) / math.max(svPad.AbsoluteSize.Y, 1), 0, 1)
					sat = sx
					val = 1 - sy
					controller:Set(Color3.fromHSV(hue, sat, val), false)
				elseif dragMode == "H" then
					local hy = math.clamp((pos.Y - hueBar.AbsolutePosition.Y) / math.max(hueBar.AbsoluteSize.Y, 1), 0, 1)
					hue = hy
					controller:Set(Color3.fromHSV(hue, sat, val), false)
				end
			end

			maid:GiveTask(svPad.InputBegan:Connect(function(input)
				if IsPointerDown(input) then
					dragMode = "SV"
					activePointer = input
					ApplyPointerColor(input.Position)
				end
			end))

			maid:GiveTask(hueBar.InputBegan:Connect(function(input)
				if IsPointerDown(input) then
					dragMode = "H"
					activePointer = input
					ApplyPointerColor(input.Position)
				end
			end))

			maid:GiveTask(UserInputService.InputChanged:Connect(function(input)
				if dragMode and input == activePointer and IsPointerMove(input) then
					ApplyPointerColor(input.Position)
				end
			end))

			maid:GiveTask(UserInputService.InputEnded:Connect(function(input)
				if input == activePointer then
					dragMode = nil
					activePointer = nil
				end
			end))

			maid:GiveTask(previewBtn.MouseButton1Click:Connect(function()
				isOpen = not isOpen
				TweenService:Create(container, TweenInfo.new(0.22, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
					Size = UDim2.new(1, 0, 0, isOpen and 116 or 30),
				}):Play()
			end))

			RegisterFlag(flag, controller)
			return controller
		end

		-- 8. CreateParagraph
		function sectionApi:CreateParagraph(opts)
			opts = opts or {}
			local pTitle = tostring(opts.Title or "Info")
			local pContent = tostring(opts.Content or "")

			local card = Create("Frame", {
				Size = UDim2.new(1, 0, 0, 40),
				AutomaticSize = Enum.AutomaticSize.Y,
				BackgroundColor3 = ThemeRegistry.Row,
				BackgroundTransparency = 0.2,
				BorderSizePixel = 0,
				LayoutOrder = NextOrder(),
				Parent = sectionListFrame,
			})
			Round(card, 6)

			Create("UIListLayout", {
				FillDirection = Enum.FillDirection.Vertical,
				SortOrder = Enum.SortOrder.LayoutOrder,
				Padding = UDim.new(0, 3),
				Parent = card,
			})

			Create("UIPadding", {
				PaddingTop = UDim.new(0, 7),
				PaddingBottom = UDim.new(0, 7),
				PaddingLeft = UDim.new(0, 9),
				PaddingRight = UDim.new(0, 9),
				Parent = card,
			})

			Create("TextLabel", {
				Size = UDim2.new(1, 0, 0, 14),
				BackgroundTransparency = 1,
				Text = pTitle,
				TextColor3 = ThemeRegistry.Text,
				TextSize = 11,
				Font = Enum.Font.GothamBold,
				TextXAlignment = Enum.TextXAlignment.Left,
				LayoutOrder = 1,
				Parent = card,
			})

			local bodyLbl = Create("TextLabel", {
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				BackgroundTransparency = 1,
				Text = pContent,
				TextColor3 = ThemeRegistry.Muted,
				TextSize = 10,
				Font = Enum.Font.Gotham,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextWrapped = true,
				LayoutOrder = 2,
				Parent = card,
			})

			local controller = {}
			function controller:Get()
				return pContent
			end
			function controller:Set(newText)
				pContent = tostring(newText or "")
				bodyLbl.Text = pContent
			end

			return controller
		end

		return sectionApi
	end

	-- Создание вкладок и двухколоночных секций
	local tabs = {}
	local currentTab = nil

	local function SelectTab(tabEntry)
		if currentTab == tabEntry then
			return
		end
		currentTab = tabEntry
		activeTabTitleLbl.Text = string.upper(tabEntry.Name)

		for _, item in ipairs(tabs) do
			local active = (item == tabEntry)
			TweenService:Create(item.Btn, TweenInfo.new(0.18, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
				BackgroundColor3 = active and ThemeRegistry.Row or ThemeRegistry.Sidebar,
				BackgroundTransparency = active and 0.15 or 0.85,
				TextColor3 = active and ThemeRegistry.Text or ThemeRegistry.Muted,
			}):Play()

			item.Page.Visible = active
			if active then
				item.Page.Position = UDim2.new(0, 10, 0, 0)
				TweenService:Create(item.Page, TweenInfo.new(0.22, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
					Position = UDim2.new(0, 0, 0, 0),
				}):Play()

				local targetY = item.Btn.Position.Y.Offset + math.floor((item.Btn.Size.Y.Offset - activeIndicator.Size.Y.Offset) * 0.5)
				TweenService:Create(activeIndicator, TweenInfo.new(0.24, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
					Position = UDim2.new(0, 0, 0, targetY),
				}):Play()
			end
		end
	end

	local windowApi = {
		_maid = maid,
		_gui = gui,
	}

	function windowApi:Destroy()
		maid:Destroy()
	end

	function windowApi:CreateTab(tabName, iconGlyph)
		local nameStr = tostring(tabName or "Tab")
		local glyph = tostring(iconGlyph or "▸")
		local ord = NextOrder()

		local tabBtn = Create("TextButton", {
			Name = "TabBtn_" .. nameStr,
			Size = UDim2.new(1, 0, 0, 30),
			BackgroundColor3 = ThemeRegistry.Sidebar,
			BackgroundTransparency = 0.85,
			BorderSizePixel = 0,
			Text = glyph .. "  " .. nameStr,
			TextColor3 = ThemeRegistry.Muted,
			TextSize = 11,
			Font = Enum.Font.GothamBold,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			AutoButtonColor = false,
			LayoutOrder = ord,
			Parent = tabContainer,
		})
		Round(tabBtn, 6)
		Create("UIPadding", {
			PaddingLeft = UDim.new(0, 10),
			PaddingRight = UDim.new(0, 6),
			Parent = tabBtn,
		})

		local pageScroll = Create("ScrollingFrame", {
			Name = "Page_" .. nameStr,
			Size = UDim2.new(1, 0, 1, 0),
			Position = UDim2.new(0, 0, 0, 0),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ScrollBarThickness = 3,
			ScrollBarImageColor3 = ThemeRegistry.Accent,
			CanvasSize = UDim2.new(0, 0, 0, 0),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			Visible = false,
			Parent = pagesHost,
		})

		local leftCol = Create("Frame", {
			Name = "LeftColumn",
			Size = UDim2.new(0.5, -10, 0, 0),
			Position = UDim2.new(0, 7, 0, 7),
			BackgroundTransparency = 1,
			AutomaticSize = Enum.AutomaticSize.Y,
			Parent = pageScroll,
		})
		Create("UIListLayout", {
			FillDirection = Enum.FillDirection.Vertical,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 8),
			Parent = leftCol,
		})
		Create("UIPadding", {
			PaddingBottom = UDim.new(0, 10),
			Parent = leftCol,
		})

		local rightCol = Create("Frame", {
			Name = "RightColumn",
			Size = UDim2.new(0.5, -10, 0, 0),
			Position = UDim2.new(0.5, 3, 0, 7),
			BackgroundTransparency = 1,
			AutomaticSize = Enum.AutomaticSize.Y,
			Parent = pageScroll,
		})
		Create("UIListLayout", {
			FillDirection = Enum.FillDirection.Vertical,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 8),
			Parent = rightCol,
		})
		Create("UIPadding", {
			PaddingBottom = UDim.new(0, 10),
			Parent = rightCol,
		})

		local entry = {
			Name = nameStr,
			Btn = tabBtn,
			Page = pageScroll,
		}
		table.insert(tabs, entry)

		maid:GiveTask(tabBtn.MouseButton1Click:Connect(function()
			SelectTab(entry)
		end))

		maid:GiveTask(ThemeRegistry.ThemeChanged:Connect(function(newAcc)
			pageScroll.ScrollBarImageColor3 = newAcc
		end))

		if #tabs == 1 then
			task.defer(function()
				SelectTab(entry)
			end)
		end

		local tabApi = {}
		function tabApi:CreateSection(secTitle, side)
			local sideNorm = string.lower(tostring(side or "left"))
			local parentCol = (sideNorm == "right") and rightCol or leftCol

			local secFrame = Create("Frame", {
				Name = "Section_" .. tostring(secTitle or "Sec"),
				Size = UDim2.new(1, 0, 0, 28),
				AutomaticSize = Enum.AutomaticSize.Y,
				BackgroundColor3 = ThemeRegistry.Section,
				BackgroundTransparency = 0.18,
				BorderSizePixel = 0,
				LayoutOrder = NextOrder(),
				Parent = parentCol,
			})
			Round(secFrame, 7)

			Create("UIStroke", {
				Color = ThemeRegistry.Stroke,
				Thickness = 1,
				Parent = secFrame,
			})

			Create("TextLabel", {
				Size = UDim2.new(1, -14, 0, 18),
				Position = UDim2.new(0, 8, 0, 4),
				BackgroundTransparency = 1,
				Text = string.upper(tostring(secTitle or "SECTION")),
				TextColor3 = ThemeRegistry.Muted,
				TextSize = 10,
				Font = Enum.Font.GothamBold,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd,
				Parent = secFrame,
			})

			local secDivider = Create("Frame", {
				Size = UDim2.new(1, -16, 0, 1),
				Position = UDim2.new(0, 8, 0, 23),
				BackgroundColor3 = ThemeRegistry.Stroke,
				BackgroundTransparency = 0.4,
				BorderSizePixel = 0,
				Parent = secFrame,
			})

			local itemsList = Create("Frame", {
				Size = UDim2.new(1, -12, 0, 0),
				Position = UDim2.new(0, 6, 0, 28),
				BackgroundTransparency = 1,
				AutomaticSize = Enum.AutomaticSize.Y,
				Parent = secFrame,
			})

			Create("UIListLayout", {
				FillDirection = Enum.FillDirection.Vertical,
				SortOrder = Enum.SortOrder.LayoutOrder,
				Padding = UDim.new(0, 5),
				Parent = itemsList,
			})

			Create("UIPadding", {
				PaddingBottom = UDim.new(0, 8),
				Parent = itemsList,
			})

			maid:GiveTask(ThemeRegistry.ThemeChanged:Connect(function(newAcc)
				secDivider.BackgroundColor3 = newAcc
				secDivider.BackgroundTransparency = 0.72
			end))

			return BuildSectionControls(itemsList)
		end

		return tabApi
	end

	-- ========================================================================
	-- МОДУЛЬ 5 (ЧАСТЬ Б): ВСТРОЕННАЯ ВКЛАДКА "SYSTEM & LOGS"
	-- ========================================================================

	local sysTab = windowApi:CreateTab("System & Logs", "⌘")
	local termSec = sysTab:CreateSection("CONSOLE TERMINAL", "left")
	local actionsSec = sysTab:CreateSection("LOG CONTROLS", "right")

	local termCard = Create("Frame", {
		Size = UDim2.new(1, 0, 0, 210),
		BackgroundColor3 = ThemeRegistry.Background,
		BackgroundTransparency = 0.1,
		BorderSizePixel = 0,
		LayoutOrder = NextOrder(),
		Parent = termSec._listFrame or termSec,
	})
	-- Прикрепляем терминал напрямую через параграф-контейнер секции
	termCard:Destroy()

	local logScroller = Create("ScrollingFrame", {
		Name = "LogTerminalScroller",
		Size = UDim2.new(1, 0, 0, 185),
		BackgroundColor3 = ThemeRegistry.Background,
		BackgroundTransparency = 0.12,
		BorderSizePixel = 0,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = ThemeRegistry.Accent,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		LayoutOrder = NextOrder(),
	})

	-- Находим последний список секции termSec и монтируем logScroller туда
	for _, obj in ipairs(pagesHost:GetDescendants()) do
		if obj:IsA("TextLabel") and obj.Text == "CONSOLE TERMINAL" and obj.Parent then
			for _, child in ipairs(obj.Parent:GetChildren()) do
				if child:IsA("Frame") and child.Position.Y.Offset > 20 then
					logScroller.Parent = child
					break
				end
			end
		end
	end

	Round(logScroller, 6)
	Create("UIStroke", { Color = ThemeRegistry.Stroke, Thickness = 1, Parent = logScroller })
	local logListLayout = Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Vertical,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 2),
		Parent = logScroller,
	})
	Create("UIPadding", {
		PaddingTop = UDim.new(0, 6),
		PaddingBottom = UDim.new(0, 6),
		PaddingLeft = UDim.new(0, 6),
		PaddingRight = UDim.new(0, 6),
		Parent = logScroller,
	})

	local function GetLevelColor(lvl)
		if lvl == "SUCCESS" then
			return ThemeRegistry.Success
		elseif lvl == "WARN" then
			return ThemeRegistry.Warn
		elseif lvl == "ERROR" then
			return ThemeRegistry.Error
		end
		return ThemeRegistry.Info
	end

	local logRowCounter = 0
	local function AppendLogLabel(entry)
		if not logScroller or not logScroller.Parent then
			return
		end
		logRowCounter += 1
		Create("TextLabel", {
			Size = UDim2.new(1, -6, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			Text = entry.Formatted,
			TextColor3 = GetLevelColor(entry.Level),
			TextSize = 10,
			Font = Enum.Font.Code,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextWrapped = true,
			LayoutOrder = logRowCounter,
			Parent = logScroller,
		})
		task.defer(function()
			if logScroller and logScroller.Parent then
				local maxY = math.max(0, logScroller.AbsoluteCanvasSize.Y - logScroller.AbsoluteSize.Y)
				logScroller.CanvasPosition = Vector2.new(0, maxY)
			end
		end)
	end

	local function RebuildLogTerminal()
		if not logScroller or not logScroller.Parent then
			return
		end
		for _, child in ipairs(logScroller:GetChildren()) do
			if child:IsA("TextLabel") then
				child:Destroy()
			end
		end
		for _, entry in ipairs(Library._logEntries) do
			AppendLogLabel(entry)
		end
	end

	RebuildLogTerminal()

	maid:GiveTask(Library._logSignal:Connect(function(entry)
		if entry and entry.Clear then
			RebuildLogTerminal()
		elseif entry then
			AppendLogLabel(entry)
		end
	end))

	actionsSec:CreateButton({
		Name = "Copy All Logs",
		Callback = function()
			local allText = Library:GetLogsText()
			if type(setclipboard) == "function" then
				pcall(setclipboard, allText)
				Library:Notify({ Title = "Logs Copied", Text = "Все логи скопированы в буфер обмена.", Type = "SUCCESS" })
			else
				Library:Notify({ Title = "Clipboard N/A", Text = "setclipboard недоступен в этом экзекьюторе.", Type = "WARN" })
			end
		end,
	})

	actionsSec:CreateButton({
		Name = "Clear Console",
		Callback = function()
			Library:ClearLogs()
			Library:Notify({ Title = "Console Cleared", Text = "Журнал логов очищен.", Type = "INFO" })
		end,
	})

	actionsSec:CreateParagraph({
		Title = "Telemetry & Runtime",
		Content = "Экзекьютор: " .. DetectExecutorName() .. "\nПлейс ID: " .. tostring(game.PlaceId),
	})

	return windowApi
end

-- ============================================================================
-- МОДУЛЬ 7: ПОЛНЫЙ ДЕМОНСТРАЦИОННЫЙ СТЕНД В КОНЦЕ СКРИПТА
-- ============================================================================

local authPassed = Library:RunKeyGate({
	Enabled = true,
	Title = "NEVERLOSE // AUTH",
	Subtitle = "Введите ключ доступа (тестовый: NL-MASTER-2026)",
	FallbackKey = "NL-MASTER-2026",
	KeyURL = "", -- При необходимости укажите RAW URL списка ключей
	GetKeyLink = "https://neverlose.cc/get-key",
	WebhookURL = "", -- При необходимости укажите Discord Webhook URL
})

if not authPassed then
	return
end

local MainWindow = Library:CreateWindow({
	Title = "NEVERLOSE",
	Subtitle = "v3.4 • Dark Deep-Navy",
})

local CombatTab = MainWindow:CreateTab("Combat", "⚔")
local VisualsTab = MainWindow:CreateTab("Visuals", "◈")
local MiscTab = MainWindow:CreateTab("Misc", "❖")
local SettingsTab = MainWindow:CreateTab("Settings", "⚙")

-- 1. COMBAT (Левая и правая секции)
local AimLeft = CombatTab:CreateSection("AIMBOT", "left")
local AimRight = CombatTab:CreateSection("TRIGGER & FOV", "right")

AimLeft:CreateToggle({
	Name = "Enable Aimbot",
	Default = false,
	Flag = "Combat_Aimbot",
	Callback = function(state)
		Library:Log("Aimbot переключён: " .. tostring(state), "INFO")
	end,
})

AimLeft:CreateSlider({
	Name = "Smoothness",
	Min = 1,
	Max = 100,
	Default = 25,
	Increment = 1,
	Suffix = "%",
	Flag = "Combat_Smooth",
	Callback = function(val)
		Library:Log("Smoothness установлен на " .. tostring(val) .. "%", "INFO")
	end,
})

AimLeft:CreateDropdown({
	Name = "Hitboxes",
	Options = { "Head", "Chest", "Pelvis", "Legs" },
	Default = { "Head", "Chest" },
	Multi = true,
	Flag = "Combat_Hitboxes",
	Callback = function(selected)
		Library:Log("Выбранные хитбоксы: " .. table.concat(selected, ", "), "INFO")
	end,
})

AimLeft:CreateKeybind({
	Name = "Aim Key",
	Default = Enum.KeyCode.E,
	Flag = "Combat_AimKey",
