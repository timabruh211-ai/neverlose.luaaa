local function findTab(id) for _,tb in ipairs(SCHEMA) do if tb.id==id then return tb end end return SCHEMA[1] end

function renderProfile()
	profile.Visible=state.showProfile
	profileName.Text=state.name
	local initials=""
	for word in tostring(state.name):gmatch("%S+") do
		initials..=word:match("^[%z\1-\127\194-\244][\128-\191]*") or word:sub(1,1)
		if utf8len(initials)>=2 then break end
	end
	avatarText.Text=initials~="" and initials or "U"
	local map={online="ok",away="warn",dnd="err",invisible="dim"}
	local labels={online=L("В сети","Online"),away=L("Отошёл","Away"),dnd=L("Не беспокоить","Do not disturb"),invisible=L("Невидимка","Invisible")}
	statusDot.BackgroundColor3=modeColor(map[state.status] or "ok")
	statusText.Text=lab(labels[state.status] or labels.online)
end
function renderSidebar()
	clearGui(nav)
	local compact=state.compact and W>=760
	logoText.Visible=not compact; logoChip.Visible=not compact
	profileName.Visible=not compact; statusDot.Visible=not compact; statusText.Visible=not compact
	local order=0
	for _,g in ipairs({{"main","groupMain"},{"system","groupSystem"}}) do
		local items={}
		for _,tb in ipairs(SCHEMA) do if tb.group==g[1] then table.insert(items,tb) end end
		if #items>0 then
			order+=1
			if compact then local ln=new("Frame",{Size=UDim2.new(1,0,0,1),BorderSizePixel=0,LayoutOrder=order},nav); tint(ln,"BackgroundColor3","line")
			else local gt=new("TextLabel",{Size=UDim2.new(1,0,0,22),BackgroundTransparency=1,Text=t(g[2]),TextSize=9.5,Font=Enum.Font.GothamBold,TextXAlignment=Enum.TextXAlignment.Left,LayoutOrder=order},nav); tint(gt,"TextColor3","dim") end
			for _,tb in ipairs(items) do
				order+=1
				local active=tb.id==activeTab
				local b=new("TextButton",{Size=UDim2.new(1,0,0,38),Text="",AutoButtonColor=false,LayoutOrder=order,BackgroundTransparency=active and 0 or 1},nav); corner(b,6)
				if active then b.BackgroundColor3=modeColor("softSide") end
				table.insert(tints,{o=b,p="BackgroundColor3",m="softSide"})
				local ih=icon(tb.icon,b,16,active and "accent2" or "muted"); ih.Position=UDim2.fromOffset(compact and 12 or 10,11)
				if not compact then
					local tl=new("TextLabel",{Position=UDim2.fromOffset(38,0),Size=UDim2.new(1,-46,1,0),BackgroundTransparency=1,Text=lab(tb.label),TextSize=13,Font=Enum.Font.GothamMedium,TextXAlignment=Enum.TextXAlignment.Left,TextTruncate=Enum.TextTruncate.AtEnd},b)
					tint(tl,"TextColor3",active and "white" or "muted")
				end
				if active then local ind=new("Frame",{Size=UDim2.new(0,3,.6,0),Position=UDim2.new(0,-10,.2,0),BorderSizePixel=0},b); tint(ind,"BackgroundColor3","accent") end
				b.MouseEnter:Connect(function() if not active then b.BackgroundColor3=mix(pal().label,pal().side,.94); tw(b,{BackgroundTransparency=0}) end end)
				b.MouseLeave:Connect(function() if not active then tw(b,{BackgroundTransparency=1}) end end)
				b.Activated:Connect(function() activeTab=tb.id; activeSub=tb.subs[1].id; drawerOpen=false; playSound("click"); renderAll(); layout() end)
			end
		end
	end
end
function renderHeader()
	local tb=findTab(activeTab)
	crumb.Text=lab(tb.label)
	clearGui(crumbIco)
	icon(tb.icon,crumbIco,15,"accent2")
	clearGui(subtabs)
	local i=0
	for _,s in ipairs(tb.subs) do
		i+=1
		local active=s.id==activeSub
		local w=utf8len(lab(s.label))*7+20
		local b=new("TextButton",{Size=UDim2.fromOffset(w,26),Text=lab(s.label),TextSize=11.5,Font=Enum.Font.GothamBold,AutoButtonColor=false,LayoutOrder=i,BackgroundTransparency=active and 0 or 1},subtabs); corner(b,6)
		if active then b.BackgroundColor3=accent(); table.insert(tints,{o=b,p="BackgroundColor3",m="accent"}); tint(new("UIGradient",{Rotation=20},b),"Color","gradAccent") end
		tint(b,"TextColor3",active and "white" or "muted")
		b.MouseEnter:Connect(function() if not active then b.BackgroundColor3=mix(pal().label,pal().side,.92); tw(b,{BackgroundTransparency=0}) end end)
		b.MouseLeave:Connect(function() if not active then tw(b,{BackgroundTransparency=1}) end end)
		b.Activated:Connect(function() activeSub=s.id; playSound("click"); renderHeader(); renderContent() end)
	end
	saveLabel.Text=t("save"); pillLabel.Text=t("openMenu"); dirtyDot.Visible=dirty
end
function renderContent()
	closePop()
	clearGui(col1); clearGui(col2)
	local tb=findTab(activeTab)
	local cards=tb.cards[activeSub] or {}
	for i,card in ipairs(cards) do
		local parent=singleCol and col1 or (i%2==1 and col1 or col2)
		local g=makeGroup({Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,BackgroundTransparency=1,GroupTransparency=state.animations and 1 or 0,LayoutOrder=i},parent)
		local c=new("Frame",{Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,BorderSizePixel=0},g)
		regRadius(corner(c,state.radius)); tint(c,"BackgroundColor3","card"); tint(stroke(c),"Color","line"); pad(c,12,12,12,12); list(c,nil,4)
		local head=new("Frame",{Size=UDim2.new(1,0,0,28),BackgroundTransparency=1,LayoutOrder=0},c)
		local ib=new("Frame",{Size=UDim2.fromOffset(27,27),BorderSizePixel=0},head); corner(ib,7); tint(ib,"BackgroundColor3","soft"); tint(stroke(ib),"Color","line")
		local hh=icon(card.icon,ib,14,"accent2"); hh.AnchorPoint=Vector2.new(.5,.5); hh.Position=UDim2.fromScale(.5,.5)
		local tl=new("TextLabel",{Position=UDim2.fromOffset(35,0),Size=UDim2.new(1,-105,1,0),BackgroundTransparency=1,Text=lab(card.title),TextSize=13,Font=Enum.Font.GothamBold,TextXAlignment=Enum.TextXAlignment.Left,TextTruncate=Enum.TextTruncate.AtEnd},head); tint(tl,"TextColor3","white")
		local cn=new("TextLabel",{AnchorPoint=Vector2.new(1,.5),Position=UDim2.new(1,0,.5,0),Size=UDim2.fromOffset(70,20),BackgroundTransparency=1,Text=#card.rows.." "..t("params"),TextSize=10,Font=Enum.Font.GothamMedium,TextXAlignment=Enum.TextXAlignment.Right},head); tint(cn,"TextColor3","dim")
		for _,row in ipairs(card.rows) do buildRow(c,row,false) end
		local order=0
		for _,ch in ipairs(c:GetChildren()) do if ch:IsA("GuiObject") then order+=1; ch.LayoutOrder=order end end
		if state.animations then task.delay(i*.055,function() if g.Parent then fadeGroup(g,0,.3) end end) end
	end
	paint()
end
function renderAll() renderSidebar(); renderHeader(); renderContent(); renderProfile(); paint() end

function updateShellDecor()
	local d=state.shadowDepth/100
	for _,s in ipairs(shadow) do s.f.BackgroundTransparency=1-(1-s.base)*d; s.f.Visible=d>.02 end
	borderGlowFrame.Visible=state.borderGlow
	borderGlowFrame:FindFirstChildOfClass("UIStroke").Transparency=state.glow and .35 or .75
	shell.BackgroundTransparency=state.frosted and .1 or 0
	scrim.Visible=state.frosted
	tw(scrim,{BackgroundTransparency=state.frosted and .72 or 1},.3)
	topLine.BackgroundTransparency=state.glow and 0 or .6
end
function updateSoundIcon()
	clearGui(soundIco)
	local h=icon(state.sound and "sound" or "mute",soundIco,15,state.sound and "accent2" or "dim")
	h.AnchorPoint=Vector2.new(.5,.5); h.Position=UDim2.fromScale(.5,.5)
end
function applyLive(id)
	if id=="accent" or id=="theme" or id=="glow" or id=="borderGlow" then paint(); updateShellDecor(); renderProfile()
	elseif id=="radius" then applyRadius()
	elseif id=="density" or id=="language" then renderAll(); updateSoundIcon()
	elseif id=="compact" then renderSidebar(); layout()
	elseif id=="uiScale" then layout()
	elseif id=="shadowDepth" or id=="frosted" then updateShellDecor()
	elseif id=="showProfile" or id=="name" or id=="status" then renderProfile()
	elseif id=="notifPos" then updateToastPos()
	elseif id=="sound" then updateSoundIcon()
	elseif id=="aurora" or id=="grid" or id=="particles" or id=="particleCount" or id=="particleGlow" or id=="quality" or id=="driftSpeed" or id=="reduceMotion" or id=="fpsCap" or id=="pauseUnfocused" then sceneParams() end
end

function layout()
	local v=camera and camera.ViewportSize or Vector2.new(1280,720)
	local availW,availH=v.X-16,v.Y-16
	SCALE=math.clamp(state.uiScale/100,.8,1.25)
	W=math.floor(math.min(BASE_W,availW/SCALE))
	H=math.floor(isMin and HEADER_H or math.min(BASE_H,availH/SCALE))
	local mobile=W<760
	local sideW=mobile and 200 or (state.compact and 64 or 200)
	shell.Size=UDim2.fromOffset(W,H); shellScale.Scale=SCALE
	window.Size=UDim2.fromOffset(W*SCALE,H*SCALE)
	for _,s in ipairs(shadow) do s.f.Size=UDim2.fromOffset(W*SCALE+s.grow,H*SCALE+s.grow) end
	borderGlowFrame.Size=UDim2.fromOffset(W*SCALE+6,H*SCALE+6)
	local sw,sh=W*SCALE,H*SCALE
	local ox=math.clamp(state.posX,8-v.X/2+sw/2,v.X/2-8-sw/2)
	local oy=math.clamp(state.posY,8-v.Y/2+sh/2+18,v.Y/2-8-sh/2+18)
	state.posX,state.posY=ox,oy
	window.Position=UDim2.new(.5,ox,.5,oy)
	sidebar.Size=UDim2.fromOffset(sideW,H)
	sidebar.Position=UDim2.fromOffset(mobile and (drawerOpen and 0 or -sideW-12) or 0,0)
	drawerScrim.Visible=mobile and drawerOpen and not isMin
	mainFrame.Position=UDim2.fromOffset(mobile and 0 or sideW,0)
	mainFrame.Size=UDim2.new(1,-(mobile and 0 or sideW),1,0)
	hamburger.Visible=mobile and not isMin
	crumb.Visible=not mobile and not isMin; crumbIco.Visible=not mobile and not isMin
	subtabs.Visible=not isMin; content.Visible=not isMin
	local mainW=W-(mobile and 0 or sideW)
	local items={{o=dirtyDot,w=8},{o=soundBtn,w=30}}
	if not mobile then table.insert(items,{o=randBtn,w=30}); table.insert(items,{o=exportBtn,w=30}); randBtn.Visible=true; exportBtn.Visible=true else randBtn.Visible=false; exportBtn.Visible=false end
	table.insert(items,{o=saveBtn,w=mobile and 74 or 92}); table.insert(items,{o=minBtn,w=30}); table.insert(items,{o=closeBtn,w=30})
	local x=0
	for _,e in ipairs(items) do
		e.o.Position=UDim2.fromOffset(x,e.o==dirtyDot and 12 or 0)
		if e.o~=dirtyDot then e.o.Size=UDim2.fromOffset(e.w,32) end
		x+=e.w+6
	end
	actions.Size=UDim2.fromOffset(math.max(1,x-6),32)
	saveIco.Visible=not mobile
	saveLabel.Position=UDim2.fromOffset(mobile and 10 or 30,0)
	saveLabel.Size=UDim2.new(1,mobile and -16 or -36,1,0)
	local subX=mobile and 48 or 176
	subtabs.Position=UDim2.fromOffset(subX,12)
	subtabs.Size=UDim2.fromOffset(math.max(60,mainW-subX-(x-6)-22),32)
	local newSingle=W<700
	if newSingle~=singleCol then singleCol=newSingle; renderContent() end
	col1.Size=singleCol and UDim2.new(1,0,0,0) or UDim2.new(.5,-7,0,0)
	col2.Visible=not singleCol
	sceneParams()
end
local function setMin(v)
	isMin=v; clearGui(minBtn)
	local h=icon(v and "plus" or "minus",minBtn,15,"label"); h.AnchorPoint=Vector2.new(.5,.5); h.Position=UDim2.fromScale(.5,.5)
	layout()
end
local function setHidden(v)
	isHidden=v
	if v then
		tw(shell,{BackgroundTransparency=1},.18)
		task.delay(.2,function() if isHidden then window.Visible=false end end)
		restorePill.Visible=true; restorePill.Position=UDim2.new(.5,0,1,10)
		tw(restorePill,{Position=UDim2.new(.5,0,1,-26)},.35)
	else
		window.Visible=true; updateShellDecor()
		tw(restorePill,{Position=UDim2.new(.5,0,1,10)},.25)
		task.delay(.26,function() if not isHidden then restorePill.Visible=false end end)
		layout()
	end
end

hamburger.Activated:Connect(function() drawerOpen=not drawerOpen; playSound("click"); layout() end)
drawerScrim.Activated:Connect(function() drawerOpen=false; layout() end)
soundBtn.Activated:Connect(function() setState("sound",not state.sound); playSound("click") end)
randBtn.Activated:Connect(function() playSound("click"); actRandom() end)
exportBtn.Activated:Connect(function() playSound("click"); actExport() end)
saveBtn.Activated:Connect(function() persist(false) end)
minBtn.Activated:Connect(function() playSound("click"); setMin(not isMin) end)
closeBtn.Activated:Connect(function() playSound("click"); if state.closeAction=="minimize" then setMin(true) else setHidden(true) end end)
restorePill.Activated:Connect(function() playSound("click"); setHidden(false) end)

local dragging,dragStart,dragOrigin=false,nil,nil
header.InputBegan:Connect(function(i)
	if i.UserInputType~=Enum.UserInputType.MouseButton1 and i.UserInputType~=Enum.UserInputType.Touch then return end
	if not state.drag or isMin then return end
	local objs=(playerGui.GetGuiObjectsAtPosition and playerGui:GetGuiObjectsAtPosition(i.Position.X,i.Position.Y)) or {}
	for _,o in ipairs(objs) do if o:IsA("TextButton") or o:IsA("TextBox") or o:IsA("ScrollingFrame") then return end end
	dragging=true; dragStart=i.Position; dragOrigin=Vector2.new(state.posX,state.posY)
end)
UserInputService.InputChanged:Connect(function(i)
	if dragging and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then
		state.posX=dragOrigin.X+(i.Position.X-dragStart.X)
		state.posY=dragOrigin.Y+(i.Position.Y-dragStart.Y)
		layout()
	end
end)
UserInputService.InputEnded:Connect(function(i)
	if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
		if dragging and state.rememberPos then markDirty() end
		dragging=false
	end
end)
UserInputService.InputBegan:Connect(function(i,processed)
	if i.KeyCode==Enum.KeyCode.Escape then closePop(); closeModal(); return end
	if processed then return end
	if UserInputService:GetFocusedTextBox() then return end
	if i.KeyCode==Enum.KeyCode.M and state.hotkeys then setHidden(not isHidden)
	elseif i.KeyCode==Enum.KeyCode.S and (UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)) and state.hotkeys then persist(false) end
end)
local function bindCamera()
	camera=workspace.CurrentCamera
	if camera then camera:GetPropertyChangedSignal("ViewportSize"):Connect(function() layout(); renderHeader() end) end
end
workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function() task.wait(); bindCamera(); layout() end)
task.spawn(function()
	while gui.Parent do
		task.wait(.5)
		for i=#liveInfo,1,-1 do local e=liveInfo[i]; if e.o.Parent==nil then table.remove(liveInfo,i) else e.o.Text=e.f() end end
	end
end)

