local openBtn = new("CanvasGroup", {Parent = gui, Size = UDim2.fromOffset(52, 52), Position = UDim2.new(0, 16, 0, 96), BackgroundColor3 = C.side, BackgroundTransparency = 0.15, BorderSizePixel = 0, Visible = false, GroupTransparency = 1, Active = true})
corner(openBtn, 26)
regAccent(stroke(openBtn, ACCENT, 0.4, 1.5), "Color")
gloss(openBtn)
openScale = new("UIScale", {Parent = openBtn, Scale = 1})
