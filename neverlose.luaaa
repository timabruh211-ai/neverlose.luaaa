for i,cfg in ipairs({{w=.62,x=-.16,y=-.24},{w=.48,x=.68,y=.04},{w=.52,x=.22,y=.62}}) do
	local root=new("Frame",{AnchorPoint=Vector2.new(.5,.5),Size=UDim2.fromScale(cfg.w,cfg.w),BackgroundTransparency=1},auroraLayer)
	for ring=1,4 do
		local f=new("Frame",{AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromScale(.5,.5),Size=UDim2.fromScale(1-ring*.17,1-ring*.17),BackgroundTransparency=1-ring*.16,BorderSizePixel=0},root)
		pill(f); tint(f,"BackgroundColor3",i==2 and "violet" or (i==3 and "info" or "accent"))
		tint(new("UIGradient",{Rotation=i*40},f),"Color","gradAurora")
	end
	table.insert(blobs,{root=root,cfg=cfg,phase=i*2.1})
end
for _,cfg in ipairs({{p=UDim2.new(0,0,0,0),s=UDim2.new(1,0,0,140),r=90},{p=UDim2.new(0,0,1,-140),s=UDim2.new(1,0,0,140),r=-90},{p=UDim2.new(0,0,0,0),s=UDim2.new(0,150,1,0),r=0},{p=UDim2.new(1,-150,0,0),s=UDim2.new(0,150,1,0),r=180}}) do
	local f=new("Frame",{Position=cfg.p,Size=cfg.s,BackgroundColor3=Color3.new(0,0,0),BorderSizePixel=0},scene)
	new("UIGradient",{Rotation=cfg.r,Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,.35),NumberSequenceKeypoint.new(1,1)})},f)
end
local SCENE={pool={},live=0,fps=60,frameMs=16.7,focused=true,last=0,t=0,benchUntil=0,benchFrames=0,benchCb=nil,gridW=0,gridH=0}
local QUALITY={low=.4,medium=.7,high=1,ultra=1.35}
local function buildGrid(w,h)
	if SCENE.gridW==w and SCENE.gridH==h then return end
	SCENE.gridW,SCENE.gridH=w,h; clearGui(gridLayer)
	for x=44,w-1,44 do local l=new("Frame",{Position=UDim2.fromOffset(x,0),Size=UDim2.new(0,1,1,0),BackgroundTransparency=.94,BorderSizePixel=0},gridLayer); tint(l,"BackgroundColor3","accent") end
	for y=44,h-1,44 do local l=new("Frame",{Position=UDim2.fromOffset(0,y),Size=UDim2.new(1,0,0,1),BackgroundTransparency=.94,BorderSizePixel=0},gridLayer); tint(l,"BackgroundColor3","accent") end
end
local function makeParticle()
	local f=new("Frame",{Size=UDim2.fromOffset(3,3),BackgroundTransparency=.4,BorderSizePixel=0,Visible=false},partLayer)
	pill(f); tint(f,"BackgroundColor3","accent")
	local g=new("Frame",{AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromScale(.5,.5),Size=UDim2.fromOffset(12,12),BackgroundTransparency=.88,BorderSizePixel=0},f)
	pill(g); tint(g,"BackgroundColor3","accent")
	return {f=f,glow=g,x=0,y=0,r=1,a=.4,vx=0,vy=0,tw=0,ts=1}
end
local function sceneParams()
	local v=camera and camera.ViewportSize or Vector2.new(1280,720)
	local cap=(v.X<760) and 55 or 160
	local target=state.particles and math.clamp(math.floor(state.particleCount*(QUALITY[state.quality] or 1)),0,cap) or 0
	while #SCENE.pool<target do
		local p=makeParticle(); p.x,p.y=math.random()*v.X,math.random()*v.Y
		p.r=.9+math.random()*1.9; p.a=.2+math.random()*.45
		p.vx,p.vy=(math.random()-.5)*.16,.08+math.random()*.32
		p.tw,p.ts=math.random()*6.28,.5+math.random()*1.6
		table.insert(SCENE.pool,p)
	end
	for i,p in ipairs(SCENE.pool) do
		local on=i<=target; p.f.Visible=on
		if on then p.f.Size=UDim2.fromOffset(p.r*2,p.r*2); p.glow.Visible=state.particleGlow and p.r>1.9 end
	end
	SCENE.live=target; auroraLayer.Visible=state.aurora; gridLayer.Visible=state.grid; buildGrid(v.X,v.Y)
end
RunService.RenderStepped:Connect(function(ts)
	local dt=ts-SCENE.last
	if dt<1/math.clamp(state.fpsCap,10,144) then return end
	SCENE.last=ts
	if state.pauseUnfocused and not SCENE.focused then return end
	SCENE.frameMs=SCENE.frameMs*.9+dt*1000*.1
	SCENE.fps=SCENE.fps*.9+(1/math.max(dt,.0001))*.1
	if SCENE.benchUntil>0 then
		SCENE.benchFrames+=1
		if ts>=SCENE.benchUntil then
			local cb,frames=SCENE.benchCb,SCENE.benchFrames
			SCENE.benchUntil,SCENE.benchFrames,SCENE.benchCb=0,0,nil
			if cb then cb(math.floor(frames/2)) end
		end
	end
	local v=camera and camera.ViewportSize or Vector2.new(1280,720)
	local sp=state.reduceMotion and 0 or state.driftSpeed/100
	SCENE.t+=dt*sp
	if state.aurora then
		for _,b in ipairs(blobs) do
			local c=b.cfg
			b.root.Position=UDim2.fromScale(c.x+c.w/2+math.sin(SCENE.t*.13+b.phase)*.05,c.y+c.w/2+math.cos(SCENE.t*.11+b.phase)*.05)
		end
	end
	for i=1,SCENE.live do
		local p=SCENE.pool[i]
		p.x+=p.vx*sp*dt*3.6; p.y-=p.vy*sp*dt*3.6; p.tw+=p.ts*dt
		if p.y<-8 then p.y=v.Y+8; p.x=math.random()*v.X end
		if p.x<-8 then p.x=v.X+8 elseif p.x>v.X+8 then p.x=-8 end
		p.f.Position=UDim2.fromOffset(p.x,p.y)
		p.f.BackgroundTransparency=1-p.a*(.62+.38*math.sin(p.tw))
	end
end)
if UserInputService.WindowFocused then UserInputService.WindowFocused:Connect(function() SCENE.focused=true end) end
if UserInputService.WindowFocusReleased then UserInputService.WindowFocusReleased:Connect(function() SCENE.focused=false end) end

