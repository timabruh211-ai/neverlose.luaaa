local function updateToastPos()
	local p=state.notifPos
	if p=="br" then toastBox.AnchorPoint=Vector2.new(1,1); toastBox.Position=UDim2.new(1,-18,1,-18)
	elseif p=="bl" then toastBox.AnchorPoint=Vector2.new(0,1); toastBox.Position=UDim2.new(0,18,1,-18)
	elseif p=="tr" then toastBox.AnchorPoint=Vector2.new(1,0); toastBox.Position=UDim2.new(1,-18,0,18)
	else toastBox.AnchorPoint=Vector2.new(0.5,0); toastBox.Position=UDim2.new(0.5,0,0,18) end
end
function toast(kind,title,msg)
	if not state.notifEnabled then return end
	local count=0
	for _,c in ipairs(toastBox:GetChildren()) do if c:IsA("GuiObject") then count=count+1 end end
	while count>=state.notifMax do
		local first
		for _,c in ipairs(toastBox:GetChildren()) do if c:IsA("GuiObject") then first=c break end end
		if first then first:Destroy(); count=count-1 else break end
	end
	local mode=kind=="success" and "ok" or kind=="warning" and "warn" or kind=="error" and "err" or "accent"
	local g=new("Frame",{Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,BorderSizePixel=0},toastBox)
	corner(g,8)
	tint(g,"BackgroundColor3","card")
	tint(stroke(g),"Color","line")
	pad(g,12,12,12,12)
	local bar=new("Frame",{Size=UDim2.fromOffset(4,40),BorderSizePixel=0},g)
	corner(bar,2)
	tint(bar,"BackgroundColor3",mode)
	local tl=new("TextLabel",{Position=UDim2.fromOffset(14,0),Size=UDim2.new(1,-14,0,16),BackgroundTransparency=1,Text=title,TextSize=12,Font=Enum.Font.GothamBold,TextXAlignment=Enum.TextXAlignment.Left,TextTruncate=Enum.TextTruncate.AtEnd},g)
	tint(tl,"TextColor3","white")
	local ml=new("TextLabel",{Position=UDim2.fromOffset(14,18),Size=UDim2.new(1,-14,0,0),AutomaticSize=Enum.AutomaticSize.Y,BackgroundTransparency=1,Text=msg,TextSize=11,Font=Enum.Font.Gotham,TextXAlignment=Enum.TextXAlignment.Left,TextWrapped=true},g)
	tint(ml,"TextColor3","muted")
	g.BackgroundTransparency=1
	tw(g,{BackgroundTransparency=0},0.25)
	delay(state.notifDuration,function()
		if g.Parent then
			tw(g,{BackgroundTransparency=1},0.22)
			delay(0.25,function() if g.Parent then g:Destroy() end end)
		end
	end)
end

function closePop()
	if popNode then popNode:Destroy(); popNode=nil end
	if popScrim then popScrim:Destroy(); popScrim=nil end
end
function openPop(anchor,width,build)
	closePop()
	popScrim=new("TextButton",{Size=UDim2.fromScale(1,1),BackgroundTransparency=1,Text="",AutoButtonColor=false},popLayer)
	popScrim.Activated:Connect(closePop)
	popNode=new("Frame",{Size=UDim2.fromOffset(width,0),AutomaticSize=Enum.AutomaticSize.Y,BorderSizePixel=0},popLayer)
	corner(popNode,8)
	tint(popNode,"BackgroundColor3","card")
	tint(stroke(popNode),"Color","line")
	pad(popNode,8,8,8,8)
	vlist(popNode,4)
	build(popNode)
	local i=0
	for _,c in ipairs(popNode:GetChildren()) do if c:IsA("GuiObject") then i=i+1; c.LayoutOrder=i end end
	delay(0,function()
		if not popNode then return end
		local v=cam and cam.ViewportSize or Vector2.new(1280,720)
		local ap,as,ps=anchor.AbsolutePosition,anchor.AbsoluteSize,popNode.AbsoluteSize
		local x=clamp(ap.X+as.X-ps.X,8,math.max(8,v.X-ps.X-8))
		local y=ap.Y+as.Y+6
		if y+ps.Y>v.Y-8 then y=math.max(8,ap.Y-ps.Y-6) end
		popNode.Position=UDim2.fromOffset(x,y)
	end)
end
function closeModal() if modalNode then modalNode:Destroy(); modalNode=nil end end
function openModal(title,body,extra)
	closeModal()
	closePop()
	modalNode=new("Frame",{Size=UDim2.fromScale(1,1),BackgroundColor3=Color3.new(0,0,0),BackgroundTransparency=0.55,BorderSizePixel=0},popLayer)
	local mb=new("TextButton",{Size=UDim2.fromScale(1,1),BackgroundTransparency=1,Text="",AutoButtonColor=false},modalNode)
	mb.Activated:Connect(closeModal)
	local m=new("Frame",{AnchorPoint=Vector2.new(0.5,0.5),Position=UDim2.fromScale(0.5,0.5),Size=UDim2.fromOffset(math.min(480,(cam and cam.ViewportSize.X or 1280)-32),0),AutomaticSize=Enum.AutomaticSize.Y,BorderSizePixel=0},modalNode)
	corner(m,10)
	tint(m,"BackgroundColor3","card")
	tint(stroke(m),"Color","line")
	pad(m,18,18,18,18)
	vlist(m,10)
	local ht=new("TextLabel",{Size=UDim2.new(1,0,0,22),BackgroundTransparency=1,Text=title,TextSize=15,Font=Enum.Font.GothamBold,TextXAlignment=Enum.TextXAlignment.Left,LayoutOrder=1},m)
	tint(ht,"TextColor3","white")
	local order=1
	for _,text in ipairs(body) do
		order=order+1
		local p=new("TextLabel",{Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,BackgroundTransparency=1,Text=text,TextSize=12,Font=Enum.Font.Gotham,TextXAlignment=Enum.TextXAlignment.Left,TextWrapped=true,LayoutOrder=order},m)
		tint(p,"TextColor3","muted")
	end
	if extra then extra(m,function() order=order+1; return order end) end
	order=order+1
	local okb=new("TextButton",{Size=UDim2.new(1,0,0,34),Text="OK",TextSize=12,Font=Enum.Font.GothamBold,AutoButtonColor=false,LayoutOrder=order},m)
	corner(okb,7)
	tint(okb,"BackgroundColor3","accent")
	tint(okb,"TextColor3","white")
	okb.Activated:Connect(closeModal)
end

local function markDirty()
	dirty=true
	dirtyDot.Visible=true
	if state.autoSave then
		autoToken=autoToken+1
		local my=autoToken
		delay(0.8,function() if dirty and my==autoToken then persist(true) end end)
	end
end
function persist(silent)
	local ok,enc=pcall(function() return Http:JSONEncode(state) end)
	if ok then gui:SetAttribute("Config",enc) end
	dirty=false
	dirtyDot.Visible=false
	if remote then pcall(function() remote:FireServer(enc) end) end
	if not silent then
		saveBtn.Text="Готово"
		delay(1.2,function() if saveBtn.Parent then saveBtn.Text="Save" end end)
		toast("success","Конфигурация сохранена","Параметры записаны в атрибут ScreenGui этой сессии.")
	end
end
function setState(id,v)
	if state[id]==v then return end
	state[id]=v
	markDirty()
	applyLive(id)
end

local function rowBase(parent,h) return new("Frame",{Size=UDim2.new(1,0,0,h or rowH()),BackgroundTransparency=1},parent) end
local function rowLabel(parent,text,off)
	local l=new("TextLabel",{Size=UDim2.new(1,off or -112,1,0),Position=UDim2.fromOffset(2,0),BackgroundTransparency=1,Text=text,TextSize=12,Font=Enum.Font.Gotham,TextXAlignment=Enum.TextXAlignment.Left,TextTruncate=Enum.TextTruncate.AtEnd},parent)
	tint(l,"TextColor3","label")
	return l
end
local function gearButton(parent,row,right)
	local g=new("TextButton",{AnchorPoint=Vector2.new(1,0.5),Position=UDim2.new(1,right,0.5,0),Size=UDim2.fromOffset(24,24),BackgroundTransparency=1,Text="⚙",TextSize=14,Font=Enum.Font.GothamBold,AutoButtonColor=false},parent)
	tint(g,"TextColor3","dim")
	g.Activated:Connect(function()
		openPop(g,250,function(p)
			local h=new("TextLabel",{Size=UDim2.new(1,0,0,20),BackgroundTransparency=1,Text=row.label,TextSize=10,Font=Enum.Font.GothamBold,TextXAlignment=Enum.TextXAlignment.Left},p)
			tint(h,"TextColor3","accent2")
			for _,gr in ipairs(row.gear) do buildRow(p,gr,true) end
		end)
	end)
end
local function toggleRow(parent,row)
	local r=rowBase(parent)
	rowLabel(r,row.label,row.gear and -152 or -112)
	if row.gear then gearButton(r,row,-52) end
	local sw=new("TextButton",{AnchorPoint=Vector2.new(1,0.5),Position=UDim2.new(1,-6,0.5,0),Size=UDim2.fromOffset(42,23),Text="",AutoButtonColor=false},r)
	pill(sw)
	tint(stroke(sw),"Color","line")
	local knob=new("Frame",{Size=UDim2.fromOffset(17,17),Position=UDim2.fromOffset(2,3),BackgroundColor3=Color3.new(1,1,1),BorderSizePixel=0},sw)
	pill(knob)
	local function paintSw()
		local on=state[row.id]
		sw.BackgroundColor3=on and accent() or modeColor("off")
		tw(knob,{Position=UDim2.fromOffset(on and 23 or 2,3)})
	end
	paintSw()
	table.insert(tints,{o=sw,p="BackgroundColor3",m="off",dyn=function() return state[row.id] and accent() or modeColor("off") end})
	sw.Activated:Connect(function()
		setState(row.id,not state[row.id])
		paintSw()
	end)
end
local function comboRow(parent,row,compact)
	local r=rowBase(parent)
	local w=compact and 118 or 152
	rowLabel(r,row.label,-(w+16))
	local b=new("TextButton",{AnchorPoint=Vector2.new(1,0.5),Position=UDim2.new(1,-6,0.5,0),Size=UDim2.fromOffset(w,31),Text="",AutoButtonColor=false},r)
	corner(b,6)
	tint(b,"BackgroundColor3","input")
	tint(stroke(b),"Color","line")
	local v=new("TextLabel",{Size=UDim2.new(1,-26,1,0),Position=UDim2.fromOffset(9,0),BackgroundTransparency=1,TextSize=11,Font=Enum.Font.Gotham,TextXAlignment=Enum.TextXAlignment.Left,TextTruncate=Enum.TextTruncate.AtEnd},b)
	tint(v,"TextColor3","label")
	local ch=new("TextLabel",{AnchorPoint=Vector2.new(1,0.5),Position=UDim2.new(1,-8,0.5,0),Size=UDim2.fromOffset(14,14),BackgroundTransparency=1,Text="▾",TextSize=12,Font=Enum.Font.GothamBold},b)
	tint(ch,"TextColor3","dim")
	local function cur()
		for _,o in ipairs(row.options) do if o.value==state[row.id] then return o.label end end
		return tostring(state[row.id])
	end
	v.Text=cur()
	b.Activated:Connect(function()
		openPop(b,math.max(w,178),function(p)
			for _,o in ipairs(row.options) do
				local it=new("TextButton",{Size=UDim2.new(1,0,0,31),BackgroundTransparency=1,Text="",AutoButtonColor=false},p)
				corner(it,6)
				local sel=o.value==state[row.id]
				local il=new("TextLabel",{Size=UDim2.new(1,-26,1,0),Position=UDim2.fromOffset(9,0),BackgroundTransparency=1,Text=o.label,TextSize=11,Font=Enum.Font.Gotham,TextXAlignment=Enum.TextXAlignment.Left},it)
				tint(il,"TextColor3",sel and "accent2" or "label")
				if sel then
					local ci=new("TextLabel",{AnchorPoint=Vector2.new(1,0.5),Position=UDim2.new(1,-8,0.5,0),Size=UDim2.fromOffset(14,14),BackgroundTransparency=1,Text="✓",TextSize=12,Font=Enum.Font.GothamBold},it)
					tint(ci,"TextColor3","accent2")
				end
				it.MouseEnter:Connect(function() it.BackgroundColor3=accent(); tw(it,{BackgroundTransparency=0.9}) end)
				it.MouseLeave:Connect(function() tw(it,{BackgroundTransparency=1}) end)
				it.Activated:Connect(function()
					setState(row.id,o.value)
					v.Text=cur()
					closePop()
				end)
			end
		end)
	end)
end
local function segmentsRow(parent,row)
	local r=rowBase(parent,rowH()+28)
	rowLabel(r,row.label,-10)
	local wrap=new("Frame",{Position=UDim2.fromOffset(2,26),Size=UDim2.new(1,-4,0,30),BackgroundTransparency=1},r)
	hlist(wrap,6)
	local n=#row.options
	for i,o in ipairs(row.options) do
		local b=new("TextButton",{Size=UDim2.new(1/n,-4,1,0),Text="",AutoButtonColor=false,LayoutOrder=i},wrap)
		corner(b,6)
		tint(stroke(b),"Color","line")
		local tl=new("TextLabel",{Size=UDim2.fromScale(1,1),BackgroundTransparency=1,Text=o.label,TextSize=11,Font=Enum.Font.GothamBold},b)
		local mode=o.value
		table.insert(tints,{o=b,p="BackgroundColor3",m="input",dyn=function() return state[row.id]==mode and accent() or modeColor("input") end})
		table.insert(tints,{o=tl,p="TextColor3",m="muted",dyn=function() return state[row.id]==mode and Color3.new(1,1,1) or modeColor("muted") end})
		b.Activated:Connect(function() setState(row.id,mode) end)
	end
end
function sliderControl(parent,cfg)
	local holder=new("Frame",{Size=UDim2.new(1,0,0,42),BackgroundTransparency=1},parent)
	local top=new("Frame",{Size=UDim2.new(1,0,0,18),BackgroundTransparency=1},holder)
	if cfg.label then
		local l=new("TextLabel",{Size=UDim2.new(1,-70,1,0),Position=UDim2.fromOffset(2,0),BackgroundTransparency=1,Text=cfg.label,TextSize=12,Font=Enum.Font.Gotham,TextXAlignment=Enum.TextXAlignment.Left,TextTruncate=Enum.TextTruncate.AtEnd},top)
		tint(l,"TextColor3","label")
	end
	local chip=new("TextLabel",{AnchorPoint=Vector2.new(1,0),Position=UDim2.new(1,-2,0,0),Size=UDim2.fromOffset(64,18),BackgroundTransparency=1,TextSize=11,Font=Enum.Font.GothamBold,TextXAlignment=Enum.TextXAlignment.Right},top)
	tint(chip,"TextColor3","accent2")
	local track=new("TextButton",{Position=UDim2.fromOffset(2,26),Size=UDim2.new(1,-4,0,6),Text="",AutoButtonColor=false},holder)
	corner(track,3)
	tint(track,"BackgroundColor3","track")
	local fill=new("Frame",{Size=UDim2.fromScale(0,1),BorderSizePixel=0},track)
	corner(fill,3)
	tint(fill,"BackgroundColor3","accent")
	local knob=new("Frame",{AnchorPoint=Vector2.new(0.5,0.5),Position=UDim2.fromScale(0,0.5),Size=UDim2.fromOffset(15,15),BackgroundColor3=Color3.new(1,1,1),BorderSizePixel=0,ZIndex=2},track)
	pill(knob)
	tint(stroke(knob,3),"Color","accent")
	local step=cfg.step or 1
	local function fmt(v)
		if step<1 then return string.format("%.1f",v)..(cfg.unit or "") end
		return tostring(math.floor(v+0.5))..(cfg.unit or "")
	end
	local function paintSlider()
		local val=cfg.get()
		local ratio=clamp((val-cfg.min)/(cfg.max-cfg.min),0,1)
		fill.Size=UDim2.fromScale(ratio,1)
		knob.Position=UDim2.fromScale(ratio,0.5)
		chip.Text=fmt(val)
	end
	paintSlider()
	local function fromX(x)
		local ratio=clamp((x-track.AbsolutePosition.X)/math.max(1,track.AbsoluteSize.X),0,1)
		local val=clamp(math.floor((cfg.min+ratio*(cfg.max-cfg.min))/step+0.5)*step,cfg.min,cfg.max)
		cfg.set(val)
		paintSlider()
	end
	track.InputBegan:Connect(function(i)
		if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
			activeSlider={track=track,fromX=fromX}
			fromX(i.Position.X)
		end
	end)
	return holder
end
UIS.InputChanged:Connect(function(i)
	if activeSlider and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then
		activeSlider.fromX(i.Position.X)
	end
end)
UIS.InputEnded:Connect(function(i)
	if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
		activeSlider=nil
	end
end)
local function sliderRow(parent,row)
	sliderControl(parent,{label=row.label,min=row.min,max=row.max,step=row.step,unit=row.unit,get=function() return state[row.id] end,set=function(v) setState(row.id,v) end})
end
local function textRow(parent,row)
	local r=rowBase(parent)
	rowLabel(r,row.label,-168)
	local box=new("TextBox",{AnchorPoint=Vector2.new(1,0.5),Position=UDim2.new(1,-6,0.5,0),Size=UDim2.fromOffset(152,31),Text=state[row.id],TextSize=11,Font=Enum.Font.Gotham,ClearTextOnFocus=false,PlaceholderText="…"},r)
	corner(box,6)
	tint(box,"BackgroundColor3","input")
	tint(box,"TextColor3","white")
	tint(stroke(box),"Color","line")
	box.FocusLost:Connect(function()
		setState(row.id,box.Text~="" and box.Text or "User")
		box.Text=state[row.id]
	end)
end
local function openColorPicker(anchor)
	openPop(anchor,250,function(p)
		local head=new("TextLabel",{Size=UDim2.new(1,0,0,18),BackgroundTransparency=1,Text="Свой цвет",TextSize=10,Font=Enum.Font.GothamBold,TextXAlignment=Enum.TextXAlignment.Left},p)
		tint(head,"TextColor3","accent2")
		local preview=new("Frame",{Size=UDim2.new(1,0,0,36),BorderSizePixel=0},p)
		corner(preview,7)
		tint(stroke(preview),"Color","line")
		local hexl=new("TextLabel",{Size=UDim2.fromScale(1,1),BackgroundTransparency=1,Text=state.accent,TextSize=13,Font=Enum.Font.Code},preview)
		tint(hexl,"TextColor3","white")
		local function refresh() preview.BackgroundColor3=accent(); hexl.Text=state.accent end
		refresh()
		for _,ch in ipairs({"R","G","B"}) do
			sliderControl(p,{label=ch,min=0,max=255,step=1,unit="",
				get=function()
					local c=accent()
					if ch=="R" then return math.floor(c.R*255+0.5) elseif ch=="G" then return math.floor(c.G*255+0.5) else return math.floor(c.B*255+0.5) end
				end,
				set=function(v)
					local c=accent()
					local r=ch=="R" and v/255 or c.R
					local g=ch=="G" and v/255 or c.G
					local b=ch=="B" and v/255 or c.B
					setState("accent",hexStr(Color3.new(r,g,b)))
					refresh()
				end})
		end
		local done=new("TextButton",{Size=UDim2.new(1,0,0,32),Text="Готово",TextSize=12,Font=Enum.Font.GothamBold,AutoButtonColor=false},p)
		corner(done,7)
		tint(done,"BackgroundColor3","accent")
		tint(done,"TextColor3","white")
		done.Activated:Connect(closePop)
	end)
end
local function swatchRow(parent,row)
	local r=rowBase(parent,rowH()+28)
	rowLabel(r,row.label,-10)
	local wrap=new("Frame",{Position=UDim2.fromOffset(2,26),Size=UDim2.new(1,-4,0,26),BackgroundTransparency=1},r)
	hlist(wrap,7)
	local marks={}
	local function mark()
		for hex,b in pairs(marks) do
			local st=b:FindFirstChildOfClass("UIStroke")
			if st then st.Thickness=(string.lower(hex)==string.lower(state.accent)) and 2 or 0 end
		end
	end
	for _,hex in ipairs(PRESETS) do
		local b=new("TextButton",{Size=UDim2.fromOffset(26,26),BackgroundColor3=hexColor(hex),Text="",AutoButtonColor=false},wrap)
		pill(b)
		local st=stroke(b,0)
		st.Color=Color3.new(1,1,1)
		marks[hex]=b
		b.Activated:Connect(function() setState("accent",hex); mark() end)
	end
	local well=new("TextButton",{Size=UDim2.fromOffset(26,26),BackgroundTransparency=1,Text="+",TextSize=14,Font=Enum.Font.GothamBold,AutoButtonColor=false},wrap)
	pill(well)
	local ws=stroke(well,1)
	ws.Color=pal().muted
	tint(well,"TextColor3","muted")
	well.Activated:Connect(function() openColorPicker(well) end)
	mark()
end
local function infoRow(parent,row)
	local r=rowBase(parent)
	rowLabel(r,row.label,-150)
	local v=new("TextLabel",{AnchorPoint=Vector2.new(1,0.5),Position=UDim2.new(1,-6,0.5,0),Size=UDim2.fromOffset(146,20),BackgroundTransparency=1,Text=row.value or "",TextSize=11,Font=Enum.Font.GothamBold,TextXAlignment=Enum.TextXAlignment.Right,TextTruncate=Enum.TextTruncate.AtEnd},r)
	tint(v,"TextColor3","accent2")
end
local function buttonRow(parent,row)
	local r=rowBase(parent,38)
	local b=new("TextButton",{Size=UDim2.new(1,0,0,34),Text=row.label,TextSize=12,Font=Enum.Font.GothamBold,AutoButtonColor=false},r)
	corner(b,7)
	if row.style=="primary" then
		tint(b,"BackgroundColor3","accent")
		tint(b,"TextColor3","white")
		tint(new("UIGradient",{Rotation=20},b),"Color","grad")
	elseif row.style=="danger" then
		b.BackgroundColor3=mix(ERR,pal().card,0.82)
		tint(b,"TextColor3","err")
		tint(stroke(b),"Color","line")
	else
		tint(b,"BackgroundColor3","input")
		tint(b,"TextColor3","label")
		tint(stroke(b),"Color","line")
	end
	b.Activated:Connect(function() row.fn(b) end)
end
function buildRow(parent,row,compact)
	local ty=row.type
	if ty=="toggle" then toggleRow(parent,row)
	elseif ty=="combo" then comboRow(parent,row,compact)
	elseif ty=="segments" then segmentsRow(parent,row)
	elseif ty=="slider" then sliderRow(parent,row)
	elseif ty=="text" then textRow(parent,row)
	elseif ty=="swatch" then swatchRow(parent,row)
	elseif ty=="info" then infoRow(parent,row)
	elseif ty=="button" then buttonRow(parent,row)
	end
end

local confirmUntil=0
local function actReset(b)
	if os.clock()<confirmUntil then
		for k,v in pairs(DEFAULTS) do state[k]=v end
		state.name=player.Name
		confirmUntil=0
		renderAll()
		paint()
		applyRadius()
		updateShellDecor()
		updateToastPos()
		updateSizeLabel()
		layout()
		markDirty()
		toast("warning","Настройки сброшены","Восстановлены значения по умолчанию.")
		return
	end
	confirmUntil=os.clock()+2.6
	local oldText=b.Text
	b.Text="Подтвердить сброс?"
	delay(2.6,function() if b.Parent and b.Text=="Подтвердить сброс?" then b.Text=oldText end end)
end
local function actRandom()
	state.accent=PRESETS[math.random(#PRESETS)]
	local th={"midnight","abyss","contrast"}
	state.theme=th[math.random(#th)]
	state.radius=math.random(0,16)
	local d={"compact","normal","roomy"}
	state.density=d[math.random(#d)]
	renderAll()
	paint()
	applyRadius()
	layout()
	markDirty()
	toast("info","Случайный стиль","Акцент, тема, скругление и плотность перемешаны.")
end
local function actExport()
	local enc="{}"
	pcall(function() enc=Http:JSONEncode(state) end)
	openModal("Экспорт конфигурации",{"Выделите текст (Ctrl+A) и скопируйте (Ctrl+C). Если есть RemoteEvent NebulaSave — конфиг уйдёт на сервер."},function(m,nextOrder)
		local box=new("TextBox",{Size=UDim2.new(1,0,0,120),Text=enc,TextSize=11,Font=Enum.Font.Code,TextWrapped=true,MultiLine=true,ClearTextOnFocus=false,TextEditable=true,TextXAlignment=Enum.TextXAlignment.Left,TextYAlignment=Enum.TextYAlignment.Top,LayoutOrder=nextOrder()},m)
		corner(box,7)
		tint(box,"BackgroundColor3","input")
		tint(box,"TextColor3","label")
		tint(stroke(box),"Color","line")
		pad(box,8,8,8,8)
		if remote then
			local sb=new("TextButton",{Size=UDim2.new(1,0,0,34),Text="Отправить на сервер",TextSize=12,Font=Enum.Font.GothamBold,AutoButtonColor=false,LayoutOrder=nextOrder()},m)
			corner(sb,7)
			tint(sb,"BackgroundColor3","input")
			tint(sb,"TextColor3","label")
			tint(stroke(sb),"Color","line")
			sb.Activated:Connect(function()
				pcall(function() remote:FireServer(box.Text) end)
				toast("info","Экспорт","Конфиг отправлен на сервер.")
			end)
		end
	end)
end
local function actImport()
	openModal("Импорт конфигурации",{"Вставьте JSON и нажмите «Применить»."},function(m,nextOrder)
		local box=new("TextBox",{Size=UDim2.new(1,0,0,120),Text="",PlaceholderText='{"accent":"#0095FF", ...}',TextSize=11,Font=Enum.Font.Code,TextWrapped=true,MultiLine=true,ClearTextOnFocus=false,TextXAlignment=Enum.TextXAlignment.Left,TextYAlignment=Enum.TextYAlignment.Top,LayoutOrder=nextOrder()},m)
		corner(box,7)
		tint(box,"BackgroundColor3","input")
		tint(box,"TextColor3","label")
		tint(stroke(box),"Color","line")
		pad(box,8,8,8,8)
		local ab=new("TextButton",{Size=UDim2.new(1,0,0,34),Text="Применить",TextSize=12,Font=Enum.Font.GothamBold,AutoButtonColor=false,LayoutOrder=nextOrder()},m)
		corner(ab,7)
		tint(ab,"BackgroundColor3","accent")
		tint(ab,"TextColor3","white")
		ab.Activated:Connect(function()
			local ok,data=pcall(function() return Http:JSONDecode(box.Text) end)
			local n=0
			if ok and type(data)=="table" then
				for k,v in pairs(DEFAULTS) do
					if data[k]~=nil and type(data[k])==type(v) then state[k]=data[k]; n=n+1 end
				end
			end
			if n>0 then
				renderAll()
				paint()
				applyRadius()
				updateShellDecor()
				updateToastPos()
				updateSizeLabel()
				layout()
				markDirty()
				closeModal()
				toast("success","Конфиг импортирован","Параметры применены из JSON.")
			else
				toast("error","Ошибка импорта","Текст не является корректным конфигом NEBULA.")
			end
		end)
	end)
end
local function actClear()
	gui:SetAttribute("Config",nil)
	toast("warning","Хранилище очищено","Сохранённая конфигурация удалена.")
end
local function actDocs()
	openModal("Документация",{
		"NEBULA v3 — интерфейс настроек. Все тумблеры, списки, ползунки и цвет применяются мгновенно.",
		"Размер панели: кнопки М / С / Б в шапке (на телефоне одна кнопка-переключатель) или строка «Размер панели» в разделе Внешний вид → Окно.",
		"Перетаскивайте окно за верхнюю панель мышью или пальцем. Кнопка «–» сворачивает в полоску — нажать на полоску или «+» развернёт обратно. Крестик скрывает окно — вернуть можно кнопкой «Открыть меню».",
		"Горячие клавиши: M — показать/скрыть · Ctrl+S — сохранить · Esc — закрыть всплывающее окно",
	})
end

local function R(ty,id,label,extra)
	local r={type=ty,id=id,label=label}
	if extra then for k,v in pairs(extra) do r[k]=v end end
	return r
end
local function C(title,rows) return {title=title,rows=rows} end
local SIZE_OPTS={{value="small",label="Маленький"},{value="medium",label="Средний"},{value="large",label="Большой"}}
local SCHEMA={
	{id="appearance",group="Основное",icon="🎨",label="Внешний вид",
		subs={{id="theme",label="Тема"},{id="window",label="Окно"}},
		cards={
			theme={
				C("Акцент",{R("swatch","accent","Акцентный цвет"),R("toggle","glow","Свечение акцента"),R("toggle","borderGlow","Подсветка границ")}),
				C("Оформление",{R("combo","theme","Тема окна",{options={{value="midnight",label="Полуночная"},{value="abyss",label="Глубокая"},{value="contrast",label="Контрастная"}}}),R("slider","radius","Скругление углов",{min=0,max=16,step=1,unit=" px"}),R("combo","density","Плотность строк",{options={{value="compact",label="Компактная"},{value="normal",label="Обычная"},{value="roomy",label="Просторная"}}}),R("toggle","compact","Компактный сайдбар")})
			},
			window={
				C("Размер панели",{R("segments","sizeMode","Пресет размера",{options=SIZE_OPTS}),R("slider","uiScale","Масштаб интерфейса",{min=80,max=125,step=5,unit="%"}),R("info",nil,"Текущий размер",{value=""}),R("button",nil,"Свернуть в полоску",{fn=function() setMin(true) end})}),
				C("Окно",{R("slider","shadowDepth","Глубина тени",{min=0,max=100,step=5,unit="%"}),R("toggle","frosted","Матовое стекло"),R("toggle","animations","Анимации интерфейса")}),
				C("Профиль",{R("text","name","Отображаемое имя"),R("combo","status","Статус",{options={{value="online",label="В сети"},{value="away",label="Отошёл"},{value="dnd",label="Не беспокоить"},{value="invisible",label="Невидимка"}}}),R("toggle","showProfile","Блок профиля")})
			}
		}},
	{id="general",group="Основное",icon="⚙",label="Общие",
		subs={{id="behavior",label="Поведение"},{id="data",label="Данные"}},
		cards={
			behavior={
				C("Управление",{R("toggle","drag","Перетаскивание окна"),R("toggle","hotkeys","Горячие клавиши"),R("combo","closeAction","При закрытии",{options={{value="hide",label="Скрыть окно"},{value="minimize",label="Свернуть"}}}),R("toggle","rememberPos","Запоминать позицию")}),
				C("Запуск",{R("toggle","autoSave","Автосохранение"),R("info",nil,"Совет",{value="M — скрыть окно"})})
			},
			data={
				C("Конфигурация",{R("button",nil,"Экспорт конфига",{style="primary",fn=actExport}),R("button",nil,"Импорт конфига",{fn=actImport}),R("button",nil,"Случайный стиль",{fn=actRandom}),R("button",nil,"Сбросить настройки",{style="danger",fn=actReset})}),
				C("Хранилище",{R("info",nil,"Синхронизация",{value=remote and "RemoteEvent" or "локально"}),R("button",nil,"Очистить данные",{style="danger",fn=actClear})})
			}
		}},
	{id="notifications",group="Система",icon="🔔",label="Уведомления",
		subs={{id="general",label="Общие"}},
		cards={
			general={
				C("Оповещения",{R("toggle","notifEnabled","Уведомления",{gear={R("combo","notifPos","Позиция",{options={{value="br",label="Справа снизу"},{value="bl",label="Слева снизу"},{value="tr",label="Справа сверху"},{value="tc",label="Сверху центр"}}}),R("slider","notifDuration","Длительность",{min=2,max=8,step=1,unit=" с"})}}),R("combo","notifMax","Максимум на экране",{options={{value=1,label="1"},{value=3,label="3"},{value=5,label="5"}}})}),
				C("Проверка",{R("button",nil,"Тест: успех",{fn=function() toast("success","Тестовое уведомление","Так выглядит оповещение этого типа.") end}),R("button",nil,"Тест: инфо",{fn=function() toast("info","Тестовое уведомление","Так выглядит оповещение этого типа.") end}),R("button",nil,"Тест: предупреждение",{fn=function() toast("warning","Тестовое уведомление","Так выглядит оповещение этого типа.") end}),R("button",nil,"Тест: ошибка",{fn=function() toast("error","Тестовое уведомление","Так выглядит оповещение этого типа.") end})})
			}
		}},
	{id="about",group="Система",icon="ℹ",label="О программе",
		subs={{id="info",label="Информация"}},
		cards={
			info={
				C("NEBULA UI",{R("info",nil,"Версия",{value="v3.1 compact"}),R("info",nil,"Движок",{value="Roblox Lua/Luau"}),R("button",nil,"Документация",{style="primary",fn=actDocs})}),
				C("Лицензия",{R("info",nil,"Лицензия",{value="MIT · демо"}),R("info",nil,"Стиль",{value="Тёмный неоновый концепт"})})
			}
		}},
}
local function findTab(id)
	for _,tb in ipairs(SCHEMA) do if tb.id==id then return tb end end
	return SCHEMA[1]
end

function renderProfile()
	profile.Visible=state.showProfile
	profileName.Text=state.name
	avatarText.Text=string.upper(string.sub(player.Name,1,1))
	local map={online=OK,away=WARN,dnd=ERR,invisible=Color3.fromRGB(86,94,115)}
	local labels={online="В сети",away="Отошёл",dnd="Не беспокоить",invisible="Невидимка"}
	statusDot.BackgroundColor3=map[state.status] or OK
	statusText.Text=labels[state.status] or "В сети"
end
function renderSidebar()
	clearGui(nav)
	local compact=state.compact and W>=760
	logoText.Visible=not compact
	logoChip.Visible=not compact
	profileName.Visible=not compact
	statusDot.Visible=not compact
	statusText.Visible=not compact
	local order=0
	local lastGroup=nil
	for _,tb in ipairs(SCHEMA) do
		if tb.group~=lastGroup then
			lastGroup=tb.group
			order=order+1
			if compact then
				local ln=new("Frame",{Size=UDim2.new(1,0,0,1),BorderSizePixel=0,LayoutOrder=order},nav)
				tint(ln,"BackgroundColor3","line")
			else
				local gt=new("TextLabel",{Size=UDim2.new(1,0,0,22),BackgroundTransparency=1,Text=tb.group,TextSize=9,Font=Enum.Font.GothamBold,TextXAlignment=Enum.TextXAlignment.Left,LayoutOrder=order},nav)
				tint(gt,"TextColor3","dim")
			end
		end
		order=order+1
		local active=tb.id==activeTab
		local b=new("TextButton",{Size=UDim2.new(1,0,0,38),Text="",AutoButtonColor=false,LayoutOrder=order,BackgroundTransparency=active and 0 or 1},nav)
		corner(b,6)
		if active then b.BackgroundColor3=modeColor("softSide") end
		table.insert(tints,{o=b,p="BackgroundColor3",m="softSide"})
		local ic=new("TextLabel",{Size=UDim2.fromOffset(24,38),Position=UDim2.fromOffset(compact and 12 or 10,0),BackgroundTransparency=1,Text=tb.icon,TextSize=14,Font=Enum.Font.GothamBold},b)
		tint(ic,"TextColor3",active and "accent2" or "muted")
		if not compact then
			local tl=new("TextLabel",{Position=UDim2.fromOffset(38,0),Size=UDim2.new(1,-46,1,0),BackgroundTransparency=1,Text=tb.label,TextSize=13,Font=Enum.Font.Gotham,TextXAlignment=Enum.TextXAlignment.Left,TextTruncate=Enum.TextTruncate.AtEnd},b)
			tint(tl,"TextColor3",active and "white" or "muted")
		end
		if active then
			local ind=new("Frame",{Size=UDim2.new(0,3,0.6,0),Position=UDim2.new(0,-10,0.2,0),BorderSizePixel=0},b)
			tint(ind,"BackgroundColor3","accent")
		end
		b.MouseEnter:Connect(function() if not active then b.BackgroundColor3=mix(pal().label,pal().side,0.94); tw(b,{BackgroundTransparency=0}) end end)
		b.MouseLeave:Connect(function() if not active then tw(b,{BackgroundTransparency=1}) end end)
		b.Activated:Connect(function()
			activeTab=tb.id
			activeSub=tb.subs[1].id
			drawerOpen=false
			renderAll()
			layout()
		end)
	end
end
function renderHeader()
	local tb=findTab(activeTab)
	crumb.Text=tb.icon.."  "..tb.label
	clearGui(subtabs)
	local i=0
	for _,s in ipairs(tb.subs) do
		i=i+1
		local active=s.id==activeSub
		local w=#s.label*7+20
		local b=new("TextButton",{Size=UDim2.fromOffset(w,26),Text=s.label,TextSize=11,Font=Enum.Font.GothamBold,AutoButtonColor=false,LayoutOrder=i,BackgroundTransparency=active and 0 or 1},subtabs)
		corner(b,6)
		if active then
			b.BackgroundColor3=accent()
			table.insert(tints,{o=b,p="BackgroundColor3",m="accent"})
			tint(new("UIGradient",{Rotation=20},b),"Color","grad")
		end
		tint(b,"TextColor3",active and "white" or "muted")
		b.MouseEnter:Connect(function() if not active then b.BackgroundColor3=mix(pal().label,pal().side,0.92); tw(b,{BackgroundTransparency=0}) end end)
		b.MouseLeave:Connect(function() if not active then tw(b,{BackgroundTransparency=1}) end end)
		b.Activated:Connect(function()
			activeSub=s.id
			renderHeader()
			renderContent()
		end)
	end
	dirtyDot.Visible=dirty
end
function renderContent()
	closePop()
	clearGui(col1)
	clearGui(col2)
	local tb=findTab(activeTab)
	local cards=tb.cards[activeSub] or {}
	for i,card in ipairs(cards) do
		local parent=singleCol and col1 or (i%2==1 and col1 or col2)
		local c=new("Frame",{Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,BorderSizePixel=0,LayoutOrder=i},parent)
		regRadius(corner(c,state.radius))
		tint(c,"BackgroundColor3","card")
		tint(stroke(c),"Color","line")
		pad(c,12,12,12,12)
		vlist(c,4)
		local head=new("Frame",{Size=UDim2.new(1,0,0,28),BackgroundTransparency=1,LayoutOrder=0},c)
		local tl=new("TextLabel",{Size=UDim2.new(1,-70,1,0),BackgroundTransparency=1,Text=card.title,TextSize=13,Font=Enum.Font.GothamBold,TextXAlignment=Enum.TextXAlignment.Left,TextTruncate=Enum.TextTruncate.AtEnd},head)
		tint(tl,"TextColor3","white")
		local cn=new("TextLabel",{AnchorPoint=Vector2.new(1,0.5),Position=UDim2.new(1,0,0.5,0),Size=UDim2.fromOffset(70,20),BackgroundTransparency=1,Text=#card.rows.." парам.",TextSize=10,Font=Enum.Font.Gotham,TextXAlignment=Enum.TextXAlignment.Right},head)
		tint(cn,"TextColor3","dim")
		for _,row in ipairs(card.rows) do
			if row.label=="Текущий размер" then
				local s=SIZES[state.sizeMode] or SIZES.medium
				row.value=s.label.." · "..s.w.."×"..s.h
			end
			buildRow(c,row,false)
		end
		local order=0
		for _,ch in ipairs(c:GetChildren()) do if ch:IsA("GuiObject") then order=order+1; ch.LayoutOrder=order end end
	end
	paint()
end
function renderAll()
	renderSidebar()
	renderHeader()
	renderContent()
	renderProfile()
	paint()
end

function updateShellDecor()
	local d=state.shadowDepth/100
	for _,s in ipairs(shadows) do
		s.f.BackgroundTransparency=1-(1-s.base)*d
		s.f.Visible=d>0.02
	end
	borderGlow.Visible=state.borderGlow and not isMin
	local st=borderGlow:FindFirstChildOfClass("UIStroke")
	if st then st.Transparency=state.glow and 0.35 or 0.75 end
	shell.BackgroundTransparency=state.frosted and 0.1 or 0
	scrim.Visible=state.frosted and not isMin
	tw(scrim,{BackgroundTransparency=(state.frosted and not isMin) and 0.72 or 1},0.3)
	topLine.BackgroundTransparency=state.glow and 0 or 0.6
end
function applyLive(id)
	if id=="accent" or id=="theme" or id=="glow" or id=="borderGlow" then
		paint()
		updateShellDecor()
		renderProfile()
	elseif id=="sizeMode" then
		updateSizeLabel()
		paint()
		if isMin then setMin(false) else layout() end
		if activeTab=="appearance" and activeSub=="window" then renderContent() end
	elseif id=="radius" then
		applyRadius()
	elseif id=="density" then
		renderContent()
	elseif id=="compact" then
		renderSidebar()
		layout()
	elseif id=="uiScale" then
		layout()
	elseif id=="shadowDepth" or id=="frosted" then
		updateShellDecor()
	elseif id=="showProfile" or id=="name" or id=="status" then
		renderProfile()
	elseif id=="notifPos" then
		updateToastPos()
	end
end

function layout()
	local v=cam and cam.ViewportSize or Vector2.new(1280,720)
	local availW=v.X-16
	local availH=v.Y-80
	SCALE=clamp(state.uiScale/100,0.8,1.25)
	local base=SIZES[state.sizeMode] or SIZES.medium
	if isMin then
		W=math.floor(math.min(520,availW/SCALE))
		H=56
	else
		W=math.floor(math.min(base.w,availW/SCALE))
		H=math.floor(math.min(base.h,availH/SCALE))
	end
	local narrow=W<760
	local sideW=narrow and 200 or (state.compact and 64 or 200)
	shell.Size=UDim2.fromOffset(W,H)
	shellScale.Scale=SCALE
	window.Size=UDim2.fromOffset(W*SCALE,H*SCALE)
	for _,s in ipairs(shadows) do s.f.Size=UDim2.fromOffset(W*SCALE+s.grow,H*SCALE+s.grow) end
	borderGlow.Size=UDim2.fromOffset(W*SCALE+6,H*SCALE+6)
	local sw,sh=W*SCALE,H*SCALE
	local ox=clamp(state.posX,8-v.X/2+sw/2,v.X/2-8-sw/2)
	local oy=clamp(state.posY,8-v.Y/2+sh/2,v.Y/2-8-sh/2)
	state.posX,state.posY=ox,oy
	window.Position=UDim2.new(0.5,ox,0.5,oy)

	sidebar.Visible=not isMin
	sidebar.Size=UDim2.fromOffset(sideW,H)
	sidebar.Position=UDim2.fromOffset(narrow and (drawerOpen and 0 or -sideW-12) or 0,0)
	drawerScrim.Visible=narrow and drawerOpen and not isMin
	mainFrame.Position=UDim2.fromOffset((narrow or isMin) and 0 or sideW,0)
	mainFrame.Size=UDim2.new(1,-((narrow or isMin) and 0 or sideW),1,0)
	hamburger.Visible=narrow and not isMin
	expandHit.Visible=isMin
	subtabs.Visible=not isMin
	content.Visible=not isMin

	local items={}
	table.insert(items,{o=dirtyDot,w=8,h=7,y=12})
	if narrow then
		table.insert(items,{o=sizeCycle,w=30,h=32,y=0})
	else
		table.insert(items,{o=sizeSeg,w=86,h=32,y=0})
	end
	table.insert(items,{o=saveBtn,w=narrow and 60 or 86,h=32,y=0})
	table.insert(items,{o=minBtn,w=32,h=32,y=0})
	table.insert(items,{o=closeBtn,w=32,h=32,y=0})
	local x=0
	for _,e in ipairs(items) do
		e.o.Position=UDim2.fromOffset(x,e.y)
		e.o.Size=UDim2.fromOffset(e.w,e.h)
		x=x+e.w+6
	end
	local actionsW=math.max(1,x-6)
	actions.Size=UDim2.fromOffset(actionsW,32)
	sizeSeg.Visible=not narrow
	sizeCycle.Visible=narrow

	local mainW=W-((narrow or isMin) and 0 or sideW)
	if isMin then
		crumb.Visible=false
		expandHit.Size=UDim2.fromOffset(math.max(80,mainW-actionsW-24),34)
	else
		local showCrumb=(not narrow) and W>=880
		crumb.Visible=showCrumb
		local subX=narrow and 48 or (showCrumb and 176 or 16)
		subtabs.Position=UDim2.fromOffset(subX,12)
		subtabs.Size=UDim2.fromOffset(math.max(60,mainW-subX-actionsW-22),32)
	end

	local newSingle=(mainW-32)<620
	if newSingle~=singleCol then
		singleCol=newSingle
		renderContent()
	end
	col1.Size=singleCol and UDim2.new(1,0,0,0) or UDim2.new(0.5,-7,0,0)
	col2.Visible=not singleCol
	updateShellDecor()
end
function setMin(v)
	isMin=v
	minBtn.Text=v and "+" or "–"
	if v then drawerOpen=false end
	layout()
end
function setHidden(v)
	isHidden=v
	if v then
		tw(shell,{BackgroundTransparency=1},0.18)
		delay(0.2,function() if isHidden then window.Visible=false end end)
		restorePill.Visible=true
		restorePill.Position=UDim2.new(0.5,0,1,10)
		tw(restorePill,{Position=UDim2.new(0.5,0,1,-26)},0.35)
	else
		window.Visible=true
		updateShellDecor()
		tw(restorePill,{Position=UDim2.new(0.5,0,1,10)},0.25)
		delay(0.26,function() if not isHidden then restorePill.Visible=false end end)
		layout()
	end
end

hamburger.Activated:Connect(function() drawerOpen=not drawerOpen; layout() end)
drawerScrim.Activated:Connect(function() drawerOpen=false; layout() end)
saveBtn.Activated:Connect(function() persist(false) end)
minBtn.Activated:Connect(function() setMin(not isMin) end)
expandHit.Activated:Connect(function() setMin(false) end)
closeBtn.Activated:Connect(function() if state.closeAction=="minimize" then setMin(true) else setHidden(true) end end)
restorePill.Activated:Connect(function() setHidden(false) end)
for mode,b in pairs(sizeBtns) do
	local m=mode
	b.Activated:Connect(function() setState("sizeMode",m) end)
end
sizeCycle.Activated:Connect(function()
	local idx=1
	for i,m in ipairs(SIZE_ORDER) do if m==state.sizeMode then idx=i end end
	local nxt=SIZE_ORDER[idx+1] or SIZE_ORDER[1]
	setState("sizeMode",nxt)
	toast("info","Размер панели",(SIZES[nxt] or SIZES.medium).label)
end)

local dragging,dragStart,dragOrigin=false,nil,nil
header.InputBegan:Connect(function(i)
	if i.UserInputType~=Enum.UserInputType.MouseButton1 and i.UserInputType~=Enum.UserInputType.Touch then return end
	if not state.drag then return end
	local objs={}
	if pg.GetGuiObjectsAtPosition then objs=pg:GetGuiObjectsAtPosition(i.Position.X,i.Position.Y) end
	for _,o in ipairs(objs) do
		if (o:IsA("TextButton") or o:IsA("TextBox") or o:IsA("ScrollingFrame")) and o.Name~="ExpandHit" then return end
	end
	dragging=true
	dragStart=i.Position
	dragOrigin=Vector2.new(state.posX,state.posY)
end)
UIS.InputChanged:Connect(function(i)
	if dragging and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then
		state.posX=dragOrigin.X+(i.Position.X-dragStart.X)
		state.posY=dragOrigin.Y+(i.Position.Y-dragStart.Y)
		layout()
	end
end)
UIS.InputEnded:Connect(function(i)
	if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
		if dragging and state.rememberPos then markDirty() end
		dragging=false
	end
end)
UIS.InputBegan:Connect(function(i,processed)
	if i.KeyCode==Enum.KeyCode.Escape then closePop(); closeModal(); return end
	if processed then return end
	if UIS:GetFocusedTextBox() then return end
	if i.KeyCode==Enum.KeyCode.M and state.hotkeys then
		setHidden(not isHidden)
	elseif i.KeyCode==Enum.KeyCode.S and (UIS:IsKeyDown(Enum.KeyCode.LeftControl) or UIS:IsKeyDown(Enum.KeyCode.RightControl)) and state.hotkeys then
		persist(false)
	end
end)
local function bindCamera()
	cam=workspace.CurrentCamera
	if cam then
		cam:GetPropertyChangedSignal("ViewportSize"):Connect(function()
			layout()
			renderHeader()
		end)
	end
end
workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
	wait()
	bindCamera()
	layout()
end)

local okLoad,saved=pcall(function() return Http:JSONDecode(gui:GetAttribute("Config") or "null") end)
if okLoad and type(saved)=="table" then
	for k,v in pairs(DEFAULTS) do
		if saved[k]~=nil and type(saved[k])==type(v) then state[k]=saved[k] end
	end
end
if not SIZES[state.sizeMode] then state.sizeMode="medium" end
if not state.rememberPos then state.posX,state.posY=0,0 end
updateToastPos()
updateSizeLabel()
renderAll()
bindCamera()
layout()
paint()
applyRadius()
shellScale.Scale=SCALE*0.93
shell.Position=UDim2.fromOffset(0,16)
tw(shellScale,{Scale=SCALE},0.45)
tw(shell,{Position=UDim2.fromOffset(0,0)},0.45)
delay(0.6,function() toast("info","NEBULA v3","Размер панели: М / С / Б в шапке. «–» сворачивает, клик по полоске разворачивает.") end)
