--== ХЕЛПЕРЫ ==--
local function new(class, props)
	local obj = Instance.new(class)
	local parent = props.Parent
	props.Parent = nil
	for k, v in pairs(props) do obj[k] = v end
	if parent then
		obj.Parent = parent
		local layout = parent:FindFirstChildOfClass("UIListLayout")
		if layout and obj:IsA("GuiObject") and obj.LayoutOrder == 0 then
			local n = 0
			for _, ch in ipairs(parent:GetChildren()) do if ch:IsA("GuiObject") then n = n + 1 end end
			obj.LayoutOrder = n
		end
	end
	return obj
end
local function corner(p, r) return new("UICorner", {Parent = p, CornerRadius = UDim.new(0, r)}) end
local function stroke(p, col, tr, th) return new("UIStroke", {Parent = p, Color = col, Transparency = tr, Thickness = th or 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border}) end
local function padding(p, l, r, t, b) return new("UIPadding", {Parent = p, PaddingLeft = UDim.new(0, l), PaddingRight = UDim.new(0, r or l), PaddingTop = UDim.new(0, t or l), PaddingBottom = UDim.new(0, b or t or l)}) end
local function vlist(p, gap, va) return new("UIListLayout", {Parent = p, Padding = UDim.new(0, gap or 10), SortOrder = Enum.SortOrder.LayoutOrder, VerticalAlignment = va or Enum.VerticalAlignment.Top}) end
local function hlist(p, gap, ha) return new("UIListLayout", {Parent = p, FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, gap or 8), SortOrder = Enum.SortOrder.LayoutOrder, VerticalAlignment = Enum.VerticalAlignment.Center, HorizontalAlignment = ha or Enum.HorizontalAlignment.Left}) end
local function gloss(p)
	local g = new("Frame", {Parent = p, Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(255, 255, 255), BorderSizePixel = 0, ZIndex = 0})
	new("UIGradient", {Parent = g, Rotation = 45, Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.94), NumberSequenceKeypoint.new(1, 1)})})
	return g
end
local function tw(obj, props, t, style)
	local tween = TS:Create(obj, TweenInfo.new(t or 0.2, style or Enum.EasingStyle.Quart, Enum.EasingDirection.Out), props)
	tween:Play()
	return tween
end
local function regAccent(o, p, g) table.insert(accentRefs, {o = o, p = p, g = g}) end
local function accentSeq() return ColorSequence.new({ColorSequenceKeypoint.new(0, ACCENT), ColorSequenceKeypoint.new(1, ACCENT:Lerp(Color3.new(0, 0, 0), 0.6))}) end
local function setAccent(col)
	ACCENT = col
	for _, r in ipairs(accentRefs) do if r.o.Parent ~= nil then tw(r.o, {[r.p] = r.g and r.g() or ACCENT}, 0.3) end end
	refreshTabs()
end
local function regPaint(f, o, p) table.insert(espPaint[f], {o = o, p = p}) end
local function paint(f)
	for _, r in ipairs(espPaint[f]) do if r.o.Parent ~= nil then r.o[r.p] = ESPColors[f] end end
end

