	local daysLeft = opts.daysLeft or "Lifetime"
	local userId = (LocalPlayer and LocalPlayer.UserId) or 1
	local userImage = "rbxthumb://type=AvatarHeadShot&id=" .. userId .. "&w=150&h=150"
	local mainColor = opts.accentColor or Color3.fromRGB(26, 123, 255)

	local parentGui = GetParentGui()
	local ScreenGui = New("ScreenGui", {
		Name = "NeverloseUI",
