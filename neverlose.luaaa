--== ИКОНКИ (только Frame + UIStroke, никаких картинок) ==--
local function part(p, x, y, w, h, r)
	local f = new("Frame", {Parent = p, Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(w, h), BackgroundColor3 = C.sub, BorderSizePixel = 0})
	if r and r > 0 then corner(f, r) end
	return {o = f, p = "BackgroundColor3"}
end
local function iconGrid(p)
	return {part(p, 0, 0, 8, 8, 2), part(p, 11, 0, 8, 8, 2), part(p, 0, 11, 8, 8, 2), part(p, 11, 11, 8, 8, 2)}
end
local function iconEye(p)
	local ring = new("Frame", {Parent = p, Position = UDim2.fromOffset(2, 3), Size = UDim2.fromOffset(16, 14), BackgroundTransparency = 1})
	corner(ring, 7)
	local s = stroke(ring, C.sub, 0, 1.6)
	return {{o = s, p = "Color"}, part(p, 7, 7, 6, 6, 3)}
end
local function iconUser(p)
	return {part(p, 6, 1, 8, 8, 4), part(p, 3, 12, 14, 7, 4)}
end
local function iconGear(p)
	local ring = new("Frame", {Parent = p, Position = UDim2.fromOffset(4, 4), Size = UDim2.fromOffset(12, 12), BackgroundTransparency = 1})
	corner(ring, 6)
	local s = stroke(ring, C.sub, 0, 2)
	return {{o = s, p = "Color"}, part(p, 8, 8, 4, 4, 2), part(p, 8, 0, 4, 3, 1), part(p, 8, 17, 4, 3, 1), part(p, 0, 8, 3, 4, 1), part(p, 17, 8, 3, 4, 1)}
end

--== КНОПКА ВКЛАДКИ + ПЕРЕКЛЮЧЕНИЕ ВКЛАДОК ==--
local function makeTab(key, iconFn)
	local btn = new("TextButton", {Parent = tabsHolder, Size = UDim2.new(1, 0, 0, 38), BackgroundColor3 = ACCENT, BackgroundTransparency = 1, Text = "", AutoButtonColor = false})
	corner(btn, 6)
	local grad = new("UIGradient", {Parent = btn, Color = accentSeq(), Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.45), NumberSequenceKeypoint.new(1, 1)})})
	regAccent(btn, "BackgroundColor3") regAccent(grad, "Color", accentSeq)
	local bar = new("Frame", {Parent = btn, Size = UDim2.fromOffset(3, 0), Position = UDim2.new(0, 0, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), BackgroundColor3 = ACCENT, BorderSizePixel = 0})
	corner(bar, 2) regAccent(bar, "BackgroundColor3")
	local row = new("Frame", {Parent = btn, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1})
	padding(row, 12, 8, 0, 0) hlist(row, 10)
	local icon = new("Frame", {Parent = row, Size = UDim2.fromOffset(20, 20), BackgroundTransparency = 1})
	local parts = iconFn(icon)
	local label = new("TextLabel", {Parent = row, Size = UDim2.new(1, -42, 1, 0), BackgroundTransparency = 1, Font = Enum.Font.GothamMedium, TextSize = 13, TextColor3 = C.sub, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd})
	bindText(label, key)
	local idx = #tabs + 1
	table.insert(tabs, {btn = btn, bar = bar, label = label, parts = parts, key = key})
	btn.Activated:Connect(function() selectTab(idx) end)
	btn.MouseEnter:Connect(function() if currentTab ~= idx then tw(btn, {BackgroundTransparency = 0.9}, 0.15) end end)
	btn.MouseLeave:Connect(function() if currentTab ~= idx then tw(btn, {BackgroundTransparency = 1}, 0.15) end end)
end
function selectTab(i)
	currentTab = i
	for idx, t in ipairs(tabs) do
		local on = idx == i
		tw(t.btn, {BackgroundTransparency = on and 0.72 or 1}, 0.25)
		tw(t.bar, {Size = UDim2.fromOffset(3, on and 20 or 0)}, 0.25)
		tw(t.label, {TextColor3 = on and C.text or C.sub}, 0.25)
		for _, pr in ipairs(t.parts) do tw(pr.o, {[pr.p] = on and ACCENT or C.sub}, 0.25) end
		local pg = pages[idx]
		if pg then pg.root.Visible = on end
	end
	topTitle.Text = tr(tabs[i].key)
	local pg = pages[i]
	if pg then
		pg.root.GroupTransparency = 1
		pg.scroll.Position = UDim2.fromOffset(0, 12)
		tw(pg.root, {GroupTransparency = 0}, 0.3)
		tw(pg.scroll, {Position = UDim2.fromOffset(0, 0)}, 0.32)
	end
end
refreshTabs = function()
	for idx, t in ipairs(tabs) do
		local on = idx == currentTab
		for _, pr in ipairs(t.parts) do tw(pr.o, {[pr.p] = on and ACCENT or C.sub}, 0.25) end
	end
end

--== ПРАВАЯ ОБЛАСТЬ: страницы с 2 колонками и автоскроллом ==--
local content = new("Frame", {Parent = window, Size = UDim2.new(1, -SIDEBAR_W, 1, -49), Position = UDim2.fromOffset(SIDEBAR_W, 49), BackgroundTransparency = 1, ZIndex = 2, ClipsDescendants = true})
local function makePage()
	local root = new("CanvasGroup", {Parent = content, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false, GroupTransparency = 1})
	local scroll = new("ScrollingFrame", {Parent = root, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3, ScrollBarImageColor3 = ACCENT, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollingDirection = Enum.ScrollingDirection.Y})
	regAccent(scroll, "ScrollBarImageColor3")
	padding(scroll, 0, 0, 0, 12)
	local cols = new("Frame", {Parent = scroll, Position = UDim2.fromOffset(12, 12), Size = UDim2.new(1, -28, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1})
	new("UIListLayout", {Parent = cols, FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder})
	local c1 = new("Frame", {Parent = cols, Size = UDim2.new(0.5, -5, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1})
	local c2 = new("Frame", {Parent = cols, Size = UDim2.new(0.5, -5, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1})
	vlist(c1, 10) vlist(c2, 10)
	local page = {root = root, scroll = scroll, c1 = c1, c2 = c2}
	table.insert(pages, page)
	return page
end

--== КИРПИЧИКИ: секция, карточка, тело карточки, инфо-карточка ==--
local function section(col, key)
	local l = new("TextLabel", {Parent = col, Size = UDim2.new(1, 0, 0, 22), BackgroundTransparency = 1, Font = Enum.Font.GothamBold, TextSize = 11, TextColor3 = ACCENT, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd})
	padding(l, 4, 4, 6, 0)
	bindText(l, key) regAccent(l, "TextColor3")
	return l
end
local function card(col, h)
	local c = new("Frame", {Parent = col, Size = UDim2.new(1, 0, 0, h or 0), AutomaticSize = h and Enum.AutomaticSize.None or Enum.AutomaticSize.Y, BackgroundColor3 = C.card, BackgroundTransparency = 0.22, BorderSizePixel = 0, ClipsDescendants = true})
	corner(c, 8) stroke(c, C.white, 0.85, 1) gloss(c)
	return c
end
local function cardBody(c, gap)
	local b = new("Frame", {Parent = c, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1})
	padding(b, 12) vlist(b, gap or 8)
	return b
end
local function infoCard(col, kTitle, kBody)
	local b = cardBody(card(col), 6)
	local t = new("TextLabel", {Parent = b, Size = UDim2.new(1, -24, 0, 18), BackgroundTransparency = 1, Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = C.text, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd})
	bindText(t, kTitle)
	local d = new("TextLabel", {Parent = b, Size = UDim2.new(1, -24, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Font = Enum.Font.Gotham, TextSize = 11, TextColor3 = C.sub, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, TextWrapped = true})
	bindText(d, kBody)
end

--== TOGGLE (капсула с анимацией ползунка) ==--
local function toggle(col, keyTitle, keyDesc, default, callback)
	local c = card(col, 58)
	local texts = new("Frame", {Parent = c, Size = UDim2.new(1, -58, 1, 0), BackgroundTransparency = 1})
	padding(texts, 12, 0, 10, 10) vlist(texts, 2, Enum.VerticalAlignment.Center)
	local t = new("TextLabel", {Parent = texts, Size = UDim2.new(1, -12, 0, 16), BackgroundTransparency = 1, Font = Enum.Font.GothamMedium, TextSize = 13, TextColor3 = C.text, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd})
	bindText(t, keyTitle)
	local d = new("TextLabel", {Parent = texts, Size = UDim2.new(1, -12, 0, 13), BackgroundTransparency = 1, Font = Enum.Font.Gotham, TextSize = 11, TextColor3 = C.sub, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd})
	bindText(d, keyDesc)
	local state = default and true or false
	local track = new("TextButton", {Parent = c, Size = UDim2.fromOffset(44, 22), Position = UDim2.new(1, -12, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5), BackgroundColor3 = state and ACCENT or C.track, BackgroundTransparency = 0.15, Text = "", AutoButtonColor = false})
	corner(track, 11) stroke(track, C.white, 0.85, 1)
	local knob = new("Frame", {Parent = track, Size = UDim2.fromOffset(16, 16), Position = state and UDim2.new(1, -19, 0.5, 0) or UDim2.new(0, 3, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), BackgroundColor3 = C.white, BorderSizePixel = 0})
	corner(knob, 8)
	regAccent(track, "BackgroundColor3", function() return state and ACCENT or C.track end)
	track.Activated:Connect(function()
		state = not state
		Flags[keyTitle] = state
		tw(track, {BackgroundColor3 = state and ACCENT or C.track}, 0.22)
		tw(knob, {Position = state and UDim2.new(1, -19, 0.5, 0) or UDim2.new(0, 3, 0.5, 0)}, 0.24, Enum.EasingStyle.Back)
		if callback then task.spawn(callback, state) end
	end)
	Flags[keyTitle] = state
	if callback then task.spawn(callback, state) end
	return c
end

--== SLIDER (плавный, шаг, суффикс, мышь + палец) ==--
local function slider(col, key, min, max, default, step, suffix, callback)
	local c = card(col, 74)
	local t = new("TextLabel", {Parent = c, Position = UDim2.fromOffset(12, 10), Size = UDim2.new(1, -84, 0, 16), BackgroundTransparency = 1, Font = Enum.Font.GothamMedium, TextSize = 13, TextColor3 = C.text, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd})
	bindText(t, key)
	local val = new("TextLabel", {Parent = c, Position = UDim2.new(1, -12, 0, 10), AnchorPoint = Vector2.new(1, 0), Size = UDim2.fromOffset(60, 16), BackgroundTransparency = 1, Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = ACCENT, TextXAlignment = Enum.TextXAlignment.Right, TextTruncate = Enum.TextTruncate.AtEnd})
	regAccent(val, "TextColor3")
	local track = new("Frame", {Parent = c, Position = UDim2.new(0, 12, 1, -22), Size = UDim2.new(1, -24, 0, 6), BackgroundColor3 = C.track, BackgroundTransparency = 0.15, BorderSizePixel = 0, Active = true})
	corner(track, 3)
	local fill = new("Frame", {Parent = track, Size = UDim2.fromScale(0, 1), BackgroundColor3 = ACCENT, BorderSizePixel = 0})
	corner(fill, 3) regAccent(fill, "BackgroundColor3")
	local knob = new("Frame", {Parent = track, Size = UDim2.fromOffset(14, 14), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0, 0.5), BackgroundColor3 = C.white, BorderSizePixel = 0, ZIndex = 2})
	corner(knob, 7) regAccent(stroke(knob, ACCENT, 0.2, 1.5), "Color")
	local value, dragging = default, false
	local function render(anim)
		local f = (value - min) / (max - min)
		val.Text = tostring(value) .. (suffix or "")
		if anim then
			tw(fill, {Size = UDim2.fromScale(f, 1)}, 0.15)
			tw(knob, {Position = UDim2.fromScale(f, 0.5)}, 0.15)
		else
			fill.Size = UDim2.fromScale(f, 1)
			knob.Position = UDim2.fromScale(f, 0.5)
		end
	end
	local function setFromX(x, anim)
		local f = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
		local v = math.clamp(math.floor((min + (max - min) * f) / step + 0.5) * step, min, max)
		if v ~= value then
			value = v
			Flags[key] = v
			render(anim)
			if callback then task.spawn(callback, v) end
		end
	end
	track.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			setFromX(i.Position.X, true)
		end
	end)
	connect(UIS.InputChanged, function(i)
		if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			setFromX(i.Position.X, false)
		end
	end)
	connect(UIS.InputEnded, function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = false end
	end)
	Flags[key] = value
	render(false)
	return c
end

--== DROPDOWN (плавное раскрытие, карточка растёт сама) ==--
local function dropdown(col, key, optKeys, defaultIdx, callback)
	local b = cardBody(card(col), 8)
	local head = new("TextButton", {Parent = b, Size = UDim2.new(1, -24, 0, 34), BackgroundTransparency = 1, Text = "", AutoButtonColor = false})
	local t = new("TextLabel", {Parent = head, Size = UDim2.new(1, -120, 1, 0), BackgroundTransparency = 1, Font = Enum.Font.GothamMedium, TextSize = 13, TextColor3 = C.text, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd})
	bindText(t, key)
	local val = new("TextLabel", {Parent = head, Position = UDim2.new(1, -22, 0, 0), AnchorPoint = Vector2.new(1, 0), Size = UDim2.fromOffset(96, 34), BackgroundTransparency = 1, Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = ACCENT, TextXAlignment = Enum.TextXAlignment.Right, TextTruncate = Enum.TextTruncate.AtEnd})
	regAccent(val, "TextColor3")
	local chev = new("Frame", {Parent = head, Position = UDim2.new(1, -2, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5), Size = UDim2.fromOffset(14, 14), BackgroundTransparency = 1})
	new("Frame", {Parent = chev, Position = UDim2.fromOffset(1, 6), Size = UDim2.fromOffset(7, 2), BackgroundColor3 = C.sub, BorderSizePixel = 0, Rotation = 45})
	new("Frame", {Parent = chev, Position = UDim2.fromOffset(6, 6), Size = UDim2.fromOffset(7, 2), BackgroundColor3 = C.sub, BorderSizePixel = 0, Rotation = -45})
	local list = new("Frame", {Parent = b, Size = UDim2.new(1, -24, 0, 0), BackgroundTransparency = 1, ClipsDescendants = true})
	vlist(list, 6)
	local open, selected, optBtns = false, defaultIdx, {}
	local function refresh()
		val.Text = tr(optKeys[selected])
		for i, o in ipairs(optBtns) do
			tw(o.label, {TextColor3 = i == selected and C.text or C.sub}, 0.15)
			tw(o.dot, {BackgroundTransparency = i == selected and 0 or 1}, 0.15)
		end
	end
	local function setOpenList(o)
		open = o
		tw(list, {Size = UDim2.new(1, -24, 0, o and (#optKeys * 30 + (#optKeys - 1) * 6) or 0)}, 0.25)
		tw(chev, {Rotation = o and 180 or 0}, 0.25)
	end
	for i, k in ipairs(optKeys) do
		local ob = new("TextButton", {Parent = list, Size = UDim2.new(1, 0, 0, 30), BackgroundColor3 = C.side, BackgroundTransparency = 0.35, Text = "", AutoButtonColor = false})
		corner(ob, 6)
		local dot = new("Frame", {Parent = ob, Position = UDim2.new(0, 8, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), Size = UDim2.fromOffset(3, 14), BackgroundColor3 = ACCENT, BackgroundTransparency = 1, BorderSizePixel = 0})
		corner(dot, 2) regAccent(dot, "BackgroundColor3")
		local lb = new("TextLabel", {Parent = ob, Position = UDim2.fromOffset(18, 0), Size = UDim2.new(1, -26, 1, 0), BackgroundTransparency = 1, Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = C.sub, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd})
		bindText(lb, k)
		ob.Activated:Connect(function()
			selected = i
			Flags[key] = optKeys[i]
			refresh()
			setOpenList(false)
			if callback then task.spawn(callback, optKeys[i], i) end
		end)
		table.insert(optBtns, {label = lb, dot = dot})
	end
	head.Activated:Connect(function() setOpenList(not open) end)
	bindText(val, function() return tr(optKeys[selected]) end)
	Flags[key] = optKeys[selected]
	refresh()
end

--== КНОПКА-ДЕЙСТВИЕ ==--
local function button(col, key, callback)
	local b = new("TextButton", {Parent = col, Size = UDim2.new(1, 0, 0, 36), BackgroundColor3 = ACCENT, BackgroundTransparency = 0.15, Text = "", AutoButtonColor = false})
	corner(b, 6) stroke(b, C.white, 0.8, 1) regAccent(b, "BackgroundColor3")
	local lb = new("TextLabel", {Parent = b, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = C.white, TextTruncate = Enum.TextTruncate.AtEnd})
	padding(lb, 10) bindText(lb, key)
	b.MouseEnter:Connect(function() tw(b, {BackgroundTransparency = 0.02}, 0.15) end)
	b.MouseLeave:Connect(function() tw(b, {BackgroundTransparency = 0.15}, 0.15) end)
	b.Activated:Connect(function() if callback then task.spawn(callback) end end)
	return b
end

--== ВЫБОР ЦВЕТА АКЦЕНТА (кружки в один клик) ==--
local function accentPicker(col)
	local b = cardBody(card(col), 8)
	local t = new("TextLabel", {Parent = b, Size = UDim2.new(1, -24, 0, 16), BackgroundTransparency = 1, Font = Enum.Font.GothamMedium, TextSize = 13, TextColor3 = C.text, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd})
	bindText(t, "accentTitle")
	local d = new("TextLabel", {Parent = b, Size = UDim2.new(1, -24, 0, 14), BackgroundTransparency = 1, Font = Enum.Font.Gotham, TextSize = 11, TextColor3 = C.sub, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd})
	bindText(d, "accentDesc")
	local row = new("Frame", {Parent = b, Size = UDim2.new(1, -24, 0, 28), BackgroundTransparency = 1})
	hlist(row, 10)
	for _, rgb in ipairs({{59, 130, 246}, {139, 92, 246}, {236, 72, 153}, {16, 185, 129}, {245, 158, 11}, {239, 68, 68}}) do
		local cb = new("TextButton", {Parent = row, Size = UDim2.fromOffset(26, 26), BackgroundColor3 = Color3.fromRGB(rgb[1], rgb[2], rgb[3]), Text = "", AutoButtonColor = false})
		corner(cb, 13)
		local s = stroke(cb, C.white, 0.6, 1.5)
		cb.MouseEnter:Connect(function() tw(s, {Transparency = 0.1}, 0.15) end)
		cb.MouseLeave:Connect(function() tw(s, {Transparency = 0.6}, 0.15) end)
		cb.Activated:Connect(function()
			setAccent(cb.BackgroundColor3)
			notify(tr("nAccent"), tr("nAccentBody"))
		end)
	end
end

--== ПЕРЕКЛЮЧАТЕЛЬ ЯЗЫКА RU / EN (сегмент с бегущей пилюлей) ==--
local function langPicker(col)
	local b = cardBody(card(col), 8)
	local t = new("TextLabel", {Parent = b, Size = UDim2.new(1, -24, 0, 16), BackgroundTransparency = 1, Font = Enum.Font.GothamMedium, TextSize = 13, TextColor3 = C.text, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd})
	bindText(t, "langTitle")
	local d = new("TextLabel", {Parent = b, Size = UDim2.new(1, -24, 0, 14), BackgroundTransparency = 1, Font = Enum.Font.Gotham, TextSize = 11, TextColor3 = C.sub, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd})
	bindText(d, "langDesc")
	local seg = new("Frame", {Parent = b, Size = UDim2.new(1, -24, 0, 32), BackgroundColor3 = C.side, BackgroundTransparency = 0.3, BorderSizePixel = 0})
	corner(seg, 6) stroke(seg, C.white, 0.88, 1)
	local pill = new("Frame", {Parent = seg, Size = UDim2.new(0.5, -3, 1, -6), Position = UDim2.fromOffset(3, 3), BackgroundColor3 = ACCENT, BackgroundTransparency = 0.2, BorderSizePixel = 0})
	corner(pill, 5) regAccent(pill, "BackgroundColor3")
	local function mk(code, text, pos)
		local lb = new("TextButton", {Parent = seg, Size = UDim2.new(0.5, -3, 1, -6), Position = pos, BackgroundTransparency = 1, Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = C.white, Text = text, AutoButtonColor = false})
		corner(lb, 5)
		lb.Activated:Connect(function()
			setLang(code)
			tw(pill, {Position = code == "ru" and UDim2.fromOffset(3, 3) or UDim2.new(0.5, 0, 0, 3)}, 0.25)
			notify(tr("nLang"), tr("nLangBody"))
		end)
	end
	mk("ru", "Русский", UDim2.fromOffset(3, 3))
	mk("en", "English", UDim2.new(0.5, 0, 0, 3))
end

