--!nonstrict
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local HttpService = game:GetService("HttpService")
local MarketplaceService = game:GetService("MarketplaceService")

local LocalPlayer = Players.LocalPlayer or Players.PlayerAdded:Wait()

-- ============================================================================
-- МОДУЛЬ 1: ЯДРО ЗАЩИТЫ, ТЕМИЗАЦИИ И УТИЛИТ (CORE & THEME ENGINE)
-- ============================================================================

local Signal = {}
Signal.__index = Signal

function Signal.new()
	return setmetatable({
		_listeners = {},
	}, Signal)
end

function Signal:Connect(callback)
	assert(type(callback) == "function", "Signal:Connect ожидает функцию")
	local connection = {
		Connected = true,
		_callback = callback,
		_signal = self,
	}
	function connection:Disconnect()
		if not self.Connected then
			return
		end
		self.Connected = false
		local list = self._signal._listeners
		for i = #list, 1, -1 do
			if list[i] == self then
				table.remove(list, i)
				break
			end
		end
	end
	table.insert(self._listeners, connection)
	return connection
end

function Signal:Fire(...)
	local snapshot = table.clone(self._listeners)
	for _, conn in ipairs(snapshot) do
		if conn.Connected then
			task.spawn(conn._callback, ...)
		end
	end
end

function Signal:Clear()
	for _, conn in ipairs(self._listeners) do
		conn.Connected = false
	end
	table.clear(self._listeners)
end

local Maid = {}
Maid.__index = Maid

function Maid.new()
	return setmetatable({
		_tasks = {},
	}, Maid)
end

function Maid:GiveTask(taskItem)
	if taskItem == nil then
		return nil
	end
	table.insert(self._tasks, taskItem)
	return taskItem
end

function Maid:DoCleaning()
	local tasks = self._tasks
	self._tasks = {}
	for _, item in ipairs(tasks) do
		local t = typeof(item)
		if t == "RBXScriptConnection" then
			pcall(function()
				item:Disconnect()
			end)
		elseif type(item) == "table" and type(item.Disconnect) == "function" then
			pcall(function()
				item:Disconnect()
			end)
		elseif type(item) == "function" then
			pcall(item)
		elseif t == "Instance" then
			pcall(function()
				item:Destroy()
			end)
		elseif type(item) == "thread" then
			pcall(function()
				task.cancel(item)
			end)
		end
	end
end

function Maid:Destroy()
	self:DoCleaning()
end

local ThemeRegistry = {
	Accent = Color3.fromRGB(0, 168, 255),
	AccentDark = Color3.fromRGB(0, 118, 196),
	Background = Color3.fromRGB(7, 11, 20),
	Sidebar = Color3.fromRGB(10, 15, 27),
	Section = Color3.fromRGB(12, 18, 32),
	Row = Color3.fromRGB(17, 25, 43),
	RowHover = Color3.fromRGB(23, 33, 56),
	Stroke = Color3.fromRGB(28, 39, 64),
	Text = Color3.fromRGB(240, 245, 255),
	Muted = Color3.fromRGB(130, 146, 178),
	Success = Color3.fromRGB(46, 213, 115),
	Warn = Color3.fromRGB(255, 177, 66),
	Error = Color3.fromRGB(255, 71, 87),
	Info = Color3.fromRGB(0, 168, 255),
	ThemeChanged = Signal.new(),
}

local PRESET_ACCENTS = {
	Color3.fromRGB(0, 168, 255),   -- Neverlose Cyan-Blue (#00A8FF)
	Color3.fromRGB(120, 92, 255),  -- Electric Violet
	Color3.fromRGB(46, 213, 115),  -- Emerald Neon
	Color3.fromRGB(255, 71, 163),  -- Neon Magenta
	Color3.fromRGB(255, 159, 67),  -- Amber Flame
	Color3.fromRGB(255, 71, 87),   -- Crimson Pulse
}

function ThemeRegistry:SetAccent(newColor)
	assert(typeof(newColor) == "Color3", "ThemeRegistry:SetAccent ожидает Color3")
	self.Accent = newColor
	local h, s, v = newColor:ToHSV()
	self.AccentDark = Color3.fromHSV(h, math.clamp(s * 1.05, 0, 1), math.clamp(v * 0.72, 0, 1))
	self.ThemeChanged:Fire(newColor, self.AccentDark)
end

local function Create(className, properties, children)
	local instance = Instance.new(className)
	for prop, val in pairs(properties or {}) do
		if prop ~= "Parent" then
			instance[prop] = val
		end
	end
	if children then
		for _, child in ipairs(children) do
			if typeof(child) == "Instance" then
				child.Parent = instance
			end
		end
	end
	if properties and properties.Parent ~= nil then
		instance.Parent = properties.Parent
	end
	return instance
end

local function Round(instance, radius)
	return Create("UICorner", {
		CornerRadius = UDim.new(0, radius or 6),
	}, { instance })
end

local function IsPointerDown(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch
end

local function IsPointerMove(input)
	return input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch
end

local function ResolveGuiParent()
	if type(gethui) == "function" then
		local ok, container = pcall(gethui)
		if ok and typeof(container) == "Instance" then
			return container
		end
	end
	local okCore, coreGui = pcall(function()
		return game:GetService("CoreGui")
	end)
	if okCore and typeof(coreGui) == "Instance" then
		return coreGui
	end
	return LocalPlayer:FindFirstChildOfClass("PlayerGui") or LocalPlayer:WaitForChild("PlayerGui")
end

local function CreateRootScreenGui(maid, displayOrder)
	local parent = ResolveGuiParent()
	local cryptoName = "NL_" .. string.gsub(HttpService:GenerateGUID(false), "-", "")
	local gui = Create("ScreenGui", {
		Name = cryptoName,
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = displayOrder or 1000,
		Parent = parent,
	})
	maid:GiveTask(gui)
	return gui
end

local function BindDraggable(frame, handle, maid, onDragStart)
	handle = handle or frame
	local dragging = false
	local activeInput = nil
	local originInputPos = Vector2.zero
	local originFramePos = frame.Position

	maid:GiveTask(handle.InputBegan:Connect(function(input)
		if IsPointerDown(input) then
			dragging = true
			activeInput = input
			originInputPos = input.Position
			originFramePos = frame.Position
			if onDragStart then
				onDragStart()
			end
			local endConn
			endConn = input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
					if activeInput == input then
						activeInput = nil
					end
					if endConn then
						endConn:Disconnect()
					end
				end
			end)
			maid:GiveTask(endConn)
		end
	end))

	maid:GiveTask(UserInputService.InputChanged:Connect(function(input)
		if dragging and input == activeInput and IsPointerMove(input) then
			local delta = input.Position - originInputPos
			frame.Position = UDim2.new(
				originFramePos.X.Scale,
				originFramePos.X.Offset + delta.X,
				originFramePos.Y.Scale,
				originFramePos.Y.Offset + delta.Y
			)
		end
	end))

	maid:GiveTask(UserInputService.InputEnded:Connect(function(input)
		if input == activeInput then
			dragging = false
			activeInput = nil
		end
	end))
end

-- ============================================================================
-- МОДУЛЬ 5 (ЧАСТЬ А): КРОСС-ЭКЗЕКЬЮТОРНЫЙ HTTP & DISCORD WEBHOOK
-- ============================================================================

local function GetHttpRequestFunc()
	if syn and type(syn.request) == "function" then
		return syn.request
	end
	if type(http) == "table" and type(http.request) == "function" then
		return http.request
	end
	if type(http_request) == "function" then
		return http_request
	end
	if type(fluxus) == "table" and type(fluxus.request) == "function" then
		return fluxus.request
	end
	if type(request) == "function" then
		return request
	end
	return nil
end

local function DetectExecutorName()
	if type(identifyexecutor) == "function" then
		local ok, name, ver = pcall(identifyexecutor)
		if ok and name then
			return ver and (tostring(name) .. " " .. tostring(ver)) or tostring(name)
		end
	end
	if type(getexecutorname) == "function" then
		local ok, name = pcall(getexecutorname)
		if ok and name then
			return tostring(name)
		end
	end
	if syn then
		return "Synapse"
	end
	if fluxus then
		return "Fluxus"
	end
	return "Roblox Client / Unknown Executor"
end

local function GetPlaceTitleSafe()
	local ok, info = pcall(function()
		return MarketplaceService:GetProductInfo(game.PlaceId, Enum.InfoType.Asset)
	end)
	if ok and type(info) == "table" and info.Name then
		return tostring(info.Name)
	end
	return "Place #" .. tostring(game.PlaceId)
end

local function SafeHttpGet(url, timeoutSec)
	if type(url) ~= "string" or url == "" then
		return false, "Пустой URL"
	end
	local reqFunc = GetHttpRequestFunc()
	local resultBody = nil
	local okCall, errMsg = false, "Таймаут запроса"

	local done = false
	task.spawn(function()
		if reqFunc then
			local ok, resp = pcall(function()
				return reqFunc({
					Url = url,
					Method = "GET",
				})
			end)
			if ok and type(resp) == "table" then
				local code = tonumber(resp.StatusCode) or 200
				if code >= 200 and code < 300 and type(resp.Body) == "string" then
					resultBody = resp.Body
					okCall = true
				else
					errMsg = "HTTP статус " .. tostring(code)
				end
			else
				errMsg = tostring(resp)
			end
		else
			local ok, body = pcall(function()
				return game:HttpGet(url)
			end)
			if ok and type(body) == "string" then
				resultBody = body
				okCall = true
			else
				errMsg = tostring(body)
			end
		end
		done = true
	end)

	local deadline = os.clock() + (timeoutSec or 8)
	while not done and os.clock() < deadline do
		RunService.Heartbeat:Wait()
	end

	if not done then
		return false, "Превышено время ожидания (" .. tostring(timeoutSec or 8) .. "s)"
	end
	if not okCall then
		return false, errMsg
	end
	return true, resultBody
end

local function ParseColorHex(hex)
	if type(hex) == "number" then
		return hex
	end
	if type(hex) == "string" then
		local clean = string.gsub(hex, "^#", "")
		local num = tonumber(clean, 16)
		if num then
			return num
		end
	end
	return 0x00A8FF
end

-- ============================================================================
-- ГЛАВНЫЙ КЛАСС БИБЛИОТЕКИ (LIBRARY CORE)
-- ============================================================================

local Library = {
	Version = "3.4.0-NL",
	Flags = {},
	_logEntries = {},
	_logSignal = Signal.new(),
	_notifyGui = nil,
	_notifyList = nil,
	_notifyMaid = Maid.new(),
	_activeNotifications = {},
	_configFolder = "NeverloseUI/Configs",
}

local function FormatClockTime()
	local now = os.date("*t")
	return string.format("[%02d:%02d:%02d]", now.hour or 0, now.min or 0, now.sec or 0)
end

function Library:Log(text, level)
	local lvl = string.upper(tostring(level or "INFO"))
	if lvl ~= "INFO" and lvl ~= "SUCCESS" and lvl ~= "WARN" and lvl ~= "ERROR" then
		lvl = "INFO"
	end
	local stamp = FormatClockTime()
	local msg = tostring(text or "")
	local entry = {
		Time = stamp,
		Level = lvl,
		Text = msg,
		Formatted = string.format("%s [%s] %s", stamp, lvl, msg),
	}
	table.insert(self._logEntries, entry)
	if #self._logEntries > 500 then
		table.remove(self._logEntries, 1)
	end
	self._logSignal:Fire(entry)
end

function Library:GetLogsText()
	local lines = {}
	for _, entry in ipairs(self._logEntries) do
		table.insert(lines, entry.Formatted)
	end
	return table.concat(lines, "\n")
end

function Library:ClearLogs()
	table.clear(self._logEntries)
	self._logSignal:Fire({ Clear = true })
end

function Library:SendWebhook(webhookUrl, title, description, colorHex)
	if type(webhookUrl) ~= "string" or webhookUrl == "" or string.find(webhookUrl, "YOUR_WEBHOOK", 1, true) then
		self:Log("Webhook пропущен: не задан корректный URL вебхука.", "WARN")
		return false, "Webhook URL не задан"
	end
	local reqFunc = GetHttpRequestFunc()
	if not reqFunc then
		self:Log("Webhook не отправлен: экзекьютор не поддерживает HTTP-запросы.", "ERROR")
		return false, "HTTP запрос недоступен"
	end

	local accountAgeDays = tonumber(LocalPlayer.AccountAge) or 0
	local placeName = GetPlaceTitleSafe()
	local jobIdStr = (game.JobId and game.JobId ~= "") and tostring(game.JobId) or "Studio / LocalServer"
	local executorStr = DetectExecutorName()

	local payload = {
		username = "Neverlose Telemetry",
		avatar_url = "https://www.roblox.com/headshot-thumbnail/image?userId=" .. tostring(LocalPlayer.UserId) .. "&width=150&height=150&format=png",
		embeds = {
			{
				title = tostring(title or "Neverlose Event"),
				description = tostring(description or "Телеметрия сессии клиента"),
				color = ParseColorHex(colorHex or "#00A8FF"),
				fields = {
					{
						name = "Игрок",
						value = string.format("%s (@%s)\nID: `%d`", tostring(LocalPlayer.DisplayName), tostring(LocalPlayer.Name), LocalPlayer.UserId),
						inline = true,
					},
					{
						name = "Возраст аккаунта",
						value = tostring(accountAgeDays) .. " дн.",
						inline = true,
					},
					{
						name = "Экзекьютор",
						value = "`" .. executorStr .. "`",
						inline = true,
					},
					{
						name = "Плейс",
						value = string.format("%s (`%d`)", placeName, game.PlaceId),
						inline = false,
					},
					{
						name = "Сервер (JobId)",
						value = "`" .. jobIdStr .. "`",
						inline = false,
					},
				},
				timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ"),
			},
		},
	}

	local encoded = HttpService:JSONEncode(payload)
	local ok, resp = pcall(function()
		return reqFunc({
			Url = webhookUrl,
			Method = "POST",
			Headers = {
				["Content-Type"] = "application/json",
			},
			Body = encoded,
		})
	end)

	if ok and type(resp) == "table" then
		local code = tonumber(resp.StatusCode) or 200
		if code >= 200 and code < 300 then
			self:Log("Discord Webhook успешно отправлен (HTTP " .. tostring(code) .. ").", "SUCCESS")
			return true
		end
		self:Log("Ошибка Discord Webhook: HTTP " .. tostring(code), "ERROR")
		return false, "HTTP " .. tostring(code)
	end

	self:Log("Сбой отправки Discord Webhook: " .. tostring(resp), "ERROR")
	return false, tostring(resp)
end

-- ============================================================================
-- МОДУЛЬ 6 (ЧАСТЬ А): СИСТЕМА УВЕДОМЛЕНИЙ (STACKED NOTIFICATIONS)
-- ============================================================================

local function EnsureNotificationContainer()
	if Library._notifyGui and Library._notifyGui.Parent and Library._notifyList and Library._notifyList.Parent then
		return
	end
	Library._notifyMaid:DoCleaning()
	local gui = CreateRootScreenGui(Library._notifyMaid, 1200)
	Library._notifyGui = gui

	local list = Create("Frame", {
		Name = "NotificationStack",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -18, 1, -18),
		Size = UDim2.new(0, 310, 0, 420),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Parent = gui,
	})
	Library._notifyList = list

	Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Vertical,
		HorizontalAlignment = Enum.HorizontalAlignment.Right,
		VerticalAlignment = Enum.VerticalAlignment.Bottom,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 8),
		Parent = list,
	})
end

local function GetNotificationColor(notifType)
	local t = string.upper(tostring(notifType or "INFO"))
	if t == "SUCCESS" then
		return ThemeRegistry.Success
	elseif t == "WARN" or t == "WARNING" then
		return ThemeRegistry.Warn
	elseif t == "ERROR" then
		return ThemeRegistry.Error
	end
	return ThemeRegistry.Accent
end

local notifyOrderCounter = 0

function Library:Notify(config)
	config = config or {}
	EnsureNotificationContainer()

	local title = tostring(config.Title or "Neverlose")
	local text = tostring(config.Text or "")
	local duration = tonumber(config.Duration) or 4
	local nType = config.Type or "INFO"
	local accentCol = GetNotificationColor(nType)

	notifyOrderCounter += 1
	local card = Create("Frame", {
		Name = "NotifyCard_" .. tostring(notifyOrderCounter),
		Size = UDim2.new(1, 0, 0, 72),
		BackgroundColor3 = ThemeRegistry.Sidebar,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		LayoutOrder = notifyOrderCounter,
		Parent = self._notifyList,
	})
	Round(card, 8)

	local stroke = Create("UIStroke", {
		Color = accentCol,
		Thickness = 1.2,
		Transparency = 1,
		Parent = card,
	})

	local accentBar = Create("Frame", {
		Size = UDim2.new(0, 3, 1, 0),
		Position = UDim2.new(0, 0, 0, 0),
		BackgroundColor3 = accentCol,
		BorderSizePixel = 0,
		Parent = card,
	})

	local titleLbl = Create("TextLabel", {
		Size = UDim2.new(1, -20, 0, 18),
		Position = UDim2.new(0, 12, 0, 8),
		BackgroundTransparency = 1,
		Text = title,
		TextColor3 = ThemeRegistry.Text,
		TextSize = 13,
		Font = Enum.Font.GothamBold,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextTransparency = 1,
		Parent = card,
	})

	local bodyLbl = Create("TextLabel", {
		Size = UDim2.new(1, -20, 0, 32),
		Position = UDim2.new(0, 12, 0, 26),
		BackgroundTransparency = 1,
		Text = text,
		TextColor3 = ThemeRegistry.Muted,
		TextSize = 11,
		Font = Enum.Font.Gotham,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextWrapped = true,
		TextTransparency = 1,
		Parent = card,
	})

	local timerTrack = Create("Frame", {
		Size = UDim2.new(1, 0, 0, 3),
		Position = UDim2.new(0, 0, 1, -3),
		BackgroundColor3 = ThemeRegistry.Row,
		BorderSizePixel = 0,
		Parent = card,
	})

	local timerFill = Create("Frame", {
		Size = UDim2.new(1, 0, 1, 0),
		Position = UDim2.new(0, 0, 0, 0),
		BackgroundColor3 = accentCol,
		BorderSizePixel = 0,
		Parent = timerTrack,
	})

	local themeConn = ThemeRegistry.ThemeChanged:Connect(function(newAcc)
		if string.upper(tostring(nType)) == "INFO" then
			accentBar.BackgroundColor3 = newAcc
			timerFill.BackgroundColor3 = newAcc
			stroke.Color = newAcc
		end
	end)
	self._notifyMaid:GiveTask(themeConn)
	self._notifyMaid:GiveTask(card)

	TweenService:Create(card, TweenInfo.new(0.28, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
		BackgroundTransparency = 0.06,
	}):Play()
	TweenService:Create(stroke, TweenInfo.new(0.28, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
		Transparency = 0.2,
	}):Play()
	TweenService:Create(titleLbl, TweenInfo.new(0.28, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
		TextTransparency = 0,
	}):Play()
	TweenService:Create(bodyLbl, TweenInfo.new(0.28, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
		TextTransparency = 0,
	}):Play()

	local barTween = TweenService:Create(timerFill, TweenInfo.new(duration, Enum.EasingStyle.Linear), {
		Size = UDim2.new(0, 0, 1, 0),
	})
	barTween:Play()

	task.delay(duration, function()
		if not card or not card.Parent then
			return
		end
		themeConn:Disconnect()
		local outTween = TweenService:Create(card, TweenInfo.new(0.24, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, 0),
		})
		TweenService:Create(titleLbl, TweenInfo.new(0.18), { TextTransparency = 1 }):Play()
		TweenService:Create(bodyLbl, TweenInfo.new(0.18), { TextTransparency = 1 }):Play()
		TweenService:Create(stroke, TweenInfo.new(0.18), { Transparency = 1 }):Play()
		outTween:Play()
		outTween.Completed:Once(function()
			if card and card.Parent then
				card:Destroy()
			end
		end)
	end)
end

-- ============================================================================
-- МОДУЛЬ 6 (ЧАСТЬ Б): СИСТЕМА КОНФИГОВ (JSON + FILE SYSTEM)
-- ============================================================================

local function SerializeValue(val)
	local t = typeof(val)
	if t == "Color3" then
		return {
			__type = "Color3",
			r = val.R,
			g = val.G,
			b = val.B,
		}
	elseif t == "EnumItem" then
		return {
			__type = "EnumItem",
			enumType = tostring(val.EnumType),
			name = val.Name,
		}
	elseif type(val) == "table" then
		local out = {}
		for k, v in pairs(val) do
			out[tostring(k)] = SerializeValue(v)
		end
		return out
	elseif type(val) == "boolean" or type(val) == "number" or type(val) == "string" then
		return val
	end
	return tostring(val)
end

local function DeserializeValue(val)
	if type(val) == "table" then
		if val.__type == "Color3" then
			return Color3.new(tonumber(val.r) or 0, tonumber(val.g) or 0, tonumber(val.b) or 0)
		elseif val.__type == "EnumItem" then
			local enumObj = Enum[tostring(val.enumType)]
			if enumObj and enumObj[tostring(val.name)] then
				return enumObj[tostring(val.name)]
			end
		end
		local out = {}
		for k, v in pairs(val) do
			out[k] = DeserializeValue(v)
		end
		return out
	end
	return val
end

local function EnsureConfigFolder()
	if type(makefolder) == "function" then
		pcall(function()
			if not (type(isfolder) == "function" and isfolder("NeverloseUI")) then
				makefolder("NeverloseUI")
			end
			if not (type(isfolder) == "function" and isfolder(Library._configFolder)) then
				makefolder(Library._configFolder)
			end
		end)
	end
end

function Library:SaveConfig(configName)
	local safeName = tostring(configName or "default")
	safeName = string.gsub(safeName, "[^%w_%-]", "_")
	EnsureConfigFolder()

	local exportTable = {}
	for flagName, flagObj in pairs(self.Flags) do
		local rawVal = (type(flagObj) == "table" and type(flagObj.Get) == "function") and flagObj:Get() or flagObj
		exportTable[flagName] = SerializeValue(rawVal)
	end

	local okJson, jsonStr = pcall(function()
		return HttpService:JSONEncode(exportTable)
	end)
	if not okJson then
		self:Log("Ошибка кодирования конфига в JSON: " .. tostring(jsonStr), "ERROR")
		self:Notify({ Title = "Config Error", Text = "Не удалось сериализовать конфиг.", Type = "ERROR" })
		return false
	end

	local filePath = self._configFolder .. "/" .. safeName .. ".json"
	if type(writefile) == "function" then
		local okWrite, errWrite = pcall(function()
			writefile(filePath, jsonStr)
		end)
		if okWrite then
			self:Log("Конфиг сохранён: " .. filePath, "SUCCESS")
			self:Notify({ Title = "Config Saved", Text = "Файл сохранён: " .. safeName .. ".json", Type = "SUCCESS" })
			return true
		end
		self:Log("Ошибка записи конфига: " .. tostring(errWrite), "ERROR")
		self:Notify({ Title = "Config Error", Text = tostring(errWrite), Type = "ERROR" })
		return false
	end

	self._memoryConfigs = self._memoryConfigs or {}
	self._memoryConfigs[safeName] = jsonStr
	self:Log("Конфиг сохранён в памяти сессии: " .. safeName, "WARN")
	self:Notify({ Title = "Config Cached", Text = "writefile недоступен, сохранено в памяти.", Type = "WARN" })
	return true
end

function Library:LoadConfig(configName)
	local safeName = tostring(configName or "default")
	safeName = string.gsub(safeName, "[^%w_%-]", "_")
	local filePath = self._configFolder .. "/" .. safeName .. ".json"
	local rawJson = nil

	if type(isfile) == "function" and type(readfile) == "function" then
		local okExists, exists = pcall(isfile, filePath)
		if okExists and exists then
			local okRead, content = pcall(readfile, filePath)
			if okRead and type(content) == "string" then
				rawJson = content
			end
		end
	end

	if not rawJson and self._memoryConfigs and self._memoryConfigs[safeName] then
		rawJson = self._memoryConfigs[safeName]
	end

	if not rawJson then
		self:Log("Конфиг не найден: " .. filePath, "WARN")
		self:Notify({ Title = "Config Not Found", Text = "Файл " .. safeName .. ".json отсутствует.", Type = "WARN" })
		return false
	end

	local okDec, decoded = pcall(function()
		return HttpService:JSONDecode(rawJson)
	end)
	if not okDec or type(decoded) ~= "table" then
		self:Log("Ошибка чтения JSON конфига: " .. tostring(decoded), "ERROR")
		self:Notify({ Title = "Config Error", Text = "Повреждённый JSON файл конфига.", Type = "ERROR" })
		return false
	end

	local appliedCount = 0
	for flagName, encodedVal in pairs(decoded) do
		local flagObj = self.Flags[flagName]
		if flagObj and type(flagObj.Set) == "function" then
			local restored = DeserializeValue(encodedVal)
			pcall(function()
				flagObj:Set(restored)
				appliedCount += 1
			end)
		end
	end

	self:Log(string.format("Загружен конфиг '%s' (применено флагов: %d).", safeName, appliedCount), "SUCCESS")
	self:Notify({
		Title = "Config Loaded",
		Text = string.format("'%s' применён (%d параметров).", safeName, appliedCount),
		Type = "SUCCESS",
	})
	return true
end

-- ============================================================================
-- МОДУЛЬ 2: АСИНХРОННАЯ СИСТЕМА АВТОРИЗАЦИИ И КЛЮЧЕЙ (KEY SYSTEM GATE)
-- ============================================================================

local function NormalizeKeyString(raw)
	if type(raw) ~= "string" then
		return ""
	end
	return string.gsub(raw, "^%s*(.-)%s*$", "%1")
end

local function IsValidKeyAgainstSource(candidate, remoteBody, fallbackKey)
	local cleanCandidate = NormalizeKeyString(candidate)
	if cleanCandidate == "" then
		return false
	end
	if fallbackKey and cleanCandidate == NormalizeKeyString(fallbackKey) then
		return true
	end
	if type(remoteBody) == "string" and remoteBody ~= "" then
		for line in string.gmatch(remoteBody, "[^\r\n]+") do
			if NormalizeKeyString(line) == cleanCandidate then
				return true
			end
		end
	end
	return false
end

local function SaveKeyToDisk(keyStr)
	if type(writefile) == "function" then
		pcall(function()
			if type(makefolder) == "function" then
				if not (type(isfolder) == "function" and isfolder("NeverloseUI")) then
					makefolder("NeverloseUI")
				end
			end
			writefile("NeverloseUI/key.dat", NormalizeKeyString(keyStr))
		end)
	end
end

local function LoadCachedKeyFromDisk()
	if type(isfile) == "function" and type(readfile) == "function" then
		local okEx, exists = pcall(isfile, "NeverloseUI/key.dat")
		if okEx and exists then
			local okRd, data = pcall(readfile, "NeverloseUI/key.dat")
			if okRd and type(data) == "string" then
				return NormalizeKeyString(data)
			end
		end
	end
	return ""
end

function Library:RunKeyGate(keyConfig)
	keyConfig = keyConfig or {}
	local enabled = (keyConfig.Enabled ~= false)
	local fallbackKey = NormalizeKeyString(keyConfig.FallbackKey or "NL-MASTER-2026")
	local keyUrl = tostring(keyConfig.KeyURL or "")
	local getKeyLink = tostring(keyConfig.GetKeyLink or "https://neverlose.cc/get-key")
	local titleText = tostring(keyConfig.Title or "NEVERLOSE AUTH")
	local subtitleText = tostring(keyConfig.Subtitle or "Введите лицензионный ключ доступа")
	local webhookUrl = keyConfig.WebhookURL

	if not enabled then
		self:Log("Key Gate отключён в конфигурации — прямой запуск интерфейса.", "INFO")
		return true
	end

	local gateMaid = Maid.new()
	local gui = CreateRootScreenGui(gateMaid, 1100)
	local verifiedSignal = Signal.new()
	gateMaid:GiveTask(verifiedSignal)

	local card = Create("Frame", {
		Name = "KeyGateCard",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 0),
		Size = UDim2.new(0, 380, 0, 236),
		BackgroundColor3 = ThemeRegistry.Background,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Parent = gui,
	})
	Round(card, 10)

	local scale = Create("UIScale", {
		Scale = 0.86,
		Parent = card,
	})

	local cardStroke = Create("UIStroke", {
		Color = ThemeRegistry.Accent,
		Thickness = 1.4,
		Transparency = 1,
		Parent = card,
	})

	local topBar = Create("Frame", {
		Size = UDim2.new(1, 0, 0, 44),
		Position = UDim2.new(0, 0, 0, 0),
		BackgroundColor3 = ThemeRegistry.Sidebar,
		BackgroundTransparency = 0.1,
		BorderSizePixel = 0,
		Parent = card,
	})
	Round(topBar, 10)

	local titleLbl = Create("TextLabel", {
		Size = UDim2.new(1, -120, 1, 0),
		Position = UDim2.new(0, 14, 0, 0),
		BackgroundTransparency = 1,
		Text = titleText,
		TextColor3 = ThemeRegistry.Text,
		TextSize = 14,
		Font = Enum.Font.GothamBlack,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = topBar,
	})

	local titleGrad = Create("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, ThemeRegistry.Text),
			ColorSequenceKeypoint.new(0.55, ThemeRegistry.Accent),
			ColorSequenceKeypoint.new(1, ThemeRegistry.Text),
		}),
		Parent = titleLbl,
	})

	local statusPill = Create("Frame", {
		Size = UDim2.new(0, 92, 0, 22),
		Position = UDim2.new(1, -104, 0.5, -11),
		BackgroundColor3 = ThemeRegistry.Row,
		BorderSizePixel = 0,
		Parent = topBar,
	})
	Round(statusPill, 11)

	local pingDot = Create("Frame", {
		Size = UDim2.new(0, 8, 0, 8),
		Position = UDim2.new(0, 8, 0.5, -4),
		BackgroundColor3 = ThemeRegistry.Warn,
		BorderSizePixel = 0,
		Parent = statusPill,
	})
	Round(pingDot, 4)

	local pingLbl = Create("TextLabel", {
		Size = UDim2.new(1, -22, 1, 0),
		Position = UDim2.new(0, 20, 0, 0),
		BackgroundTransparency = 1,
		Text = "PING...",
		TextColor3 = ThemeRegistry.Muted,
		TextSize = 10,
		Font = Enum.Font.GothamBold,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = statusPill,
	})

	Create("TextLabel", {
		Size = UDim2.new(1, -28, 0, 18),
		Position = UDim2.new(0, 14, 0, 52),
		BackgroundTransparency = 1,
		Text = subtitleText,
		TextColor3 = ThemeRegistry.Muted,
		TextSize = 11,
		Font = Enum.Font.Gotham,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = card,
	})

	local inputBoxFrame = Create("Frame", {
		Size = UDim2.new(1, -28, 0, 36),
		Position = UDim2.new(0, 14, 0, 76),
		BackgroundColor3 = ThemeRegistry.Row,
		BorderSizePixel = 0,
		Parent = card,
	})
	Round(inputBoxFrame, 7)

	local inputStroke = Create("UIStroke", {
		Color = ThemeRegistry.Stroke,
		Thickness = 1.2,
		Parent = inputBoxFrame,
	})

	local keyBox = Create("TextBox", {
		Size = UDim2.new(1, -78, 1, 0),
		Position = UDim2.new(0, 10, 0, 0),
		BackgroundTransparency = 1,
		Text = LoadCachedKeyFromDisk(),
		PlaceholderText = "Вставьте ключ (например: NL-MASTER-2026)",
		PlaceholderColor3 = ThemeRegistry.Muted,
		TextColor3 = ThemeRegistry.Text,
		TextSize = 12,
		Font = Enum.Font.GothamMedium,
		TextXAlignment = Enum.TextXAlignment.Left,
		ClearTextOnFocus = false,
		Parent = inputBoxFrame,
	})

	local pasteBtn = Create("TextButton", {
		Size = UDim2.new(0, 62, 0, 24),
		Position = UDim2.new(1, -68, 0.5, -12),
		BackgroundColor3 = ThemeRegistry.Section,
		BorderSizePixel = 0,
		Text = "Paste",
		TextColor3 = ThemeRegistry.Accent,
		TextSize = 11,
		Font = Enum.Font.GothamBold,
		Parent = inputBoxFrame,
	})
	Round(pasteBtn, 5)

	local verifyBtn = Create("TextButton", {
		Size = UDim2.new(0.54, -18, 0, 34),
		Position = UDim2.new(0, 14, 0, 124),
		BackgroundColor3 = ThemeRegistry.Accent,
		BorderSizePixel = 0,
		Text = "Verify Key",
		TextColor3 = Color3.fromRGB(255, 255, 255),
		TextSize = 12,
		Font = Enum.Font.GothamBold,
		Parent = card,
	})
	Round(verifyBtn, 7)

	local getKeyBtn = Create("TextButton", {
		Size = UDim2.new(0.46, -14, 0, 34),
		Position = UDim2.new(0.54, 4, 0, 124),
		BackgroundColor3 = ThemeRegistry.Section,
		BorderSizePixel = 0,
		Text = "Get Key",
		TextColor3 = ThemeRegistry.Text,
		TextSize = 12,
		Font = Enum.Font.GothamBold,
		Parent = card,
	})
	Round(getKeyBtn, 7)
	Create("UIStroke", {
		Color = ThemeRegistry.Stroke,
		Thickness = 1,
		Parent = getKeyBtn,
	})

	local feedbackBar = Create("Frame", {
		Size = UDim2.new(1, -28, 0, 32),
		Position = UDim2.new(0, 14, 0, 174),
		BackgroundColor3 = ThemeRegistry.Sidebar,
		BorderSizePixel = 0,
		Parent = card,
	})
	Round(feedbackBar, 6)

	local feedbackLbl = Create("TextLabel", {
		Size = UDim2.new(1, -16, 1, 0),
		Position = UDim2.new(0, 8, 0, 0),
		BackgroundTransparency = 1,
		Text = "Готов к проверке ключа...",
		TextColor3 = ThemeRegistry.Muted,
		TextSize = 11,
		Font = Enum.Font.GothamMedium,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = feedbackBar,
	})

	BindDraggable(card, topBar, gateMaid)

	gateMaid:GiveTask(keyBox.Focused:Connect(function()
		TweenService:Create(inputStroke, TweenInfo.new(0.18, Enum.EasingStyle.Quint), {
			Color = ThemeRegistry.Accent,
			Thickness = 1.6,
		}):Play()
	end))

	gateMaid:GiveTask(keyBox.FocusLost:Connect(function()
		TweenService:Create(inputStroke, TweenInfo.new(0.18, Enum.EasingStyle.Quint), {
			Color = ThemeRegistry.Stroke,
			Thickness = 1.2,
		}):Play()
	end))

	gateMaid:GiveTask(pasteBtn.MouseButton1Click:Connect(function()
		local clip = ""
		if type(getclipboard) == "function" then
			local ok, val = pcall(getclipboard)
			if ok and type(val) == "string" then
				clip = NormalizeKeyString(val)
			end
		end
		if clip ~= "" then
			keyBox.Text = clip
			feedbackLbl.Text = "Ключ вставлен из буфера обмена."
			feedbackLbl.TextColor3 = ThemeRegistry.Info
		else
			feedbackLbl.Text = "Буфер пуст или getclipboard недоступен."
			feedbackLbl.TextColor3 = ThemeRegistry.Warn
		end
	end))

	gateMaid:GiveTask(getKeyBtn.MouseButton1Click:Connect(function()
		if type(setclipboard) == "function" then
			pcall(setclipboard, getKeyLink)
			feedbackLbl.Text = "Ссылка на получение ключа скопирована!"
			feedbackLbl.TextColor3 = ThemeRegistry.Success
			self:Notify({
				Title = "Get Key",
				Text = "Ссылка скопирована в буфер обмена.",
				Type = "SUCCESS",
			})
		else
			feedbackLbl.Text = "Ссылка: " .. getKeyLink
			feedbackLbl.TextColor3 = ThemeRegistry.Info
			self:Notify({
				Title = "Get Key",
				Text = getKeyLink,
				Type = "INFO",
			})
		end
	end))

	-- Пинг статуса сервера авторизации
	local pingActive = true
	gateMaid:GiveTask(function()
		pingActive = false
	end)
	task.spawn(function()
		while pingActive and gui.Parent do
			local tStart = os.clock()
			local okPing = false
			if keyUrl ~= "" then
				local okReq = SafeHttpGet(keyUrl, 4)
				okPing = okReq
			else
				task.wait(0.05)
				okPing = true
			end
			if not pingActive or not gui.Parent then
				break
			end
			local ms = math.clamp(math.round((os.clock() - tStart) * 1000), 1, 9999)
			if okPing then
				pingDot.BackgroundColor3 = ThemeRegistry.Success
				pingLbl.Text = "ONLINE " .. tostring(ms) .. "ms"
				pingLbl.TextColor3 = ThemeRegistry.Success
			else
				pingDot.BackgroundColor3 = ThemeRegistry.Warn
				pingLbl.Text = "OFFLINE"
				pingLbl.TextColor3 = ThemeRegistry.Warn
			end
			task.wait(10)
		end
	end)

	-- Плавное переливание градиента заголовка
	local gradAngle = 0
	gateMaid:GiveTask(RunService.RenderStepped:Connect(function(dt)
		if gui.Parent then
			gradAngle = (gradAngle + dt * 65) % 360
			titleGrad.Rotation = gradAngle
		end
	end))

	local verifying = false
	local succeeded = false

	local function completeAuth(finalKey)
		if succeeded then
			return
		end
		succeeded = true
		SaveKeyToDisk(finalKey)
		feedbackLbl.Text = "Ключ подтверждён! Запуск интерфейса..."
		feedbackLbl.TextColor3 = ThemeRegistry.Success
		self:Log("Авторизация по ключу пройдена успешно.", "SUCCESS")
		if webhookUrl then
			task.spawn(function()
				self:SendWebhook(
					webhookUrl,
					"Neverlose Key Authorized",
					"Пользователь прошёл проверку ключа и запустил интерфейс.",
					"#2ED573"
				)
			end)
		end

		task.wait(0.35)
		local hideTw = TweenService:Create(scale, TweenInfo.new(0.28, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {
			Scale = 0.82,
		})
		TweenService:Create(card, TweenInfo.new(0.28, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {
			BackgroundTransparency = 1,
		}):Play()
		TweenService:Create(cardStroke, TweenInfo.new(0.22), { Transparency = 1 }):Play()
		hideTw:Play()
		hideTw.Completed:Once(function()
			verifiedSignal:Fire(true)
			gateMaid:Destroy()
		end)
	end

	local function attemptVerify(candidateKey, isAutoCached)
		if verifying or succeeded then
			return
		end
		local clean = NormalizeKeyString(candidateKey)
		if clean == "" then
			feedbackLbl.Text = "Ошибка: введите ключ перед проверкой."
			feedbackLbl.TextColor3 = ThemeRegistry.Error
			return
		end

		verifying = true
		verifyBtn.Active = false
		verifyBtn.BackgroundColor3 = ThemeRegistry.AccentDark

		local animRunning = true
		task.spawn(function()
			local dots = { "Проверка.", "Проверка..", "Проверка..." }
			local idx = 1
			while animRunning and verifyBtn.Parent do
				verifyBtn.Text = dots[idx]
				idx = (idx % #dots) + 1
				task.wait(0.25)
			end
		end)

		local remoteBody = nil
		if keyUrl ~= "" then
			feedbackLbl.Text = isAutoCached and "Проверка сохранённого ключа..." or "Запрос к серверу ключей..."
			feedbackLbl.TextColor3 = ThemeRegistry.Info
			local okGet, bodyOrErr = SafeHttpGet(keyUrl, 7)
			if okGet then
				remoteBody = bodyOrErr
			elseif not isAutoCached then
				feedbackLbl.Text = "Сервер недоступен (" .. tostring(bodyOrErr) .. "), проверка резервного ключа..."
				feedbackLbl.TextColor3 = ThemeRegistry.Warn
			end
		end

		animRunning = false
		verifyBtn.Text = "Verify Key"
		verifyBtn.Active = true
		verifyBtn.BackgroundColor3 = ThemeRegistry.Accent

		if IsValidKeyAgainstSource(clean, remoteBody, fallbackKey) then
			completeAuth(clean)
		else
			verifying = false
			feedbackLbl.Text = "Неверный ключ! Проверьте ввод или нажмите Get Key."
			feedbackLbl.TextColor3 = ThemeRegistry.Error
			self:Log("Попытка входа с неверным ключом.", "WARN")
		end
	end

	gateMaid:GiveTask(verifyBtn.MouseButton1Click:Connect(function()
		attemptVerify(keyBox.Text, false)
	end))

	-- Появление Key Gate
	TweenService:Create(card, TweenInfo.new(0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
		BackgroundTransparency = 0.05,
	}):Play()
	TweenService:Create(scale, TweenInfo.new(0.38, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
		Scale = 1,
	}):Play()
	TweenService:Create(cardStroke, TweenInfo.new(0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
		Transparency = 0.15,
	}):Play()

	-- Автопроверка кэшированного ключа при старте
	if keyBox.Text ~= "" then
		task.defer(function()
			attemptVerify(keyBox.Text, true)
		end)
	end

	local finished = false
	local conn = verifiedSignal:Connect(function()
		finished = true
	end)
	gateMaid:GiveTask(conn)

	while not finished and gui.Parent do
		RunService.Heartbeat:Wait()
	end

	return succeeded
end

-- ============================================================================
-- МОДУЛЬ 3 & 4: ГЛАВНОЕ ОКНО, АДАПТИВНЫЙ LAYOUT, ПРОФИЛЬ И OOP КОМПОНЕНТЫ
-- ============================================================================

local function FormatSessionElapsed(startClock)
	local totalSec = math.max(0, math.floor(os.clock() - startClock))
	local hours = math.floor(totalSec / 3600)
	local minutes = math.floor((totalSec % 3600) / 60)
	local seconds = totalSec % 60
	return string.format("Session: %02d:%02d:%02d", hours, minutes, seconds)
end

local function ComputeResponsiveScale(viewportSize)
	local w = viewportSize.X
	local h = viewportSize.Y
	local targetW = 610
	local targetH = 410
	local ratioW = (w - 24) / targetW
	local ratioH = (h - 24) / targetH
	return math.clamp(math.min(ratioW, ratioH, 1.15), 0.52, 1.15)
end

function Library:CreateWindow(windowConfig)
	windowConfig = windowConfig or {}
	local winTitle = tostring(windowConfig.Title or "NEVERLOSE")
	local winSubtitle = tostring(windowConfig.Subtitle or "v3.4 • Obsidian")
	local sessionStart = os.clock()

	local maid = Maid.new()
	local gui = CreateRootScreenGui(maid, 1000)

	-- Плавающая кнопка быстрого доступа (Floating Mobile Toggle Button)
	local floatBtn = Create("TextButton", {
		Name = "FloatingToggleButton",
		Size = UDim2.new(0, 48, 0, 48),
		Position = UDim2.new(0, 16, 0.5, -24),
		BackgroundColor3 = ThemeRegistry.Sidebar,
		BackgroundTransparency = 0.08,
		BorderSizePixel = 0,
		Text = "NL",
		TextColor3 = ThemeRegistry.Accent,
		TextSize = 14,
		Font = Enum.Font.GothamBlack,
		ZIndex = 50,
		Parent = gui,
	})
	Round(floatBtn, 24)
	local floatStroke = Create("UIStroke", {
		Color = ThemeRegistry.Accent,
		Thickness = 1.6,
		Parent = floatBtn,
	})
	Create("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, ThemeRegistry.Sidebar),
			ColorSequenceKeypoint.new(1, ThemeRegistry.Section),
		}),
		Rotation = 135,
		Parent = floatBtn,
	})

	-- Главное окно (580x380 px базовый размер с адаптивным UIScale)
	local baseWidth = 580
	local baseHeight = 380

	local mainFrame = Create("Frame", {
		Name = "NeverloseMainWindow",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 0),
		Size = UDim2.new(0, baseWidth, 0, baseHeight),
		BackgroundColor3 = ThemeRegistry.Background,
		BackgroundTransparency = 0.06,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Active = true,
		Parent = gui,
	})
	Round(mainFrame, 10)

	local uiScale = Create("UIScale", {
		Scale = ComputeResponsiveScale(workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1280, 720)),
		Parent = mainFrame,
	})

	local mainStroke = Create("UIStroke", {
		Color = ThemeRegistry.Stroke,
		Thickness = 1.2,
		Parent = mainFrame,
	})

	Create("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(10, 16, 30)),
			ColorSequenceKeypoint.new(0.5, Color3.fromRGB(7, 11, 20)),
