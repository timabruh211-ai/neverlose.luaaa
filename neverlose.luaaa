		Library:Log("Нажат бинд аима: " .. tostring(key.Name), "INFO")
	end,
})

AimRight:CreateToggle({
	Name = "Silent Aim",
	Default = false,
	Flag = "Combat_Silent",
	Callback = function(state)
		Library:Log("Silent Aim: " .. tostring(state), "INFO")
	end,
})

AimRight:CreateSlider({
	Name = "FOV Radius",
	Min = 10,
	Max = 500,
	Default = 140,
	Increment = 5,
	Suffix = "px",
	Flag = "Combat_Fov",
})

AimRight:CreateDropdown({
	Name = "Target Priority",
	Options = { "FOV", "Distance", "Lowest HP" },
	Default = "FOV",
	Multi = false,
	Flag = "Combat_Priority",
})

AimRight:CreateParagraph({
	Title = "Combat Notes",
	Content = "Все флаги автоматически регистрируются в Library.Flags и поддерживают сохранение в JSON.",
})

-- 2. VISUALS (Левая и правая секции)
