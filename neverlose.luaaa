	ru={save="Save",saved="Готово",openMenu="Открыть меню",groupMain="Основное",groupSystem="Система",params="парам.",ok="OK",apply="Применить",confirmReset="Подтвердить сброс?",colorPicker="Свой цвет",ready="Готово",
