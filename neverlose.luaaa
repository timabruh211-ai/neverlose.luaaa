--[[
	GLASS HUB — Dark Glassmorphism Sidebar UI (чистый Luau, без внешних картинок)
	PC: RightShift — открыть/закрыть окно. Mobile: плавающая кнопка + drag пальцем.
	Свои функции вставляй в колбэки контролов (помечены "ВСТАВЬ СВОЙ КОД").
]]

--== СЕРВИСЫ ==--
local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local TS = game:GetService("TweenService")
local RS = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local Player = Players.LocalPlayer

--== ТЕМА И СОСТОЯНИЕ ==--
local C = {
	main = Color3.fromRGB(17, 21, 36),
	side = Color3.fromRGB(11, 14, 23),
	card = Color3.fromRGB(24, 30, 50),
	track = Color3.fromRGB(42, 49, 73),
	text = Color3.fromRGB(234, 240, 255),
	sub = Color3.fromRGB(139, 147, 176),
	white = Color3.fromRGB(255, 255, 255),
	green = Color3.fromRGB(52, 211, 153),
}
local ACCENT = Color3.fromRGB(59, 130, 246)
local Flags = {}
local lang = "ru"
local isOpen = true
local baseScale, userScale = 1, 0
local uiScale, openScale, toastScale
local tabs, pages, currentTab = {}, {}, 0
local selectTab, setOpen
local refreshTabs = function() end
local camera = workspace.CurrentCamera
local conns = {}
local function connect(sig, fn)
	local c = sig:Connect(fn)
	table.insert(conns, c)
	return c
end

--== БАЗОВЫЕ ХЕЛПЕРЫ ==--
local function new(class, props)
	local obj = Instance.new(class)
	local parent = props.Parent
	props.Parent = nil
	for k, v in pairs(props) do obj[k] = v end
	if parent then
		obj.Parent = parent
		local layout = parent:FindFirstChildOfClass("UIListLayout")
		if layout and obj:IsA("GuiObject") and obj.LayoutOrder == 0 then
			local n = 0
			for _, ch in ipairs(parent:GetChildren()) do
				if ch:IsA("GuiObject") then n = n + 1 end
			end
			obj.LayoutOrder = n
		end
	end
	return obj
end
local function corner(p, r) return new("UICorner", {Parent = p, CornerRadius = UDim.new(0, r)}) end
local function stroke(p, col, tr, th)
	return new("UIStroke", {Parent = p, Color = col, Transparency = tr, Thickness = th or 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border})
end
local function padding(p, l, r, t, b)
	return new("UIPadding", {Parent = p, PaddingLeft = UDim.new(0, l), PaddingRight = UDim.new(0, r or l), PaddingTop = UDim.new(0, t or l), PaddingBottom = UDim.new(0, b or t or l)})
end
local function vlist(p, gap, valign)
	return new("UIListLayout", {Parent = p, Padding = UDim.new(0, gap or 10), SortOrder = Enum.SortOrder.LayoutOrder, VerticalAlignment = valign or Enum.VerticalAlignment.Top})
end
local function hlist(p, gap, halign)
	return new("UIListLayout", {Parent = p, FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, gap or 8), SortOrder = Enum.SortOrder.LayoutOrder, VerticalAlignment = Enum.VerticalAlignment.Center, HorizontalAlignment = halign or Enum.HorizontalAlignment.Left})
end
local function gloss(p)
	local g = new("Frame", {Parent = p, Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(205, 228, 255), BorderSizePixel = 0, ZIndex = 0})
	new("UIGradient", {Parent = g, Rotation = 45, Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.92), NumberSequenceKeypoint.new(1, 1)})})
	return g
end
local function tw(obj, props, t, style)
	local tween = TS:Create(obj, TweenInfo.new(t or 0.2, style or Enum.EasingStyle.Quart, Enum.EasingDirection.Out), props)
	tween:Play()
	return tween
end

--== АКЦЕНТ: РЕЕСТР + ЖИВАЯ СМЕНА ЦВЕТА ==--
local accentRefs = {}
local function regAccent(obj, prop, getter)
	table.insert(accentRefs, {o = obj, p = prop, g = getter})
end
local function accentSeq()
	return ColorSequence.new({ColorSequenceKeypoint.new(0, ACCENT), ColorSequenceKeypoint.new(1, ACCENT:Lerp(Color3.new(0, 0, 0), 0.55))})
end
local function setAccent(col)
	ACCENT = col
	for _, r in ipairs(accentRefs) do
		if r.o.Parent ~= nil then
			tw(r.o, {[r.p] = r.g and r.g() or ACCENT}, 0.3)
		end
	end
	refreshTabs()
end

