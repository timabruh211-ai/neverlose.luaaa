	local root=new("Frame",{AnchorPoint=Vector2.new(0.5,0.5),Size=UDim2.fromScale(cfg.w,cfg.w),BackgroundTransparency=1},auroraLayer)
	for ring=1,3 do
		local f=new("Frame",{AnchorPoint=Vector2.new(0.5,0.5),Position=UDim2.fromScale(0.5,0.5),Size=UDim2.fromScale(1-ring*0.2,1-ring*0.2),BackgroundTransparency=1-ring*0.18,BorderSizePixel=0},root)
		pill(f)
		tint(f,"BackgroundColor3",i==2 and "violet" or (i==3 and "info" or "accent"))
		tint(new("UIGradient",{Rotation=i*40},f),"Color","gradInfo")
	end
	table.insert(blobs,{root=root,cfg=cfg,phase=i*2.1})
end

