	-- Правая область контента
	local BodyFrame = New("Frame", {
		Name = "BodyFrame",
		Position = UDim2.new(0, 163, 0, 48),
		Size = UDim2.new(1, -173, 1, -58),
		BackgroundColor3 = Color3.fromRGB(11, 14, 24),
		BackgroundTransparency = 0.3,
		BorderSizePixel = 0,
	}, MainFrame)
	New("UICorner", { CornerRadius = UDim.new(0, 8) }, BodyFrame)

	MiniBtn.MouseButton1Click:Connect(function()
		isMinimized = not isMinimized
		Sidebar.Visible = not isMinimized
		Info.Visible = not isMinimized
		BodyFrame.Visible = not isMinimized
		MiniBtn.Text = isMinimized and "+" or "—"
		MainFrame.Size = isMinimized and UDim2.new(0.66, 0, 0, 44) or UDim2.new(0.66, 0, 0.68, 0)
	end)

	-- Верхний индикатор FPS/MS
	local GameInfo = New("Frame", {
		Name = "GameInfo",
		Position = UDim2.new(1, -230, 0, 8),
		Size = UDim2.new(0, 220, 0, 26),
		BackgroundColor3 = Color3.fromRGB(14, 17, 27),
		BackgroundTransparency = 0.2,
		BorderSizePixel = 0,
	}, ScreenGui)
	New("UICorner", { CornerRadius = UDim.new(1, 0) }, GameInfo)
	MakeDraggable(GameInfo, GameInfo)

	local FPSText = New("TextLabel", {
		Position = UDim2.new(0, 10, 0, 0),
		Size = UDim2.new(0.32, 0, 1, 0),
		BackgroundTransparency = 1,
		Text = "0 FPS",
		TextColor3 = Color3.fromRGB(220, 230, 255),
		TextSize = 11,
		Font = Enum.Font.GothamBold,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, GameInfo)

	local MSText = New("TextLabel", {
		Position = UDim2.new(0.34, 0, 0, 0),
		Size = UDim2.new(0.3, 0, 1, 0),
		BackgroundTransparency = 1,
		Text = "0 MS",
		TextColor3 = mainColor,
		TextSize = 11,
		Font = Enum.Font.GothamBold,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, GameInfo)

	New("TextLabel", {
		Position = UDim2.new(0.64, 0, 0, 0),
		Size = UDim2.new(0.34, -6, 1, 0),
		BackgroundTransparency = 1,
		Text = username,
		TextColor3 = Color3.fromRGB(185, 195, 220),
		TextSize = 11,
		Font = Enum.Font.Gotham,
		TextXAlignment = Enum.TextXAlignment.Right,
		TextTruncate = Enum.TextTruncate.AtEnd,
	}, GameInfo)

	local fpsBuffer = {}
	local statsConn = RunService.RenderStepped:Connect(function(dt)
		if not ScreenGui.Parent then return end
		table.insert(fpsBuffer, dt)
		if #fpsBuffer > 20 then table.remove(fpsBuffer, 1) end
		local avg = 0
		for _, v in ipairs(fpsBuffer) do avg += v end
		if avg > 0 then
			FPSText.Text = math.round(#fpsBuffer / avg) .. " FPS"
		end
		pcall(function()
			local pItem = Stats.Network.ServerStatsItem["Data Ping"]
			if pItem then
				MSText.Text = math.round(pItem:GetValue()) .. " MS"
			end
		end)
	end)

	local AcrylicLib = LoadAcrylic()
	local AcrylicBlur = AcrylicLib.new(MainFrame)

	-- ── Построитель контейнера (Section / Accordion / Settings) ─
	local orderCounter = 0
	local function nextOrder()
		orderCounter += 1
		return orderCounter
	end

	local function buildControlsHost(parentContainer)
		local host = {}

		local function addRow(height)
			return New("Frame", {
				Size = UDim2.new(1, 0, 0, height or 32),
				BackgroundColor3 = Color3.fromRGB(20, 24, 38),
				BackgroundTransparency = 0.25,
				BorderSizePixel = 0,
				LayoutOrder = nextOrder(),
			}, parentContainer), New("UICorner", { CornerRadius = UDim.new(0, 6) }, nil)
		end

		local function attachCorner(obj, r)
			New("UICorner", { CornerRadius = UDim.new(0, r or 6) }, obj)
		end

		local function createSettingsModal(titleText)
			local popup = New("Frame", {
				Name = "SettingsPopup",
				Size = UDim2.new(0, 230, 0, 170),
				Position = UDim2.new(0.5, -115, 0.5, -85),
				BackgroundColor3 = Color3.fromRGB(14, 17, 29),
				BorderSizePixel = 0,
				Visible = false,
				ZIndex = 50,
			}, ScreenGui)
			attachCorner(popup, 8)
			MakeDraggable(popup, popup)

			New("TextLabel", {
				Position = UDim2.new(0, 10, 0, 6),
				Size = UDim2.new(1, -40, 0, 20),
				BackgroundTransparency = 1,
				Text = titleText or "Settings",
				TextColor3 = Color3.fromRGB(255, 255, 255),
				TextSize = 12,
				Font = Enum.Font.GothamBold,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd,
				ZIndex = 51,
			}, popup)

			local closeBtn = New("TextButton", {
				Position = UDim2.new(1, -26, 0, 6),
				Size = UDim2.new(0, 20, 0, 20),
				BackgroundColor3 = Color3.fromRGB(32, 38, 58),
				BorderSizePixel = 0,
				Text = "×",
				TextColor3 = Color3.fromRGB(255, 255, 255),
				TextSize = 14,
				Font = Enum.Font.GothamBold,
				ZIndex = 51,
			}, popup)
			attachCorner(closeBtn, 4)

			local scroll = New("ScrollingFrame", {
				Position = UDim2.new(0, 8, 0, 30),
				Size = UDim2.new(1, -16, 1, -38),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				ScrollBarThickness = 2,
				CanvasSize = UDim2.new(0, 0, 0, 0),
				AutomaticCanvasSize = Enum.AutomaticSize.Y,
				ZIndex = 51,
			}, popup)
			New("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, scroll)

			local function closeFn()
				popup.Visible = false
			end
			closeBtn.MouseButton1Click:Connect(closeFn)
			RegisterPopup(popup, closeFn)

			local subHost = buildControlsHost(scroll)
			return {
				Open = function()
					CloseAllPopupsExcept(popup)
					popup.Visible = true
				end,
				Close = closeFn,
				Host = subHost,
			}
		end

		function host:AddToggle(label, default, callback)
			local state = (default == true)
			local row = addRow(32)
			attachCorner(row, 6)

			New("TextLabel", {
				Position = UDim2.new(0, 10, 0, 0),
				Size = UDim2.new(1, -86, 1, 0),
				BackgroundTransparency = 1,
				Text = label or "Toggle",
				TextColor3 = Color3.fromRGB(235, 240, 255),
				TextSize = 12,
				Font = Enum.Font.GothamMedium,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd,
			}, row)

			local sw = New("TextButton", {
				Position = UDim2.new(1, -44, 0.5, -9),
				Size = UDim2.new(0, 34, 0, 18),
				BackgroundColor3 = state and mainColor or Color3.fromRGB(45, 52, 74),
				BorderSizePixel = 0,
				Text = "",
			}, row)
			attachCorner(sw, 9)

			local knob = New("Frame", {
				Position = state and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7),
				Size = UDim2.new(0, 14, 0, 14),
				BackgroundColor3 = Color3.fromRGB(255, 255, 255),
				BorderSizePixel = 0,
			}, sw)
			attachCorner(knob, 7)

			local function setState(v, fire)
				state = (v == true)
				sw.BackgroundColor3 = state and mainColor or Color3.fromRGB(45, 52, 74)
				knob.Position = state and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)
				if fire and callback then
					task.spawn(callback, state)
				end
			end

			sw.MouseButton1Click:Connect(function()
				setState(not state, true)
			end)

			if callback then
				task.spawn(callback, state)
			end

			local api = {
				Set = function(_, v) setState(v, true) end,
				Get = function() return state end,
			}

			function api:AddSettings()
				local gearBtn = New("TextButton", {
					Position = UDim2.new(1, -68, 0.5, -9),
					Size = UDim2.new(0, 18, 0, 18),
					BackgroundColor3 = Color3.fromRGB(32, 38, 58),
					BorderSizePixel = 0,
					Text = "⚙",
					TextColor3 = Color3.fromRGB(200, 210, 235),
					TextSize = 11,
					Font = Enum.Font.GothamBold,
				}, row)
				attachCorner(gearBtn, 5)

				local modal = createSettingsModal(label .. " Settings")
				gearBtn.MouseButton1Click:Connect(modal.Open)
				return modal.Host
			end

			return api
		end

		function host:AddCheckbox(label, default, callback)
			return host:AddToggle(label, default, callback)
		end

		function host:AddSlider(label, minVal, maxVal, defaultVal, callback, suffix)
			minVal = minVal or 0
			maxVal = maxVal or 100
			suffix = suffix or ""
			local val = math.clamp(defaultVal or minVal, minVal, maxVal)

			local row = addRow(42)
			attachCorner(row, 6)

			New("TextLabel", {
				Position = UDim2.new(0, 10, 0, 4),
				Size = UDim2.new(0.68, 0, 0, 16),
				BackgroundTransparency = 1,
				Text = label or "Slider",
				TextColor3 = Color3.fromRGB(235, 240, 255),
				TextSize = 12,
				Font = Enum.Font.GothamMedium,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd,
			}, row)

			local valLbl = New("TextLabel", {
				Position = UDim2.new(0.68, 0, 0, 4),
				Size = UDim2.new(0.32, -28, 0, 16),
				BackgroundTransparency = 1,
				Text = tostring(val) .. suffix,
				TextColor3 = Color3.fromRGB(165, 178, 208),
				TextSize = 11,
				Font = Enum.Font.GothamBold,
				TextXAlignment = Enum.TextXAlignment.Right,
			}, row)

			local track = New("TextButton", {
				Position = UDim2.new(0, 10, 0, 26),
				Size = UDim2.new(1, -20, 0, 8),
				BackgroundColor3 = Color3.fromRGB(38, 44, 64),
				BorderSizePixel = 0,
				Text = "",
			}, row)
			attachCorner(track, 4)

			local fill = New("Frame", {
				Size = UDim2.new((val - minVal) / math.max(maxVal - minVal, 1e-6), 0, 1, 0),
				BackgroundColor3 = mainColor,
				BorderSizePixel = 0,
			}, track)
			attachCorner(fill, 4)

			local sliding = false
			local function setFromX(x)
				local rel = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
				val = math.round(minVal + rel * (maxVal - minVal))
				fill.Size = UDim2.new((val - minVal) / math.max(maxVal - minVal, 1e-6), 0, 1, 0)
				valLbl.Text = tostring(val) .. suffix
				if callback then
					task.spawn(callback, val)
				end
			end

			track.InputBegan:Connect(function(input)
				if isDownInput(input) then
					sliding = true
					setFromX(input.Position.X)
				end
			end)

			UserInputService.InputEnded:Connect(function(input)
				if isDownInput(input) then
					sliding = false
				end
			end)

			UserInputService.InputChanged:Connect(function(input)
				if sliding and isMoveInput(input) then
					setFromX(input.Position.X)
				end
			end)

			local api = {
				Set = function(_, v)
					val = math.clamp(v, minVal, maxVal)
					fill.Size = UDim2.new((val - minVal) / math.max(maxVal - minVal, 1e-6), 0, 1, 0)
					valLbl.Text = tostring(val) .. suffix
				end,
				Get = function() return val end,
			}

			function api:AddSettings()
				local gearBtn = New("TextButton", {
					Position = UDim2.new(1, -26, 0, 4),
					Size = UDim2.new(0, 16, 0, 16),
					BackgroundColor3 = Color3.fromRGB(32, 38, 58),
					BorderSizePixel = 0,
					Text = "⚙",
					TextColor3 = Color3.fromRGB(200, 210, 235),
					TextSize = 10,
					Font = Enum.Font.GothamBold,
				}, row)
				attachCorner(gearBtn, 4)
				local modal = createSettingsModal(label .. " Settings")
				gearBtn.MouseButton1Click:Connect(modal.Open)
				return modal.Host
			end

			return api
		end

		function host:AddDropdown(label, items, callback)
			items = items or {}
			local selected = items[1] or ""
			local row = addRow(34)
			attachCorner(row, 6)

			New("TextLabel", {
				Position = UDim2.new(0, 10, 0, 0),
				Size = UDim2.new(0.45, 0, 1, 0),
				BackgroundTransparency = 1,
				Text = label or "Dropdown",
				TextColor3 = Color3.fromRGB(235, 240, 255),
				TextSize = 12,
				Font = Enum.Font.GothamMedium,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd,
			}, row)

			local dropBtn = New("TextButton", {
				Position = UDim2.new(0.48, 0, 0.5, -11),
				Size = UDim2.new(0.52, -32, 0, 22),
				BackgroundColor3 = Color3.fromRGB(30, 36, 54),
				BorderSizePixel = 0,
				Text = tostring(selected) .. " ▾",
				TextColor3 = Color3.fromRGB(220, 230, 255),
				TextSize = 11,
				Font = Enum.Font.GothamMedium,
				TextTruncate = Enum.TextTruncate.AtEnd,
			}, row)
			attachCorner(dropBtn, 5)

			local listFrame = New("Frame", {
				Size = UDim2.new(0, 160, 0, math.min(#items * 24 + 6, 150)),
				BackgroundColor3 = Color3.fromRGB(16, 20, 34),
				BorderSizePixel = 0,
				Visible = false,
				ZIndex = 60,
			}, ScreenGui)
			attachCorner(listFrame, 6)

			local listScroll = New("ScrollingFrame", {
				Size = UDim2.new(1, -4, 1, -4),
				Position = UDim2.new(0, 2, 0, 2),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				ScrollBarThickness = 2,
				CanvasSize = UDim2.new(0, 0, 0, 0),
				AutomaticCanvasSize = Enum.AutomaticSize.Y,
				ZIndex = 61,
			}, listFrame)
			New("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }, listScroll)

			local function closeMenu()
				listFrame.Visible = false
			end
			RegisterPopup(listFrame, closeMenu)

			for idx, item in ipairs(items) do
				local optBtn = New("TextButton", {
					Size = UDim2.new(1, 0, 0, 22),
					BackgroundColor3 = Color3.fromRGB(24, 29, 46),
					BackgroundTransparency = 0.2,
					BorderSizePixel = 0,
					Text = tostring(item),
					TextColor3 = Color3.fromRGB(235, 240, 255),
					TextSize = 11,
					Font = Enum.Font.Gotham,
					LayoutOrder = idx,
					ZIndex = 62,
				}, listScroll)
				attachCorner(optBtn, 4)

				optBtn.MouseButton1Click:Connect(function()
					selected = item
					dropBtn.Text = tostring(selected) .. " ▾"
					closeMenu()
					if callback then
						task.spawn(callback, selected)
					end
				end)
			end

			dropBtn.MouseButton1Click:Connect(function()
				if listFrame.Visible then
					closeMenu()
				else
					CloseAllPopupsExcept(listFrame)
					local absPos = dropBtn.AbsolutePosition
					local absSize = dropBtn.AbsoluteSize
					listFrame.Size = UDim2.new(0, math.max(absSize.X, 120), 0, math.min(#items * 24 + 6, 150))
					listFrame.Position = UDim2.new(0, absPos.X, 0, absPos.Y + absSize.Y + 2)
					listFrame.Visible = true
				end
			end)

			local api = {
				Get = function() return selected end,
				Set = function(_, v)
					selected = v
					dropBtn.Text = tostring(selected) .. " ▾"
				end,
			}

			function api:AddSettings()
				local gearBtn = New("TextButton", {
					Position = UDim2.new(1, -26, 0.5, -9),
					Size = UDim2.new(0, 18, 0, 18),
					BackgroundColor3 = Color3.fromRGB(32, 38, 58),
					BorderSizePixel = 0,
					Text = "⚙",
					TextColor3 = Color3.fromRGB(200, 210, 235),
					TextSize = 11,
					Font = Enum.Font.GothamBold,
				}, row)
				attachCorner(gearBtn, 5)
				local modal = createSettingsModal(label .. " Settings")
				gearBtn.MouseButton1Click:Connect(modal.Open)
				return modal.Host
			end

			return api
		end

		function host:AddAccordion(titleText)
			local container = New("Frame", {
				Size = UDim2.new(1, 0, 0, 28),
				BackgroundColor3 = Color3.fromRGB(17, 21, 34),
				BackgroundTransparency = 0.2,
				BorderSizePixel = 0,
				AutomaticSize = Enum.AutomaticSize.Y,
				LayoutOrder = nextOrder(),
			}, parentContainer)
			attachCorner(container, 6)

			local headerBtn = New("TextButton", {
				Size = UDim2.new(1, 0, 0, 28),
				BackgroundTransparency = 1,
				Text = "▸ " .. (titleText or "Accordion"),
				TextColor3 = Color3.fromRGB(215, 225, 250),
				TextSize = 12,
				Font = Enum.Font.GothamBold,
				TextXAlignment = Enum.TextXAlignment.Left,
			}, container)
			New("UIPadding", { PaddingLeft = UDim.new(0, 8) }, headerBtn)

			local inner = New("Frame", {
				Position = UDim2.new(0, 6, 0, 30),
				Size = UDim2.new(1, -12, 0, 0),
				BackgroundTransparency = 1,
				AutomaticSize = Enum.AutomaticSize.Y,
				Visible = false,
			}, container)
			New("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, inner)
			New("UIPadding", { PaddingBottom = UDim.new(0, 6) }, inner)

			local expanded = false
			headerBtn.MouseButton1Click:Connect(function()
				expanded = not expanded
				inner.Visible = expanded
				headerBtn.Text = (expanded and "▾ " or "▸ ") .. (titleText or "Accordion")
			end)

			return buildControlsHost(inner)
		end

		function host:AddToggleColorpicker(label, defaultToggle, defaultColor, toggleCb, colorCb)
			local currentColor = defaultColor or Color3.fromRGB(255, 255, 255)
			local palette = {
				Color3.fromRGB(255, 255, 255),
				Color3.fromRGB(255, 85, 85),
				Color3.fromRGB(85, 255, 130),
				Color3.fromRGB(70, 155, 255),
				Color3.fromRGB(255, 210, 75),
				Color3.fromRGB(190, 95, 255),
			}
			local pIdx = 1

			local tApi = host:AddToggle(label, defaultToggle, toggleCb)
			local row = parentContainer:GetChildren()[#parentContainer:GetChildren()]

			local cpBtn = New("TextButton", {
				Position = UDim2.new(1, -92, 0.5, -8),
				Size = UDim2.new(0, 16, 0, 16),
				BackgroundColor3 = currentColor,
				BorderSizePixel = 0,
				Text = "",
			}, row)
			attachCorner(cpBtn, 4)

			cpBtn.MouseButton1Click:Connect(function()
				pIdx = (pIdx % #palette) + 1
				currentColor = palette[pIdx]
				cpBtn.BackgroundColor3 = currentColor
				if colorCb then
					task.spawn(colorCb, currentColor)
				end
			end)

			return tApi
		end

		function host:AddDropdownColorpicker(label, items, defaultColor, callback, colorCb)
			local dApi = host:AddDropdown(label, items, callback)
			local currentColor = defaultColor or Color3.fromRGB(255, 255, 255)
			local palette = {
				Color3.fromRGB(255, 255, 255),
				Color3.fromRGB(255, 85, 85),
				Color3.fromRGB(85, 255, 130),
				Color3.fromRGB(70, 155, 255),
				Color3.fromRGB(255, 210, 75),
			}
			local pIdx = 1

			local row
			for _, child in ipairs(parentContainer:GetChildren()) do
				if child:IsA("Frame") then row = child end
			end

			if row then
				local cpBtn = New("TextButton", {
					Position = UDim2.new(1, -24, 0.5, -8),
					Size = UDim2.new(0, 16, 0, 16),
					BackgroundColor3 = currentColor,
					BorderSizePixel = 0,
					Text = "",
				}, row)
				attachCorner(cpBtn, 4)

				cpBtn.MouseButton1Click:Connect(function()
					pIdx = (pIdx % #palette) + 1
					currentColor = palette[pIdx]
					cpBtn.BackgroundColor3 = currentColor
					if colorCb then
						task.spawn(colorCb, currentColor)
					end
				end)
			end

			return dApi
		end

		return host
	end

	-- ── Tabs, SubTabs & Sections ───────────────────────────────
	local WindowObj = {}
	local tabs = {}
	local activeTab = nil

	local function buildPageBody()
		local page = New("ScrollingFrame", {
			Size = UDim2.new(1, 0, 1, 0),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ScrollBarThickness = 3,
			CanvasSize = UDim2.new(0, 0, 0, 0),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			Visible = false,
		}, BodyFrame)

		local leftCol = New("Frame", {
			Name = "LeftColumn",
			Position = UDim2.new(0, 8, 0, 8),
			Size = UDim2.new(0.5, -12, 0, 0),
			BackgroundTransparency = 1,
			AutomaticSize = Enum.AutomaticSize.Y,
		}, page)
		New("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }, leftCol)

		local rightCol = New("Frame", {
			Name = "RightColumn",
			Position = UDim2.new(0.5, 4, 0, 8),
			Size = UDim2.new(0.5, -12, 0, 0),
			BackgroundTransparency = 1,
			AutomaticSize = Enum.AutomaticSize.Y,
		}, page)
		New("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }, rightCol)

		local pageApi = {}

		function pageApi:AddSection(secTitle, side)
			local col = (tostring(side or "left"):lower() == "right") and rightCol or leftCol
			local secFrame = New("Frame", {
				Name = "Section_" .. tostring(secTitle),
				Size = UDim2.new(1, 0, 0, 34),
				BackgroundColor3 = Color3.fromRGB(15, 18, 30),
				BackgroundTransparency = 0.2,
				BorderSizePixel = 0,
				AutomaticSize = Enum.AutomaticSize.Y,
				LayoutOrder = nextOrder(),
			}, col)
			New("UICorner", { CornerRadius = UDim.new(0, 7) }, secFrame)

			New("TextLabel", {
				Position = UDim2.new(0, 10, 0, 6),
				Size = UDim2.new(1, -20, 0, 16),
				BackgroundTransparency = 1,
				Text = string.upper(tostring(secTitle or "SECTION")),
				TextColor3 = Color3.fromRGB(130, 145, 180),
				TextSize = 10,
				Font = Enum.Font.GothamBold,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd,
			}, secFrame)

			local list = New("Frame", {
				Position = UDim2.new(0, 8, 0, 26),
				Size = UDim2.new(1, -16, 0, 0),
				BackgroundTransparency = 1,
				AutomaticSize = Enum.AutomaticSize.Y,
			}, secFrame)
			New("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, list)
			New("UIPadding", { PaddingBottom = UDim.new(0, 8) }, list)

			return buildControlsHost(list)
		end

		return page, pageApi
	end

	function WindowObj:AddTabLabel(text)
		New("TextLabel", {
			Size = UDim2.new(1, 0, 0, 18),
			BackgroundTransparency = 1,
			Text = string.upper(tostring(text or "")),
			TextColor3 = Color3.fromRGB(115, 128, 160),
			TextSize = 10,
			Font = Enum.Font.GothamBold,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			LayoutOrder = nextOrder(),
		}, Sidebar)
	end

	local function activateTab(tabEntry)
		if activeTab == tabEntry then return end
		activeTab = tabEntry
		for _, t in ipairs(tabs) do
			local isSel = (t == tabEntry)
			t.Button.BackgroundColor3 = isSel and mainColor or Color3.fromRGB(18, 22, 36)
			t.Button.BackgroundTransparency = isSel and 0.15 or 0.5
			if t.SubBar then
				t.SubBar.Visible = isSel
			end
			if t.DefaultPage then
				t.DefaultPage.Visible = isSel and not t.ActiveSubPage
			end
			if t.ActiveSubPage then
				t.ActiveSubPage.Visible = isSel
			end
		end
	end

	function WindowObj:AddTab(title, iconName)
		local btn = New("TextButton", {
			Size = UDim2.new(1, 0, 0, 30),
			BackgroundColor3 = Color3.fromRGB(18, 22, 36),
			BackgroundTransparency = 0.5,
			BorderSizePixel = 0,
			Text = "",
			AutoButtonColor = false,
			LayoutOrder = nextOrder(),
		}, Sidebar)
		New("UICorner", { CornerRadius = UDim.new(0, 6) }, btn)

		local icon = New("ImageLabel", {
			Position = UDim2.new(0, 8, 0.5, -8),
			Size = UDim2.new(0, 16, 0, 16),
			BackgroundTransparency = 1,
			ImageColor3 = Color3.fromRGB(255, 255, 255),
		}, btn)
		GetImageData(iconName or "home", icon)

		New("TextLabel", {
			Position = UDim2.new(0, 28, 0, 0),
			Size = UDim2.new(1, -32, 1, 0),
			BackgroundTransparency = 1,
			Text = title or "Tab",
			TextColor3 = Color3.fromRGB(240, 244, 255),
			TextSize = 12,
			Font = Enum.Font.GothamMedium,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
		}, btn)

		local defaultPageFrame, defaultPageApi = buildPageBody()
		local subBar = New("Frame", {
			Size = UDim2.new(1, -16, 0, 28),
			Position = UDim2.new(0, 8, 0, 6),
			BackgroundColor3 = Color3.fromRGB(16, 20, 34),
			BackgroundTransparency = 0.2,
			BorderSizePixel = 0,
			Visible = false,
			ZIndex = 5,
		}, BodyFrame)
		New("UICorner", { CornerRadius = UDim.new(0, 6) }, subBar)
		New("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, subBar)
		New("UIPadding", { PaddingLeft = UDim.new(0, 6), PaddingTop = UDim.new(0, 4) }, subBar)

		local entry = {
			Button = btn,
			DefaultPage = defaultPageFrame,
			SubBar = subBar,
			SubPages = {},
			ActiveSubPage = nil,
		}
		table.insert(tabs, entry)

		btn.MouseButton1Click:Connect(function()
			activateTab(entry)
		end)

		if #tabs == 1 then
			activateTab(entry)
		end

		local tabApi = {}

		function tabApi:AddSection(secTitle, side)
			return defaultPageApi:AddSection(secTitle, side)
		end

		function tabApi:AddSubTab(subTitle, subIcon)
			local subPageFrame, subPageApi = buildPageBody()
			subPageFrame.Position = UDim2.new(0, 0, 0, 34)
			subPageFrame.Size = UDim2.new(1, 0, 1, -34)

			local subBtn = New("TextButton", {
				Size = UDim2.new(0, 96, 0, 20),
				BackgroundColor3 = Color3.fromRGB(26, 32, 52),
				BorderSizePixel = 0,
				Text = subTitle or "SubTab",
				TextColor3 = Color3.fromRGB(220, 230, 255),
				TextSize = 11,
				Font = Enum.Font.GothamMedium,
				TextTruncate = Enum.TextTruncate.AtEnd,
				LayoutOrder = nextOrder(),
			}, subBar)
			New("UICorner", { CornerRadius = UDim.new(0, 5) }, subBtn)

			local function selectSub()
				defaultPageFrame.Visible = false
				for _, sp in ipairs(entry.SubPages) do
					local active = (sp.Frame == subPageFrame)
					sp.Frame.Visible = (activeTab == entry) and active
					sp.Btn.BackgroundColor3 = active and mainColor or Color3.fromRGB(26, 32, 52)
				end
				entry.ActiveSubPage = subPageFrame
			end

			table.insert(entry.SubPages, { Frame = subPageFrame, Btn = subBtn })
			subBtn.MouseButton1Click:Connect(selectSub)

			if #entry.SubPages == 1 then
				selectSub()
			end

			return subPageApi
		end

		return tabApi
	end

	function WindowObj:Destroy()
		if statsConn then statsConn:Disconnect() end
		if AcrylicBlur and AcrylicBlur.Destroy then pcall(AcrylicBlur.Destroy) end
		if ScreenGui then ScreenGui:Destroy() end
	end

	return WindowObj
end

return Library
