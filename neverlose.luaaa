local textBinds = {}
local function tr(key)
	local e = L[key]
	return e and e[lang] or key
end
local function bindText(obj, keyOrFn)
	table.insert(textBinds, {o = obj, k = keyOrFn})
	obj.Text = type(keyOrFn) == "function" and keyOrFn() or tr(keyOrFn)
end
local function setLang(l)
	lang = l
	for _, b in ipairs(textBinds) do
		b.o.Text = type(b.k) == "function" and b.k() or tr(b.k)
	end
end

--== АДАПТИВНЫЙ МАСШТАБ (UIScale под телефон/ПК) ==--
local function updateScale()
	local vp = camera.ViewportSize
	baseScale = math.clamp(math.min(vp.X / 920, vp.Y / 640), 0.5, 1)
	if userScale > 0 then baseScale = math.clamp(baseScale * userScale, 0.4, 1.4) end
	if uiScale then uiScale.Scale = isOpen and baseScale or baseScale * 0.92 end
	if openScale then openScale.Scale = math.max(baseScale, 0.75) end
	if toastScale then toastScale.Scale = math.max(baseScale, 0.7) end
end
local vpConn
local function hookCamera()
	camera = workspace.CurrentCamera
	if vpConn then vpConn:Disconnect() end
	vpConn = connect(camera:GetPropertyChangedSignal("ViewportSize"), updateScale)
	updateScale()
end
connect(workspace:GetPropertyChangedSignal("CurrentCamera"), hookCamera)

--== СОЗДАНИЕ ScreenGui (с защитой от дублей) ==--
local function killOld(parent)
	if parent then
		local old = parent:FindFirstChild("GlassHubUI")
		if old then old:Destroy() end
	end
end
local okHui, hui = pcall(function() return gethui and gethui() end)
if okHui and hui then killOld(hui) end
pcall(function() killOld(game:GetService("CoreGui")) end)
killOld(Player:FindFirstChildOfClass("PlayerGui"))
local gui = new("ScreenGui", {Name = "GlassHubUI", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 999, ZIndexBehavior = Enum.ZIndexBehavior.Sibling})
local parented = false
if okHui and hui then gui.Parent = hui parented = true end
if not parented then parented = pcall(function() gui.Parent = game:GetService("CoreGui") end) end
if not parented then gui.Parent = Player:WaitForChild("PlayerGui") end

--== СТЕКЛЯННЫЕ УВЕДОМЛЕНИЯ (тосты) ==--
local toastHolder = new("Frame", {Parent = gui, Size = UDim2.fromOffset(280, 0), Position = UDim2.new(1, -16, 1, -16), AnchorPoint = Vector2.new(1, 1), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1})
toastScale = new("UIScale", {Parent = toastHolder, Scale = 1})
new("UIListLayout", {Parent = toastHolder, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, VerticalAlignment = Enum.VerticalAlignment.Bottom})
local toastN = 0
local function notify(title, text)
	toastN = toastN + 1
	local t = new("CanvasGroup", {Parent = toastHolder, Size = UDim2.new(1, 0, 0, 0), BackgroundColor3 = C.card, BackgroundTransparency = 0.12, BorderSizePixel = 0, ClipsDescendants = true, GroupTransparency = 1, LayoutOrder = toastN})
	corner(t, 8)
	regAccent(stroke(t, ACCENT, 0.5, 1.2), "Color")
	gloss(t)
	local bar = new("Frame", {Parent = t, Size = UDim2.new(0, 3, 1, 0), BackgroundColor3 = ACCENT, BorderSizePixel = 0})
	regAccent(bar, "BackgroundColor3")
	new("TextLabel", {Parent = t, Position = UDim2.fromOffset(15, 8), Size = UDim2.new(1, -26, 0, 16), BackgroundTransparency = 1, Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = C.text, Text = title, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd})
	new("TextLabel", {Parent = t, Position = UDim2.fromOffset(15, 26), Size = UDim2.new(1, -26, 0, 26), BackgroundTransparency = 1, Font = Enum.Font.Gotham, TextSize = 11, TextColor3 = C.sub, Text = text, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, TextWrapped = true})
	tw(t, {Size = UDim2.new(1, 0, 0, 58), GroupTransparency = 0}, 0.3, Enum.EasingStyle.Back)
	task.delay(3.5, function()
		tw(t, {Size = UDim2.new(1, 0, 0, 0), GroupTransparency = 1}, 0.25)
		task.delay(0.3, function() t:Destroy() end)
	end)
end

--== ПЛАВНОЕ ПЕРЕТАСКИВАНИЕ (мышь + палец, lerp через RenderStepped) ==--
local function makeDraggable(obj, handle, getScale, onTap)
	local dragging, activeInput, startInput, startPos, targetPos, moved = false, nil, nil, nil, nil, 0
	handle.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging, activeInput, startInput = true, i, i.Position
			startPos, targetPos, moved = obj.Position, obj.Position, 0
		end
	end)
	connect(UIS.InputChanged, function(i)
		if dragging and (i == activeInput or i.UserInputType == Enum.UserInputType.MouseMovement) then
			local s = getScale()
			local d = i.Position - startInput
			moved = math.max(moved, math.abs(d.X) + math.abs(d.Y))
			targetPos = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X / s, startPos.Y.Scale, startPos.Y.Offset + d.Y / s)
		end
	end)
	connect(UIS.InputEnded, function(i)
		if i == activeInput then
			dragging, activeInput = false, nil
			tw(obj, {Position = targetPos}, 0.12)
			if onTap and moved < 8 then onTap() end
		end
	end)
	connect(RS.RenderStepped, function(dt)
		if dragging and gui.Parent then
			local c = obj.Position
			local a = 1 - math.exp(-dt * 20)
			obj.Position = UDim2.new(c.X.Scale + (targetPos.X.Scale - c.X.Scale) * a, c.X.Offset + (targetPos.X.Offset - c.X.Offset) * a, c.Y.Scale + (targetPos.Y.Scale - c.Y.Scale) * a, c.Y.Offset + (targetPos.Y.Offset - c.Y.Offset) * a)
		end
	end)
end

