	local collapseBtn = Create("TextButton", {
		Size = UDim2.new(0, 66, 0, 24),
		Position = UDim2.new(1, -72, 0.5, -12),
		BackgroundColor3 = ThemeRegistry.Row,
		BorderSizePixel = 0,
		Text = "Hide",
		TextColor3 = ThemeRegistry.Accent,
		TextSize = 11,
