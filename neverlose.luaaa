function updateToastPos()
	local p=state.notifPos
	if p=="br" then toastBox.AnchorPoint=Vector2.new(1,1); toastBox.Position=UDim2.new(1,-18,1,-18)
	elseif p=="bl" then toastBox.AnchorPoint=Vector2.new(0,1); toastBox.Position=UDim2.new(0,18,1,-18)
	elseif p=="tr" then toastBox.AnchorPoint=Vector2.new(1,0); toastBox.Position=UDim2.new(1,-18,0,18)
	else toastBox.AnchorPoint=Vector2.new(.5,0); toastBox.Position=UDim2.new(.5,0,0,18) end
end
function toast(kind,title,msg)
	if not state.notifEnabled then return end
	local gate={success="notifSuccess",info="notifInfo",warning="notifWarning",error="notifError"}[kind]
	if gate and not state[gate] then return end
	if not state.notifStack then clearGui(toastBox) end
	local count=0
	for _,c in ipairs(toastBox:GetChildren()) do if c:IsA("GuiObject") then count+=1 end end
	while count>=state.notifMax do
		local first
		for _,c in ipairs(toastBox:GetChildren()) do if c:IsA("GuiObject") then first=c break end end
		if first then first:Destroy(); count-=1 else break end
	end
	toastSeq+=1
	local g=makeGroup({Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,BackgroundTransparency=1,GroupTransparency=1,LayoutOrder=toastSeq},toastBox)
	local card=new("Frame",{Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,BorderSizePixel=0},g)
	corner(card,8); tint(card,"BackgroundColor3","card"); tint(stroke(card),"Color","line"); pad(card,12,12,12,12)
	local icn=({success="check",info="info",warning="alert",error="x"})[kind] or "info"
	local mode=({success="ok",info="info",warning="warn",error="err"})[kind] or "info"
	local ib=new("Frame",{Size=UDim2.fromOffset(28,28),BorderSizePixel=0},card); corner(ib,7); tint(ib,"BackgroundColor3","soft")
	local ih=icon(icn,ib,15,mode); ih.AnchorPoint=Vector2.new(.5,.5); ih.Position=UDim2.fromScale(.5,.5)
	local tf=new("Frame",{Position=UDim2.fromOffset(38,0),Size=UDim2.new(1,-62,0,0),AutomaticSize=Enum.AutomaticSize.Y,BackgroundTransparency=1},card)
	local tl=new("TextLabel",{Size=UDim2.new(1,0,0,16),BackgroundTransparency=1,Text=title,TextSize=12.5,Font=Enum.Font.GothamBold,TextXAlignment=Enum.TextXAlignment.Left,TextTruncate=Enum.TextTruncate.AtEnd},tf); tint(tl,"TextColor3","white")
	local ml=new("TextLabel",{Position=UDim2.fromOffset(0,18),Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,BackgroundTransparency=1,Text=msg,TextSize=11.5,Font=Enum.Font.GothamMedium,TextXAlignment=Enum.TextXAlignment.Left,TextWrapped=true},tf); tint(ml,"TextColor3","muted")
	local xb=new("TextButton",{AnchorPoint=Vector2.new(1,0),Position=UDim2.new(1,0,0,0),Size=UDim2.fromOffset(20,20),BackgroundTransparency=1,Text="",AutoButtonColor=false},card)
	local xi=icon("x",xb,11,"dim"); xi.AnchorPoint=Vector2.new(.5,.5); xi.Position=UDim2.fromScale(.5,.5)
	local bar=new("Frame",{AnchorPoint=Vector2.new(0,1),Position=UDim2.new(0,0,1,0),Size=UDim2.new(1,0,0,2),BorderSizePixel=0},card); tint(bar,"BackgroundColor3",mode)
	fadeGroup(g,0,.28); playSound(kind)
	local dur=state.notifDuration
	local start,remaining,gone,timer=os.clock(),dur,false,nil
	local function dismiss()
		if gone then return end
		gone=true
		if timer then task.cancel(timer) end
		fadeGroup(g,1,.22)
		task.delay(.25,function() if g.Parent then g:Destroy() end end)
	end
	timer=task.delay(dur,dismiss)
	tw(bar,{Size=UDim2.new(0,0,0,2)},dur)
	xb.Activated:Connect(dismiss)
	card.MouseEnter:Connect(function()
		if state.notifHover and not gone then
			if timer then task.cancel(timer) end
			remaining=math.max(.4,remaining-(os.clock()-start))
			bar.Size=UDim2.new(math.clamp(remaining/dur,0,1),0,0,2)
		end
	end)
	card.MouseLeave:Connect(function()
		if state.notifHover and not gone then
			start=os.clock(); timer=task.delay(remaining,dismiss)
			tw(bar,{Size=UDim2.new(0,0,0,2)},remaining)
		end
	end)
end

function closePop()
	if popNode then popNode:Destroy(); popNode=nil end
	if popScrim then popScrim:Destroy(); popScrim=nil end
end
function openPop(anchor,width,build)
	closePop()
	popScrim=new("TextButton",{Size=UDim2.fromScale(1,1),BackgroundTransparency=1,Text="",AutoButtonColor=false},popLayer)
	popScrim.Activated:Connect(closePop)
	popNode=new("Frame",{Size=UDim2.fromOffset(width,0),AutomaticSize=Enum.AutomaticSize.Y,BorderSizePixel=0},popLayer)
	corner(popNode,8); tint(popNode,"BackgroundColor3","card"); tint(stroke(popNode),"Color","line"); pad(popNode,8,8,8,8); list(popNode,nil,4)
	build(popNode)
	local i=0
	for _,c in ipairs(popNode:GetChildren()) do if c:IsA("GuiObject") then i+=1; c.LayoutOrder=i end end
	task.defer(function()
		if not popNode then return end
		local v=camera and camera.ViewportSize or Vector2.new(1280,720)
		local ap,as,ps=anchor.AbsolutePosition,anchor.AbsoluteSize,popNode.AbsoluteSize
		local x=math.clamp(ap.X+as.X-ps.X,8,math.max(8,v.X-ps.X-8))
		local y=ap.Y+as.Y+6
		if y+ps.Y>v.Y-8 then y=math.max(8,ap.Y-ps.Y-6) end
		popNode.Position=UDim2.fromOffset(x,y)
	end)
end
function closeModal() if modalNode then modalNode:Destroy(); modalNode=nil end end
function openModal(title,icn,body,extra)
	closeModal(); closePop()
	modalNode=new("Frame",{Size=UDim2.fromScale(1,1),BackgroundColor3=Color3.new(0,0,0),BackgroundTransparency=.55,BorderSizePixel=0},popLayer)
	local mb=new("TextButton",{Size=UDim2.fromScale(1,1),BackgroundTransparency=1,Text="",AutoButtonColor=false},modalNode)
	mb.Activated:Connect(closeModal)
	local m=new("Frame",{AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromScale(.5,.5),Size=UDim2.fromOffset(math.min(480,(camera and camera.ViewportSize.X or 1280)-32),0),AutomaticSize=Enum.AutomaticSize.Y,BorderSizePixel=0},modalNode)
	corner(m,10); tint(m,"BackgroundColor3","card"); tint(stroke(m),"Color","line"); pad(m,18,18,18,18); list(m,nil,10)
	local head=new("Frame",{Size=UDim2.new(1,0,0,24),BackgroundTransparency=1,LayoutOrder=1},m)
	local hh=icon(icn,head,18,"accent2"); hh.Position=UDim2.fromOffset(0,3)
	local ht=new("TextLabel",{Position=UDim2.fromOffset(26,0),Size=UDim2.new(1,-26,1,0),BackgroundTransparency=1,Text=title,TextSize=15,Font=Enum.Font.GothamBold,TextXAlignment=Enum.TextXAlignment.Left},head); tint(ht,"TextColor3","white")
	local order=1
	for _,text in ipairs(body) do
		order+=1
		local p=new("TextLabel",{Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,BackgroundTransparency=1,Text=text,TextSize=12,Font=Enum.Font.GothamMedium,TextXAlignment=Enum.TextXAlignment.Left,TextWrapped=true,LayoutOrder=order},m)
		tint(p,"TextColor3","muted")
	end
	if extra then extra(m,function() order+=1; return order end) end
	order+=1
	local okb=new("TextButton",{Size=UDim2.new(1,0,0,34),Text=t("ok"),TextSize=12,Font=Enum.Font.GothamBold,AutoButtonColor=false,LayoutOrder=order},m)
	corner(okb,7); tint(okb,"BackgroundColor3","accent"); tint(okb,"TextColor3","white")
	okb.Activated:Connect(function() playSound("click"); closeModal() end)
end

function markDirty()
	dirty=true; dirtyDot.Visible=true
	if state.autoSave then
		if autoTimer then task.cancel(autoTimer) end
		autoTimer=task.delay(.8,function() if dirty then persist(true) end end)
	end
end
function persist(silent)
	local ok,enc=pcall(function() return HttpService:JSONEncode(state) end)
	if ok then gui:SetAttribute("Config",enc) end
	dirty=false; dirtyDot.Visible=false
	if remote then pcall(function() remote:FireServer(enc) end) end
	if not silent then
		saveLabel.Text=t("saved"); saveIco.Visible=false
		task.delay(1.3,function() if saveLabel.Parent then saveLabel.Text=t("save"); saveIco.Visible=true end end)
		toast("success",t("savedTitle"),t("savedMsg"))
	end
	for _,e in ipairs(liveInfo) do if e.o.Parent then e.o.Text=e.f() end end
end
function setState(id,v)
	if state[id]==v then return end
	state[id]=v; markDirty(); applyLive(id)
end

local function rowBase(parent,h) return new("Frame",{Size=UDim2.new(1,0,0,h or rowH()),BackgroundTransparency=1},parent) end
local function rowLabel(parent,text,off)
	local l=new("TextLabel",{Size=UDim2.new(1,off or -112,1,0),Position=UDim2.fromOffset(2,0),BackgroundTransparency=1,Text=text,TextSize=12.5,Font=Enum.Font.GothamMedium,TextXAlignment=Enum.TextXAlignment.Left,TextTruncate=Enum.TextTruncate.AtEnd},parent)
	tint(l,"TextColor3","label"); return l
end
local function gearButton(parent,row,right)
	local g=new("TextButton",{AnchorPoint=Vector2.new(1,.5),Position=UDim2.new(1,right,.5,0),Size=UDim2.fromOffset(24,24),BackgroundTransparency=1,Text="",AutoButtonColor=false},parent)
	local gi=icon("gear",g,14,"dim"); gi.AnchorPoint=Vector2.new(.5,.5); gi.Position=UDim2.fromScale(.5,.5)
	g.Activated:Connect(function()
		playSound("click")
		openPop(g,252,function(p)
			local h=new("TextLabel",{Size=UDim2.new(1,0,0,20),BackgroundTransparency=1,Text=lab(row.label),TextSize=10,Font=Enum.Font.GothamBold,TextXAlignment=Enum.TextXAlignment.Left},p)
			tint(h,"TextColor3","accent2")
			for _,gr in ipairs(row.gear) do buildRow(p,gr,true) end
		end)
	end)
	return g
end
local function toggleRow(parent,row)
	local r=rowBase(parent)
	rowLabel(r,lab(row.label),row.gear and -152 or -112)
	if row.gear then gearButton(r,row,-52) end
	local sw=new("TextButton",{AnchorPoint=Vector2.new(1,.5),Position=UDim2.new(1,-6,.5,0),Size=UDim2.fromOffset(42,23),Text="",AutoButtonColor=false},r)
	pill(sw); tint(stroke(sw),"Color","line")
	local knob=new("Frame",{Size=UDim2.fromOffset(17,17),Position=UDim2.fromOffset(2,3),BackgroundColor3=Color3.new(1,1,1),BorderSizePixel=0},sw); pill(knob)
	local function paintSw()
		local on=state[row.id]
		sw.BackgroundColor3=on and accent() or modeColor("off")
		tw(knob,{Position=UDim2.fromOffset(on and 23 or 2,3)})
	end
	paintSw()
	table.insert(tints,{o=sw,p="BackgroundColor3",m="off",dyn=function() return state[row.id] and accent() or modeColor("off") end})
	sw.Activated:Connect(function() setState(row.id,not state[row.id]); paintSw(); playSound("click") end)
end
local function comboRow(parent,row,compact)
	local r=rowBase(parent)
	local w=compact and 118 or 152
	rowLabel(r,lab(row.label),-(w+16))
	local b=new("TextButton",{AnchorPoint=Vector2.new(1,.5),Position=UDim2.new(1,-6,.5,0),Size=UDim2.fromOffset(w,31),Text="",AutoButtonColor=false},r)
	corner(b,6); tint(b,"BackgroundColor3","input"); tint(stroke(b),"Color","line")
	local v=new("TextLabel",{Size=UDim2.new(1,-26,1,0),Position=UDim2.fromOffset(9,0),BackgroundTransparency=1,TextSize=11.5,Font=Enum.Font.GothamMedium,TextXAlignment=Enum.TextXAlignment.Left,TextTruncate=Enum.TextTruncate.AtEnd},b); tint(v,"TextColor3","label")
	local ch=icon("chevron",b,13,"dim"); ch.AnchorPoint=Vector2.new(1,.5); ch.Position=UDim2.new(1,-8,.5,0)
	local function cur() for _,o in ipairs(row.options) do if o.value==state[row.id] then return lab(o.label) end end return tostring(state[row.id]) end
	v.Text=cur()
	b.Activated:Connect(function()
		playSound("click")
		openPop(b,math.max(w,178),function(p)
			for _,o in ipairs(row.options) do
				local it=new("TextButton",{Size=UDim2.new(1,0,0,31),BackgroundTransparency=1,Text="",AutoButtonColor=false},p); corner(it,6)
				local sel=o.value==state[row.id]
				local il=new("TextLabel",{Size=UDim2.new(1,-26,1,0),Position=UDim2.fromOffset(9,0),BackgroundTransparency=1,Text=lab(o.label),TextSize=11.5,Font=Enum.Font.GothamMedium,TextXAlignment=Enum.TextXAlignment.Left},it)
				tint(il,"TextColor3",sel and "accent2" or "label")
				if sel then local ci=icon("check",it,12,"accent2"); ci.AnchorPoint=Vector2.new(1,.5); ci.Position=UDim2.new(1,-8,.5,0) end
				it.MouseEnter:Connect(function() it.BackgroundColor3=accent(); tw(it,{BackgroundTransparency=.9}) end)
				it.MouseLeave:Connect(function() tw(it,{BackgroundTransparency=1}) end)
				it.Activated:Connect(function() setState(row.id,o.value); v.Text=cur(); closePop(); playSound("click") end)
			end
		end)
	end)
end
function sliderControl(parent,cfg)
	local holder=new("Frame",{Size=UDim2.new(1,0,0,42),BackgroundTransparency=1},parent)
	local top=new("Frame",{Size=UDim2.new(1,0,0,18),BackgroundTransparency=1},holder)
	if cfg.label then
		local l=new("TextLabel",{Size=UDim2.new(1,-70,1,0),Position=UDim2.fromOffset(2,0),BackgroundTransparency=1,Text=cfg.label,TextSize=12.5,Font=Enum.Font.GothamMedium,TextXAlignment=Enum.TextXAlignment.Left,TextTruncate=Enum.TextTruncate.AtEnd},top); tint(l,"TextColor3","label")
	end
	local chip=new("TextLabel",{AnchorPoint=Vector2.new(1,0),Position=UDim2.new(1,-2,0,0),Size=UDim2.fromOffset(64,18),BackgroundTransparency=1,TextSize=11,Font=Enum.Font.GothamBold,TextXAlignment=Enum.TextXAlignment.Right},top); tint(chip,"TextColor3","accent2")
	local track=new("TextButton",{Position=UDim2.fromOffset(2,26),Size=UDim2.new(1,-4,0,6),Text="",AutoButtonColor=false},holder)
	corner(track,3); tint(track,"BackgroundColor3","track")
	local fill=new("Frame",{Size=UDim2.fromScale(0,1),BorderSizePixel=0},track); corner(fill,3); tint(fill,"BackgroundColor3","accent")
	local knob=new("Frame",{AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromScale(0,.5),Size=UDim2.fromOffset(15,15),BackgroundColor3=Color3.new(1,1,1),BorderSizePixel=0,ZIndex=2},track)
	pill(knob); tint(stroke(knob,3),"Color","accent")
	local step=cfg.step or 1
	local function fmt(v) return (step<1 and string.format("%.1f",v) or tostring(math.floor(v+.5)))..(cfg.unit or "") end
	local function paintSlider()
		local val=cfg.get(); local ratio=math.clamp((val-cfg.min)/(cfg.max-cfg.min),0,1)
		fill.Size=UDim2.fromScale(ratio,1); knob.Position=UDim2.fromScale(ratio,.5); chip.Text=fmt(val)
	end
	paintSlider()
	local active=false
	local function fromX(x)
		local ratio=math.clamp((x-track.AbsolutePosition.X)/math.max(1,track.AbsoluteSize.X),0,1)
		local val=math.clamp(math.floor((cfg.min+ratio*(cfg.max-cfg.min))/step+.5)*step,cfg.min,cfg.max)
		cfg.set(val); paintSlider()
	end
	track.InputBegan:Connect(function(i)
		if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then active=true; fromX(i.Position.X) end
	end)
	UserInputService.InputChanged:Connect(function(i)
		if active and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then fromX(i.Position.X) end
	end)
	UserInputService.InputEnded:Connect(function(i)
		if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then active=false end
	end)
	return holder,paintSlider
end
local function sliderRow(parent,row)
	sliderControl(parent,{label=lab(row.label),min=row.min,max=row.max,step=row.step,unit=row.unit,get=function() return state[row.id] end,set=function(v) setState(row.id,v) end})
end
local function textRow(parent,row)
	local r=rowBase(parent); rowLabel(r,lab(row.label),-168)
	local box=new("TextBox",{AnchorPoint=Vector2.new(1,.5),Position=UDim2.new(1,-6,.5,0),Size=UDim2.fromOffset(152,31),Text=state[row.id],TextSize=11.5,Font=Enum.Font.GothamMedium,ClearTextOnFocus=false,PlaceholderText="…"},r)
	corner(box,6); tint(box,"BackgroundColor3","input"); tint(box,"TextColor3","white"); tint(stroke(box),"Color","line")
	box.FocusLost:Connect(function() setState(row.id,box.Text~="" and box.Text or "User"); box.Text=state[row.id] end)
end
local function openColorPicker(anchor)
	openPop(anchor,250,function(p)
		local head=new("TextLabel",{Size=UDim2.new(1,0,0,18),BackgroundTransparency=1,Text=t("colorPicker"),TextSize=10,Font=Enum.Font.GothamBold,TextXAlignment=Enum.TextXAlignment.Left},p); tint(head,"TextColor3","accent2")
		local preview=new("Frame",{Size=UDim2.new(1,0,0,36),BorderSizePixel=0},p); corner(preview,7); tint(stroke(preview),"Color","line")
		local hexl=new("TextLabel",{Size=UDim2.fromScale(1,1),BackgroundTransparency=1,Text=state.accent,TextSize=13,Font=Enum.Font.Code},preview); tint(hexl,"TextColor3","white")
		local function refresh() preview.BackgroundColor3=accent(); hexl.Text=state.accent end
		refresh()
		for _,ch in ipairs({"R","G","B"}) do
			sliderControl(p,{label=ch,min=0,max=255,step=1,unit="",
				get=function() local c=accent(); return math.floor((ch=="R" and c.R or ch=="G" and c.G or c.B)*255+.5) end,
				set=function(v)
					local c=accent()
					setState("accent",colorToHex(Color3.new(ch=="R" and v/255 or c.R,ch=="G" and v/255 or c.G,ch=="B" and v/255 or c.B)))
					refresh()
				end})
		end
		local done=new("TextButton",{Size=UDim2.new(1,0,0,32),Text=t("ready"),TextSize=12,Font=Enum.Font.GothamBold,AutoButtonColor=false},p)
		corner(done,7); tint(done,"BackgroundColor3","accent"); tint(done,"TextColor3","white")
		done.Activated:Connect(function() playSound("click"); closePop() end)
	end)
end
local function swatchRow(parent,row)
	local r=rowBase(parent,rowH()+28); rowLabel(r,lab(row.label),-10)
	local wrap=new("Frame",{Position=UDim2.fromOffset(2,26),Size=UDim2.new(1,-4,0,26),BackgroundTransparency=1},r); list(wrap,Enum.FillDirection.Horizontal,7)
	local marks={}
	local function mark() for hex,b in pairs(marks) do b:FindFirstChildOfClass("UIStroke").Thickness=(hex:lower()==state.accent:lower()) and 2 or 0 end end
	for _,hex in ipairs(PRESETS) do
		local b=new("TextButton",{Size=UDim2.fromOffset(26,26),BackgroundColor3=hexToColor(hex),Text="",AutoButtonColor=false},wrap)
		pill(b); local st=stroke(b,0); st.Color=Color3.new(1,1,1); marks[hex]=b
		b.Activated:Connect(function() setState("accent",hex); mark(); playSound("click") end)
	end
	local well=new("TextButton",{Size=UDim2.fromOffset(26,26),BackgroundTransparency=1,Text="",AutoButtonColor=false},wrap)
	pill(well); local ws=stroke(well,1); ws.Color=pal().muted
	local pi=icon("plus",well,13,"muted"); pi.AnchorPoint=Vector2.new(.5,.5); pi.Position=UDim2.fromScale(.5,.5)
	well.Activated:Connect(function() playSound("click"); openColorPicker(well) end)
	mark()
end
local function infoRow(parent,row)
	local r=rowBase(parent); rowLabel(r,lab(row.label),-150)
	local v=new("TextLabel",{AnchorPoint=Vector2.new(1,.5),Position=UDim2.new(1,-6,.5,0),Size=UDim2.fromOffset(146,20),BackgroundTransparency=1,Text="",TextSize=11.5,Font=Enum.Font.GothamBold,TextXAlignment=Enum.TextXAlignment.Right,TextTruncate=Enum.TextTruncate.AtEnd},r)
	tint(v,"TextColor3","accent2")
	local getter=row.getter or function() return lab(row.value) end
	v.Text=getter()
	if row.live then table.insert(liveInfo,{o=v,f=getter}) end
end
local function buttonRow(parent,row)
	local r=rowBase(parent,38)
	local b=new("TextButton",{Size=UDim2.new(1,0,0,34),Text="",AutoButtonColor=false},r); corner(b,7)
	if row.style=="primary" then tint(b,"BackgroundColor3","accent"); tint(new("UIGradient",{Rotation=20},b),"Color","gradAccent")
	elseif row.style=="danger" then b.BackgroundColor3=mix(SEM.err,pal().card,.82); tint(stroke(b),"Color","line")
	else tint(b,"BackgroundColor3","input"); tint(stroke(b),"Color","line") end
	local mode=row.style=="primary" and "white" or (row.style=="danger" and "err" or "label")
	local bi=icon(row.icon,b,14,mode); bi.Position=UDim2.fromOffset(12,10)
	local bl=new("TextLabel",{Position=UDim2.fromOffset(34,0),Size=UDim2.new(1,-44,1,0),BackgroundTransparency=1,Text=lab(row.label),TextSize=12,Font=Enum.Font.GothamBold,TextXAlignment=Enum.TextXAlignment.Left,TextTruncate=Enum.TextTruncate.AtEnd},b)
	tint(bl,"TextColor3",mode)
	b.Activated:Connect(function() playSound("click"); row.fn(b,bl) end)
end
function buildRow(parent,row,compact)
	local ty=row.type
	if ty=="toggle" then toggleRow(parent,row)
	elseif ty=="combo" then comboRow(parent,row,compact)
	elseif ty=="slider" then sliderRow(parent,row)
	elseif ty=="text" then textRow(parent,row)
	elseif ty=="swatch" then swatchRow(parent,row)
	elseif ty=="info" then infoRow(parent,row)
	elseif ty=="button" then buttonRow(parent,row) end
end

local confirmUntil=0
local function doReset()
	for k,v in pairs(DEFAULTS) do state[k]=v end
	state.name=player.DisplayName; confirmUntil=0
	renderAll(); paint(); applyRadius(); updateShellDecor(); updateToastPos(); updateSoundIcon(); sceneParams(); layout()
	markDirty(); toast("warning",t("resetTitle"),t("resetMsg"))
end
local function actReset(b,l)
	if os.clock()<confirmUntil then doReset() return end
	confirmUntil=os.clock()+2.6
	local oldText=l.Text; l.Text=t("confirmReset")
	task.delay(2.6,function() if l.Parent and l.Text==t("confirmReset") then l.Text=oldText end end)
end
local function actRandom()
	state.accent=PRESETS[math.random(#PRESETS)]
	local th={"midnight","abyss","contrast"}; state.theme=th[math.random(#th)]
	state.radius=math.random(0,16)
	local d={"compact","normal","roomy"}; state.density=d[math.random(#d)]
	state.particleCount=math.random(40,150); state.driftSpeed=math.random(20,160)
	renderAll(); paint(); applyRadius(); sceneParams(); layout(); markDirty()
	toast("info",t("randomTitle"),t("randomMsg"))
end
local function actExport()
	local enc="{}"; pcall(function() enc=HttpService:JSONEncode(state) end)
	openModal(t("exportTitle"),"download",{t("exportHint")},function(m,nextOrder)
		local box=new("TextBox",{Size=UDim2.new(1,0,0,120),Text=enc,TextSize=11,Font=Enum.Font.Code,TextWrapped=true,MultiLine=true,ClearTextOnFocus=false,TextEditable=true,TextXAlignment=Enum.TextXAlignment.Left,TextYAlignment=Enum.TextYAlignment.Top,LayoutOrder=nextOrder()},m)
		corner(box,7); tint(box,"BackgroundColor3","input"); tint(box,"TextColor3","label"); tint(stroke(box),"Color","line"); pad(box,8,8,8,8)
		if remote then
			local sb=new("TextButton",{Size=UDim2.new(1,0,0,34),Text=t("sendServer"),TextSize=12,Font=Enum.Font.GothamBold,AutoButtonColor=false,LayoutOrder=nextOrder()},m)
			corner(sb,7); tint(sb,"BackgroundColor3","input"); tint(sb,"TextColor3","label"); tint(stroke(sb),"Color","line")
			sb.Activated:Connect(function() pcall(function() remote:FireServer(box.Text) end); playSound("click"); toast("info",t("exportTitle"),t("sentServer")) end)
		end
	end)
end
local function actImport()
	openModal(t("importTitle"),"upload",{t("importHint")},function(m,nextOrder)
		local box=new("TextBox",{Size=UDim2.new(1,0,0,120),Text="",PlaceholderText='{"accent":"#0095FF", ...}',TextSize=11,Font=Enum.Font.Code,TextWrapped=true,MultiLine=true,ClearTextOnFocus=false,TextXAlignment=Enum.TextXAlignment.Left,TextYAlignment=Enum.TextYAlignment.Top,LayoutOrder=nextOrder()},m)
		corner(box,7); tint(box,"BackgroundColor3","input"); tint(box,"TextColor3","label"); tint(stroke(box),"Color","line"); pad(box,8,8,8,8)
		local ab=new("TextButton",{Size=UDim2.new(1,0,0,34),Text=t("apply"),TextSize=12,Font=Enum.Font.GothamBold,AutoButtonColor=false,LayoutOrder=nextOrder()},m)
		corner(ab,7); tint(ab,"BackgroundColor3","accent"); tint(ab,"TextColor3","white")
		ab.Activated:Connect(function()
			local ok,data=pcall(function() return HttpService:JSONDecode(box.Text) end)
			local n=0
			if ok and type(data)=="table" then
				local src=type(data.state)=="table" and data.state or data
				for k,v in pairs(DEFAULTS) do if src[k]~=nil and typeof(src[k])==typeof(v) then state[k]=src[k]; n+=1 end end
			end
			if n>0 then
				renderAll(); paint(); applyRadius(); updateShellDecor(); updateToastPos(); updateSoundIcon(); sceneParams(); layout(); markDirty()
				closeModal(); toast("success",t("importOk"),t("importOkMsg"))
			else toast("error",t("importErr"),t("importErrMsg")) end
		end)
	end)
end
local function actClear()
	gui:SetAttribute("Config",nil)
	for _,e in ipairs(liveInfo) do if e.o.Parent then e.o.Text=e.f() end end
	toast("warning",t("clearTitle"),t("clearMsg"))
end
local function actUpdate(b,l)
	toast("info",t("updateTitle"),t("updateMsg"))
	local oldText=l.Text; l.Text="…"
	task.delay(1.3,function() if l.Parent then l.Text=oldText end; toast("success",t("latestTitle"),t("latestMsg")) end)
end
local function actBench(b,l)
	l.Text="2s…"
	SCENE.benchUntil=os.clock()+2
	SCENE.benchCb=function(fps)
		state.benchResult=fps.." fps"
		if l.Parent then l.Text=lab(L("Тест производительности","Run benchmark")) end
		for _,e in ipairs(liveInfo) do if e.o.Parent then e.o.Text=e.f() end end
		toast("success",t("benchTitle"),t("benchMsg")..fps.." fps")
	end
end
local function actDocs() openModal(t("docs"),"book",{t("docsBody1"),t("docsBody2"),t("hotkeysTitle")..": "..t("hotkeysBody")}) end
local function actChangelog() openModal(t("changelog"),"sparkles",{t("changelogBody")}) end
local function actTest(kind) return function() toast(kind,t("testTitle"),t("testMsg")) end end

local function OPT(v,ru,en) return {value=v,label=L(ru,en)} end
local O_STATUS={OPT("online","В сети","Online"),OPT("away","Отошёл","Away"),OPT("dnd","Не беспокоить","Do not disturb"),OPT("invisible","Невидимка","Invisible")}
local O_THEME={OPT("midnight","Полуночная","Midnight"),OPT("abyss","Глубокая","Abyss"),OPT("contrast","Контрастная","Contrast")}
local O_DENSITY={OPT("compact","Компактная","Compact"),OPT("normal","Обычная","Normal"),OPT("roomy","Просторная","Roomy")}
local O_CLOSE={OPT("hide","Скрыть окно","Hide window"),OPT("minimize","Свернуть","Minimize")}
local O_LANG={OPT("ru","Русский","Russian"),OPT("en","English","English")}
local O_QUAL={OPT("low","Низкое","Low"),OPT("medium","Среднее","Medium"),OPT("high","Высокое","High"),OPT("ultra","Ультра","Ultra")}
local O_POS={OPT("br","Справа снизу","Bottom right"),OPT("bl","Слева снизу","Bottom left"),OPT("tr","Справа сверху","Top right"),OPT("tc","Сверху центр","Top center")}
local O_MAX={OPT(1,"1","1"),OPT(3,"3","3"),OPT(5,"5","5")}
local O_CHAN={OPT("stable","Стабильный","Stable"),OPT("beta","Бета","Beta")}
local function R(ty,id,label,extra) local r={type=ty,id=id,label=label}; if extra then for k,v in pairs(extra) do r[k]=v end end; return r end
local function C(ic,title,rows) return {icon=ic,title=title,rows=rows} end
local SCHEMA={
 {id="appearance",group="main",icon="palette",label=L("Внешний вид","Appearance"),
  subs={{id="theme",label=L("Тема","Theme")},{id="scene",label=L("Сцена","Scene")},{id="window",label=L("Окно","Window")}},
  cards={
   theme={C("sparkles",L("Акцент","Accent"),{R("swatch","accent",L("Акцентный цвет","Accent color")),R("toggle","glow",L("Свечение акцента","Accent glow")),R("toggle","borderGlow",L("Подсветка границ","Border glow"))}),
