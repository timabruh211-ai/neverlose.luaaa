	New("UICorner", { CornerRadius = UDim.new(0, 10) }, MainFrame)
	New("UISizeConstraint", { MinSize = Vector2.new(440, 260), MaxSize = Vector2.new(960, 640) }, MainFrame)

	local TopBar = New("Frame", {
		Name = "TopBar",
		Size = UDim2.new(1, 0, 0, 44),
		BackgroundTransparency = 1,
	}, MainFrame)
	MakeDraggable(MainFrame, TopBar)

	local HubIcon = New("ImageLabel", {
		Position = UDim2.new(0, 10, 0.5, -14),
		Size = UDim2.new(0, 28, 0, 28),
		BackgroundColor3 = Color3.fromRGB(18, 22, 36),
		BorderSizePixel = 0,
		Image = hubImage,
	}, TopBar)
	New("UICorner", { CornerRadius = UDim.new(0, 6) }, HubIcon)

	New("TextLabel", {
		Position = UDim2.new(0, 44, 0, 5),
		Size = UDim2.new(0.5, 0, 0, 18),
		BackgroundTransparency = 1,
		Text = hubTitle,
		TextColor3 = Color3.fromRGB(255, 255, 255),
