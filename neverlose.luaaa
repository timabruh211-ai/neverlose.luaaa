local textBinds = {}
local function tr(key) local e = L[key] if e then return e[lang] end return key end
local function bindText(obj, keyOrFn, prop)
	prop = prop or "Text"
	table.insert(textBinds, {o = obj, k = keyOrFn, p = prop})
	obj[prop] = type(keyOrFn) == "function" and keyOrFn() or tr(keyOrFn)
end
local function setLang(l)
	lang = l
	for _, b in ipairs(textBinds) do b.o[b.p] = type(b.k) == "function" and b.k() or tr(b.k) end
end

--== МАСШТАБ ==--
local function updateScale()
	local vp = camera.ViewportSize
	baseScale = math.clamp(math.min(vp.X / 940, vp.Y / 660), 0.5, 1)
	if userScale > 0 then baseScale = math.clamp(baseScale * userScale, 0.4, 1.4) end
	if uiScale then uiScale.Scale = isOpen and baseScale or baseScale * 0.92 end
	if openScale then openScale.Scale = math.max(baseScale, 0.75) end
	if toastScale then toastScale.Scale = math.max(baseScale, 0.7) end
end
local vpConn
local function hookCamera()
	camera = workspace.CurrentCamera
	if vpConn then vpConn:Disconnect() end
	vpConn = connect(camera:GetPropertyChangedSignal("ViewportSize"), updateScale)
	updateScale()
end
connect(workspace:GetPropertyChangedSignal("CurrentCamera"), hookCamera)

--== GUI + очистка старых копий ==--
local function killOld(p, name)
	if p then local o = p:FindFirstChild(name) if o then o:Destroy() end end
end
local okHui, hui = pcall(function() return gethui and gethui() end)
local function cleanAll(p)
	killOld(p, "GlassHubV2") killOld(p, "GlassHubUI")
end
if okHui and hui then cleanAll(hui) end
pcall(function() cleanAll(game:GetService("CoreGui")) end)
cleanAll(Player:FindFirstChildOfClass("PlayerGui"))
pcall(function() local f = workspace:FindFirstChild("GlassTestBots") if f then f:Destroy() end end)
