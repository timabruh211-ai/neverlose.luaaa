local SoundService = game:GetService("SoundService")

local player = Players.LocalPlayer
local pg = player:WaitForChild("PlayerGui")
local cam = workspace.CurrentCamera
local remote = RS:FindFirstChild("NebulaSave")

local function clamp(x,a,b) if x<a then return a elseif x>b then return b else return x end end
local function mix(a,b,t) return a:Lerp(b,t) end
local function lighten(c,f) return mix(c,Color3.new(1,1,1),f) end
local function rgbStr(c)
	return math.floor(c.R*255+0.5)..", "..math.floor(c.G*255+0.5)..", "..math.floor(c.B*255+0.5)
end

local THEMES = {
	midnight={side=Color3.fromRGB(13,16,23),main=Color3.fromRGB(17,20,29),card=Color3.fromRGB(22,26,38),line=Color3.fromRGB(34,40,58),muted=Color3.fromRGB(142,150,170),label=Color3.fromRGB(215,219,231)},
	abyss={side=Color3.fromRGB(9,12,18),main=Color3.fromRGB(12,15,22),card=Color3.fromRGB(16,20,29),line=Color3.fromRGB(27,33,48),muted=Color3.fromRGB(130,138,158),label=Color3.fromRGB(205,210,224)},
	contrast={side=Color3.fromRGB(13,16,23),main=Color3.fromRGB(17,20,29),card=Color3.fromRGB(24,29,43),line=Color3.fromRGB(48,58,85),muted=Color3.fromRGB(169,177,198),label=Color3.fromRGB(232,235,244)},
}
local PRESETS={"#3B82F6","#0095FF","#8B5CF6","#22C55E","#F59E0B","#EF4444"}
local VIOLET=Color3.fromRGB(139,92,246)
local OK=Color3.fromRGB(34,197,94)
local WARN=Color3.fromRGB(245,158,11)
local ERR=Color3.fromRGB(239,68,68)
local INFO=Color3.fromRGB(0,149,255)

local SIZES={
	small={w=740,h=460,letter="М",label="Маленький"},
	medium={w=920,h=580,letter="С",label="Средний"},
	large={w=1080,h=680,letter="Б",label="Большой"},
}
local SIZE_ORDER={"small","medium","large"}

local DEFAULTS={
	accent="#3B82F6",theme="midnight",radius=8,density="normal",compact=false,sizeMode="medium",
	uiScale=100,shadowDepth=70,frosted=true,animations=true,glow=true,borderGlow=true,
	name=player.Name,status="online",showProfile=true,
	drag=true,hotkeys=true,closeAction="hide",rememberPos=true,autoSave=false,sound=true,
	notifEnabled=true,notifPos="br",notifDuration=4,notifMax=3,
	fxEnabled=true,fxAurora=true,fxParticles=true,fxCount=60,fxSpeed=60,fxShimmer=true,fpsCap=60,
	pvAuto=true,pvSpeed=40,pvZoom=7,pvLight=45,pvGhost=0,pvGlow=true,pvGrid=true,pvParticles=22,pvIndex=1,
	efPulse=50,efRings=3,efOrbit=6,efGlow=60,efSpin=45,
	cgTemplate="button",cgName="NebulaButton",cgW=200,cgH=44,cgRadius=8,cgAnim=true,cgGlow=true,
	posX=0,posY=0,
}
local state={}
for k,v in pairs(DEFAULTS) do state[k]=v end

local function pal() return THEMES[state.theme] or THEMES.midnight end
local function hexColor(h)
	h=tostring(h):gsub("#","")
	if #h~=6 then return Color3.fromRGB(59,130,246) end
	local n=tonumber(h,16) or 0
	return Color3.fromRGB(math.floor(n/65536)%256,math.floor(n/256)%256,n%256)
end
local function hexStr(c)
	local function ch(v) return string.format("%02X",clamp(math.floor(v*255+0.5),0,255)) end
	return "#"..ch(c.R)..ch(c.G)..ch(c.B)
end
local function accent() return hexColor(state.accent) end
local function rowH()
	if state.density=="compact" then return 34 elseif state.density=="roomy" then return 50 else return 42 end
end

local function new(cls,props,parent)
	local o=Instance.new(cls)
	for k,v in pairs(props or {}) do o[k]=v end
	o.Parent=parent
	return o
end
local function corner(o,r) return new("UICorner",{CornerRadius=UDim.new(0,r or 8)},o) end
local function pill(o) return new("UICorner",{CornerRadius=UDim.new(1,0)},o) end
local function stroke(o,th) return new("UIStroke",{Thickness=th or 1,ApplyStrokeMode=Enum.ApplyStrokeMode.Border},o) end
local function pad(o,l,r,t,b) return new("UIPadding",{PaddingLeft=UDim.new(0,l or 0),PaddingRight=UDim.new(0,r or 0),PaddingTop=UDim.new(0,t or 0),PaddingBottom=UDim.new(0,b or 0)},o) end
local function vlist(o,gap) return new("UIListLayout",{FillDirection=Enum.FillDirection.Vertical,Padding=UDim.new(0,gap or 6),SortOrder=Enum.SortOrder.LayoutOrder},o) end
local function hlist(o,gap) return new("UIListLayout",{FillDirection=Enum.FillDirection.Horizontal,Padding=UDim.new(0,gap or 6),SortOrder=Enum.SortOrder.LayoutOrder},o) end
local function clearGui(p) for _,c in ipairs(p:GetChildren()) do if c:IsA("GuiObject") then c:Destroy() end end end
local function tw(o,props,time)
	local dur=state.animations and (time or 0.22) or 0.001
	local t=TweenService:Create(o,TweenInfo.new(dur,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),props)
	t:Play()
	return t
end

local tints,radii,shimmers={},{},{}
local function modeColor(m)
	local p,a=pal(),accent()
	if m=="accent" then return a
	elseif m=="accent2" then return lighten(a,0.3)
	elseif m=="soft" then return mix(a,p.card,0.84)
	elseif m=="softSide" then return mix(a,p.side,0.82)
	elseif m=="line" then return p.line
	elseif m=="muted" then return p.muted
	elseif m=="label" then return p.label
	elseif m=="card" then return p.card
	elseif m=="side" then return p.side
	elseif m=="main" then return p.main
	elseif m=="dim" then return mix(p.muted,p.side,0.45)
	elseif m=="input" then return mix(p.card,p.side,0.35)
	elseif m=="track" then return mix(p.line,p.side,0.3)
	elseif m=="off" then return mix(p.line,p.side,0.15)
	elseif m=="ok" then return OK
	elseif m=="warn" then return WARN
	elseif m=="err" then return ERR
	elseif m=="info" then return INFO
	elseif m=="violet" then return VIOLET
	elseif m=="white" then return Color3.new(1,1,1)
	end
	return p.label
end
local function tint(o,prop,m)
	table.insert(tints,{o=o,p=prop,m=m})
	if m=="grad" then o.Color=ColorSequence.new(accent(),VIOLET)
	elseif m=="gradInfo" then o.Color=ColorSequence.new(mix(accent(),INFO,0.4),VIOLET)
	else o[prop]=modeColor(m) end
	return o
end
local function paint()
	local a=accent()
	for i=#tints,1,-1 do
		local e=tints[i]
		if e.o.Parent==nil then table.remove(tints,i)
		elseif e.dyn then e.o[e.p]=e.dyn()
		elseif e.m=="grad" then e.o.Color=ColorSequence.new(a,VIOLET)
		elseif e.m=="gradInfo" then e.o.Color=ColorSequence.new(mix(a,INFO,0.4),VIOLET)
		else e.o[e.p]=modeColor(e.m) end
	end
end
local function regRadius(u) table.insert(radii,u); u.CornerRadius=UDim.new(0,state.radius) end
local function applyRadius()
	for i=#radii,1,-1 do
		local u=radii[i]
		if u.Parent==nil then table.remove(radii,i) else u.CornerRadius=UDim.new(0,state.radius) end
	end
end
local function addShimmer(btn,speed)
	btn.ClipsDescendants=true
	local s=new("Frame",{Size=UDim2.new(0.4,0,1.6,0),Position=UDim2.fromScale(-0.5,-0.3),Rotation=18,BackgroundColor3=Color3.new(1,1,1),BackgroundTransparency=0.86,BorderSizePixel=0,ZIndex=6},btn)
	new("UIGradient",{Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,1),NumberSequenceKeypoint.new(0.5,0),NumberSequenceKeypoint.new(1,1)})},s)
	table.insert(shimmers,{f=s,sp=speed or 0.35,ph=math.random()})
	return s
end

local uiSound=new("Sound",{SoundId="rbxasset://sounds/electronicpingshort.wav",Volume=0.12},SoundService)
local function playSound(kind)
	if not state.sound then return end
	local ok,s=pcall(function() return uiSound:Clone() end)
	if not ok or not s then return end
	s.Volume=(kind=="click") and 0.06 or 0.12
	s.PlaybackSpeed=({success=1.45,info=1.1,warning=0.85,error=0.6,click=1.9})[kind] or 1
	if SoundService.PlayLocalSound then pcall(function() SoundService:PlayLocalSound(s) end) else pcall(function() s:Play() end) end
	delay(1.2,function() if s then s:Destroy() end end)
end

