	-- Live FPS + ping updates
	local fpsBuffer = {}
	local statsConn = RunService.RenderStepped:Connect(function(dt)
		if not NeverloseCS2.Parent then return end
		table.insert(fpsBuffer, dt)
		if #fpsBuffer > 20 then
			table.remove(fpsBuffer, 1)
		end
		local avg = 0
		for _, v in ipairs(fpsBuffer) do
			avg += v
		end
		if avg > 0 then
			FPSText.Text = math.round(#fpsBuffer / avg) .. " FPS"
		end
		pcall(function()
			local pingItem = Stats.Network.ServerStatsItem["Data Ping"]
			if pingItem then
				MSText.Text = math.round(pingItem:GetValue()) .. " MS"
			end
		end)
	end)

