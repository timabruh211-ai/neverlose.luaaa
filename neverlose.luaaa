}
local SEM={ok=Color3.fromRGB(34,197,94),warn=Color3.fromRGB(245,158,11),err=Color3.fromRGB(239,68,68),info=Color3.fromRGB(0,149,255),violet=Color3.fromRGB(139,92,246),white=Color3.new(1,1,1)}
local PRESETS={"#3B82F6","#0095FF","#8B5CF6","#22C55E","#F59E0B","#EF4444"}
local BASE_W,BASE_H,HEADER_H=1060,680,56

local DEFAULTS={
	language="ru",accent="#3B82F6",glow=true,borderGlow=true,theme="midnight",radius=8,density="normal",compact=false,
	aurora=true,grid=true,particles=true,particleCount=90,particleGlow=true,driftSpeed=60,reduceMotion=false,
	uiScale=100,shadowDepth=70,frosted=true,animations=true,name=player.DisplayName,status="online",showProfile=true,
	drag=true,hotkeys=true,closeAction="hide",rememberPos=true,startMin=false,checkUpdates=false,updChannel="stable",updPre=false,autoSave=false,
	quality="high",fpsCap=60,pauseUnfocused=true,
	notifEnabled=true,notifPos="br",notifDuration=4,notifStack=true,notifMax=3,notifHover=true,notifSuccess=true,notifInfo=true,notifWarning=true,notifError=true,
	sound=true,telemetry=false,posX=0,posY=0,benchResult="—",
}
local state={}
for k,v in pairs(DEFAULTS) do state[k]=v end

local function pal() return THEMES[state.theme] or THEMES.midnight end
local function hexToColor(h)
	h=tostring(h):gsub("#","")
	if #h~=6 then return Color3.fromRGB(59,130,246) end
	local n=tonumber(h,16) or 0
	return Color3.fromRGB(math.floor(n/65536)%256,math.floor(n/256)%256,n%256)
end
local function colorToHex(c)
	local function ch(v) return string.format("%02X",math.clamp(math.floor(v*255+.5),0,255)) end
	return "#"..ch(c.R)..ch(c.G)..ch(c.B)
end
local function accent() return hexToColor(state.accent) end
local function mix(a,b,t) return a:Lerp(b,t) end
local function lighten(c,f) return mix(c,Color3.new(1,1,1),f) end
local function rowH() return ({compact=34,normal=42,roomy=50})[state.density] or 42 end
local function utf8len(s) if utf8 and utf8.len then return utf8.len(s) or #s end return #s end
local atan2=math.atan2 or function(y,x) return math.atan(y,x) end

local function new(cls,props,parent)
	local o=Instance.new(cls)
	for k,v in pairs(props or {}) do o[k]=v end
	o.Parent=parent
	return o
end
local function corner(o,r) return new("UICorner",{CornerRadius=UDim.new(0,r or 8)},o) end
local function pill(o) return new("UICorner",{CornerRadius=UDim.new(1,0)},o) end
local function stroke(o,th) return new("UIStroke",{Thickness=th or 1,ApplyStrokeMode=Enum.ApplyStrokeMode.Border},o) end
local function pad(o,l,r,t,b) return new("UIPadding",{PaddingLeft=UDim.new(0,l or 0),PaddingRight=UDim.new(0,r or 0),PaddingTop=UDim.new(0,t or 0),PaddingBottom=UDim.new(0,b or 0)},o) end
local function list(o,dir,gap) return new("UIListLayout",{FillDirection=dir or Enum.FillDirection.Vertical,Padding=UDim.new(0,gap or 6),SortOrder=Enum.SortOrder.LayoutOrder},o) end
local function clearGui(p) for _,c in ipairs(p:GetChildren()) do if c:IsA("GuiObject") then c:Destroy() end end end
local function tw(o,props,time)
	local dur=state.animations and (time or .22) or .001
	local t=TweenService:Create(o,TweenInfo.new(dur,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),props)
	t:Play(); return t
end
local function makeGroup(props,parent)
	local ok,g=pcall(function() return Instance.new("CanvasGroup") end)
	if not ok then g=Instance.new("Frame") end
	for k,v in pairs(props or {}) do if not (k=="GroupTransparency" and not g:IsA("CanvasGroup")) then g[k]=v end end
	g.Parent=parent
	return g
end
local function fadeGroup(g,to,time)
	if g:IsA("CanvasGroup") then tw(g,{GroupTransparency=to},time) else tw(g,{BackgroundTransparency=to},time) end
end

