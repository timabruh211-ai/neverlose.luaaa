	local bar = new("Frame", {Parent = openBtn, Position = UDim2.fromOffset(16, 19 + (i - 1) * 6), Size = UDim2.fromOffset(w, 2), BackgroundColor3 = ACCENT, BorderSizePixel = 0})
	corner(bar, 1) regAccent(bar, "BackgroundColor3")
end
