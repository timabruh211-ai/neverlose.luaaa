	end,
})

VisRight:CreateColorPicker({
	Name = "Chams Color",
	Default = Color3.fromRGB(120, 92, 255),
	Flag = "Vis_ChamsColor",
})

VisRight:CreateInput({
	Name = "Max ESP Distance",
