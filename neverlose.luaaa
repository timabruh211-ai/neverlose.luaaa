local function icon(name,parent,size,mode)
	local h=new("Frame",{Size=UDim2.fromOffset(size,size),BackgroundTransparency=1},parent)
	local s=size/24
	for _,p in ipairs(ICONS[name] or ICONS.info) do
		local k=p[1]
		if k=="l" then
			local x1,y1,x2,y2=p[2]*s,p[3]*s,p[4]*s,p[5]*s
			local th=math.max(1,(p[6] or 2)*s)
			local dx,dy=x2-x1,y2-y1
			local ln=new("Frame",{AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromOffset((x1+x2)/2,(y1+y2)/2),Size=UDim2.fromOffset(math.max(1,math.sqrt(dx*dx+dy*dy)),th),Rotation=math.deg(atan2(dy,dx)),BorderSizePixel=0},h)
			pill(ln); tint(ln,"BackgroundColor3",mode)
		elseif k=="r" then
			local fill=p[7]
			local rc=new("Frame",{Position=UDim2.fromOffset(p[2]*s,p[3]*s),Size=UDim2.fromOffset(p[4]*s,p[5]*s),BorderSizePixel=0,BackgroundTransparency=fill and 0 or 1},h)
			corner(rc,(p[6] or 2)*s)
			if fill then tint(rc,"BackgroundColor3",mode) else tint(stroke(rc,math.max(1,2*s)),"Color",mode) end
		elseif k=="c" then
			local fill=p[5]; local r=p[4]*s
			local cc=new("Frame",{AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromOffset(p[2]*s,p[3]*s),Size=UDim2.fromOffset(r*2,r*2),BorderSizePixel=0,BackgroundTransparency=fill and 0 or 1},h)
			pill(cc)
			if fill then tint(cc,"BackgroundColor3",mode) else tint(stroke(cc,math.max(1,2*s)),"Color",mode) end
		end
	end
	return h
end

local old=playerGui:FindFirstChild("NebulaV3"); if old then old:Destroy() end
local gui=new("ScreenGui",{Name="NebulaV3",ResetOnSpawn=false,IgnoreGuiInset=true,ZIndexBehavior=Enum.ZIndexBehavior.Sibling,DisplayOrder=25},playerGui)

local uiSound=new("Sound",{SoundId="rbxasset://sounds/electronicpingshort.wav",Volume=.14},SoundService)
local function playSound(kind)
	if not state.sound then return end
	local ok,s=pcall(function() return uiSound:Clone() end)
	if not ok or not s then return end
	s.Volume=(kind=="click") and .07 or .14
	s.PlaybackSpeed=({success=1.45,info=1.1,warning=.85,error=.6,click=1.9})[kind] or 1
	if SoundService.PlayLocalSound then pcall(function() SoundService:PlayLocalSound(s) end) else pcall(function() s:Play() end) end
	task.delay(1.2,function() if s then s:Destroy() end end)
end

