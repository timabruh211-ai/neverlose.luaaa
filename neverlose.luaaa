		Position = UDim2.new(0, 6, 0.5, -15),
		Size = UDim2.new(0, 30, 0, 30),
		BackgroundColor3 = Color3.fromRGB(25, 30, 48),
		BorderSizePixel = 0,
		Image = userImage,
	}, Info)
	New("UICorner", { CornerRadius = UDim.new(1, 0) }, UserImageEl)

	New("TextLabel", {
		Position = UDim2.new(0, 42, 0, 5),
